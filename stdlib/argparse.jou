import "stdlib/assert.jou"
import "stdlib/str.jou"
import "stdlib/utf8.jou"


@public
class ArgumentParser:
    argv: byte**            # the only required field when making an ArgumentParser
    flag: byte[100]         # e.g. "-v" or "--verbose"
    pending_value: byte*    # when "=" was used, this is the "bar" part of "--foo=bar" or "-f=bar"

    # Internal stuff, not meant to be accessed outside this file
    argv_index: int         # which argument are we looking at
    combined_flags: byte*   # used to break apart -abc into separate -a -b -c

    @public
    def next(self) -> bool:
        # If the programmer using this thing checks pending_value correctly,
        # there is never a pending value when we get here. But we can't really
        # assert it, because when a programmer inevitably forgets to check
        # pending_value, we would rather ignore the "=yes" of "--verbose=yes"
        # than trip an assertion in production.
        self.pending_value = NULL

        if self.combined_flags == NULL:
            if self.argv[self.argv_index] != NULL:
                self.argv_index++
            arg = self.argv[self.argv_index]
            if arg == NULL:
                # End of arguments
                self.flag[0] = '\0'
                return False

            if arg[0] == '-' and arg[1] == '-' and arg[2] != '\0':
                # Assume it's a --long-option, perhaps --long-option=value
                option_len = strcspn(arg, "=")
                snprintf(self.flag, sizeof(self.flag), "%.*s", option_len as int, arg)
                arg = &arg[option_len]
                assert *arg == '\0' or *arg == '='
                if *arg == '=':
                    self.pending_value = &arg[1]
                return True
            elif arg[0] == '-' and arg[1] != '-' and arg[1] != '\0':
                # Looks like e.g. -v or -p or -p=1234 or -abc
                #
                # For consistency, process it like combined flags even if it's
                # just one short flag.
                self.combined_flags = &arg[1]
            else:
                # Plain old argument
                self.flag[0] = '\0'
                self.pending_value = arg
                return True

        # Step through multiple combined flags like -vvp=1234
        assert self.combined_flags != NULL
        assert self.combined_flags[0] != '\0'

        nbytes: int = 1
        # Allow non-ASCII flags like -ö why not
        while is_utf8_continuation(self.combined_flags[nbytes]):
            nbytes++
        snprintf(self.flag, sizeof(self.flag), "-%.*s", nbytes, self.combined_flags)

        if self.combined_flags[nbytes] == '=':
            # e.g. -p=1234, or -vp=1234 being same as -v -p=1234
            self.pending_value = &self.combined_flags[nbytes + 1]
            self.combined_flags = NULL
        else:
            self.combined_flags = &self.combined_flags[nbytes]
            if self.combined_flags[0] == '\0':
                self.combined_flags = NULL

        return True

    @public
    def take_value(self) -> byte*:
        if self.pending_value != NULL:
            # "-o foo.txt" means same as "-o=foo.txt"
            result = self.pending_value
            self.pending_value = NULL
            return result

        if self.combined_flags != NULL:
            # "-ofoo.txt" means same as "-o=foo.txt"
            result = self.combined_flags
            self.combined_flags = NULL
            return result

        if self.argv[self.argv_index] != NULL and self.argv[self.argv_index + 1] != NULL:
            return self.argv[++self.argv_index]

        return NULL
