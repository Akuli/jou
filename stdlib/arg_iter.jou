import "stdlib/assert.jou"
import "stdlib/random.jou"
import "stdlib/list.jou"
import "stdlib/ascii.jou"
import "stdlib/mem.jou"
import "stdlib/io.jou"
import "stdlib/str.jou"
import "stdlib/intnative.jou"


# This was in stdlib/str.jou, but I removed it because I used it so rarely
declare strncmp(s1: byte*, s2: byte*, n: intnative) -> int


@public
class ArgIter:
    arg_ptr: byte**
    value: byte*     # Entire command-line argument (--foo bar) or a part of one (--foo=bar)
    combined_flags: byte*  # Used to step through combined flags, e.g. "-abc" may mean "-a -b -c"


@public
def next_arg(iter: ArgIter*, spec: byte*) -> int:
    assert iter.arg_ptr != NULL
    assert *iter.arg_ptr != NULL

    assert spec != NULL
    assert spec[0] == '-'
    assert spec[1] != '\0'

    iter.value = NULL

    if (*iter.arg_ptr)[0] != '-' or strcmp(*iter.arg_ptr, "-") == 0 or strcmp(*iter.arg_ptr, "--") == 0:
        # Doesn't look at all like an argument
        return 1

    if iter.combined_flags != NULL:
        # combined_flags should point into some part of the next argument
        assert iter.combined_flags >= *iter.arg_ptr
        assert iter.combined_flags < &(*iter.arg_ptr)[strlen(*iter.arg_ptr)]

    speclen = strlen(spec)
    assert speclen >= 2

    if spec[1] == '-':
        # Looking for long argument like --foo or --foo=...
        if iter.combined_flags != NULL:
            # We are currently stepping through something like -abc
            return 1
        if spec[speclen - 1] == '=':
            # Spec looks like "--foo="
            if starts_with(*iter.arg_ptr, spec):
                # Found: --foo=bar
                iter.value = &(*iter.arg_ptr++)[speclen]
                return 0
            if (
                strncmp(spec, *iter.arg_ptr, speclen - 1) == 0
                and (*iter.arg_ptr)[speclen - 1] == '\0'
                and iter.arg_ptr[1] != NULL
            ):
                # Found: --foo bar
                iter.value = iter.arg_ptr[1]
                iter.arg_ptr = &iter.arg_ptr[2]
                return 0
            return 1
        else:
            if strcmp(*iter.arg_ptr, spec) == 0:
                # Found: --foo
                iter.arg_ptr++
                return 0
            return 1
    else:
        # Looking for short argument like -f
        if (*iter.arg_ptr)[1] == '-':
            # ...but we got a long argument like --foo
            return 1
        # We need to handle combined flags anyway, so to avoid special-casing,
        # let's funnel everything through combined flags.
        if iter.combined_flags == NULL:
            iter.combined_flags = *iter.arg_ptr
            assert iter.combined_flags[0] == '-'
            iter.combined_flags++
        if spec[speclen - 1] == '=':
            # Spec looks like "-f="
            if starts_with(iter.combined_flags, &spec[1]):
                # Found: -f=bar
                iter.value = &iter.combined_flags[speclen - 1]
                iter.arg_ptr++
                iter.combined_flags = NULL
                return 0
            if strncmp(iter.combined_flags, &spec[1], speclen - 2) == 0:
                # Found: -f
                if iter.combined_flags[speclen - 2] == '\0' and iter.arg_ptr[1] != NULL:
                    # Found: -f bar
                    iter.value = iter.arg_ptr[1]
                    iter.arg_ptr = &iter.arg_ptr[2]
                    iter.combined_flags = NULL
                    return 0
                if iter.combined_flags[speclen - 2] != '\0':
                    # Found: -fbar
                    iter.value = &iter.combined_flags[speclen - 2]
                    iter.arg_ptr++
                    iter.combined_flags = NULL
                    return 0
            return 1
        else:
            # Spec looks like "-f"
            if starts_with(iter.combined_flags, &spec[1]):
                # Found: -f
                iter.combined_flags = &iter.combined_flags[speclen - 1]
                if *iter.combined_flags == '\0':
                    # No more combined flags coming up after this one
                    iter.arg_ptr++
                    iter.combined_flags = NULL
                return 0
            return 1


global ENABLE_PRINTS: bool = True


def simple_cli_program(args: byte*) -> None:
    args = strdup(args)
    args_list = split_by_ascii_whitespace(args)
    args_list.append(NULL)

    iter = ArgIter{arg_ptr = args_list.ptr}
    while *iter.arg_ptr != NULL:
        match &iter with next_arg:
            case "--help":
                if ENABLE_PRINTS:
                    printf("Usage: my_program [-v/--verbose] [-o FILE] [--debug-dump FILE] [input files]\n")
                break
            case "-v" | "--verbose":
                if ENABLE_PRINTS:
                    printf("Verbose\n")
            case "-o=":
                assert iter.value != NULL
                if ENABLE_PRINTS:
                    printf("Output file: '%s'\n", iter.value)
            case "-o":
                if ENABLE_PRINTS:
                    printf("Error: -o needs a value (try --help)\n")
                break
            case "--debug-dump=":
                assert iter.value != NULL
                if ENABLE_PRINTS:
                    printf("Debug dump to '%s'\n", iter.value)
            case "--debug-dump":
                printf("Error: --debug-dump needs a value (try --help)\n")
                break
            case _:
                arg = *iter.arg_ptr++
                assert arg != NULL
                if arg[0] == '-':
                    if ENABLE_PRINTS:
                        printf("Error: unknown argument %s (try --help)\n", arg)
                    break
                if ENABLE_PRINTS:
                    printf("Input file: '%s'\n", arg)

    if ENABLE_PRINTS:
        printf("---\n")

    free(args_list.ptr)
    free(args)


def main() -> int:
    # Output: Usage: my_program [-v/--verbose] [-o FILE] [--debug-dump FILE] [input files]
    # Output: ---
    simple_cli_program("--help")

    # Output: Output file: '-outfile'
    # Output: Debug dump to '--special-dump'
    # Output: ---
    simple_cli_program("-o=-outfile --debug-dump=--special-dump")

    # Output: Output file: ''
    # Output: Debug dump to ''
    # Output: ---
    simple_cli_program("-o= --debug-dump=")

    # Output: Error: -o needs a value (try --help)
    # Output: ---
    simple_cli_program("-o")

    # Output: Error: --debug-dump needs a value (try --help)
    # Output: ---
    simple_cli_program("--debug-dump")

    # Output: Error: unknown argument -x (try --help)
    # Output: ---
    simple_cli_program("-x")

    # Output: Error: unknown argument --unknown-flag (try --help)
    # Output: ---
    simple_cli_program("--unknown-flag")

    # Output: Error: unknown argument - (try --help)
    # Output: ---
    simple_cli_program("-")

    # Output: Input file: 'input1.txt'
    # Output: Verbose
    # Output: Output file: 'out.txt'
    # Output: Input file: 'input2.txt'
    # Output: Debug dump to 'log.txt'
    # Output: Input file: 'input3.txt'
    # Output: ---
    simple_cli_program("input1.txt -v -o=out.txt input2.txt --debug-dump=log.txt input3.txt")

    # Output: Input file: 'input.txt'
    # Output: Verbose
    # Output: Output file: 'out.txt'
    # Output: ---
    simple_cli_program("input.txt --verbose -o=out.txt")

    # Throw many random inputs at it
    ENABLE_PRINTS = False
    alphabet = "- verbose"
    alphabet_len = strlen(alphabet)
    string: byte[10]
    n = 100000
    while n --> 0:
        len = rand() % sizeof(string)
        for i = 0; i < len; i++:
            string[i] = alphabet[rand() % alphabet_len]
        string[len] = '\0'
        simple_cli_program(string)

    return 0
