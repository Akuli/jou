import "stdlib/assert.jou"
import "stdlib/errno.jou"
import "stdlib/mem.jou"
import "stdlib/time.jou"
import "stdlib/str.jou"
import "stdlib/io.jou"
import "stdlib/intnative.jou"

import "./state.jou"
import "./allocator.jou"
import "./query_hash_table.jou"


# Public mostly for tests, but also might help with some debugging
@public
global QUERY_ENGINE_DEBUG_PRINTS = False


def reallocate_string(allocator: Allocator*, s: byte**) -> None:
    if *s != NULL:
        result = allocator.alloc(strlen(*s) + 1)
        strcpy(result, *s)
        *s = result

def allocate_query(params: QueryParams*) -> Query*:
    # Allocate the query using its own allocator
    temp = Allocator{}
    q: Query* = temp.alloc(sizeof(*q))
    assert q != NULL
    *q = Query{query_allocator = temp, params = *params}

    reallocate_string(&q.query_allocator, &q.params.context.path)
    reallocate_string(&q.query_allocator, &q.params.context.funcname)
    reallocate_string(&q.query_allocator, &q.params.context.classname)
    reallocate_string(&q.query_allocator, &q.params.name)

    return q


# If a query was used 5 seconds ago and one of its dependencies was used 10
# seconds ago, mark the dependency as being used 5 seconds ago.
def fix_times_recursively(q: Query*) -> None:
    for dep = q.deps; dep < &q.deps[q.ndeps]; dep++:
        if dep.query.last_used_time < q.last_used_time:
            dep.query.last_used_time = q.last_used_time
            fix_times_recursively(dep.query)

# Make sure that nothing outside the query table holds pointers to query
# results when you call this!
@public
def delete_old_queries(state: State*) -> None:
    for i = 0 as intnative; i < state.queries_capacity; i++:
        if state.queries_table[i] != NULL:
            fix_times_recursively(state.queries_table[i])

    threshold_time = time(NULL) - 60
    counter: intnative = 0
    old_total = state.queries_count

    # Delete old queries from hash table and free their memory
    #
    # If there are multiple old queries, this may not delete all of them because
    # of how hash table items move around when they are deleted. It's fine.
    for i = 0 as intnative; i < state.queries_capacity; i++:
        q = state.queries_table[i]
        if q != NULL and q.last_used_time < threshold_time:
            remove_query_from_hash_table_by_index(state, i)
            q.results.allocator.free_everything()
            q.query_allocator.free_everything()  # makes q.whatever invalid
            counter++

    printf("Old query cleanup: %zd/%zd queries deleted\n", counter, old_total)


# TODO(Jou): use this pattern more? it seems pretty nice for building
# dynamic arrays without explicit capacity member.
@inline
def choose_capacity(len: int) -> int:
    if len == 0:
        # TODO: bigger initial size?
        return 1

    # Choose next power of two, e.g. 5 --> 8
    # It's easier to choose 2^n - 1 = 0b1111...111 by smearing the bits around.
    len--
    len |= len >> 1
    len |= len >> 2
    len |= len >> 4
    len |= len >> 8
    len |= len >> 16
    return len+1

# Adds a dependency like "q1 depends on q2"
def add_dependency(q1: Query*, q2: Query*) -> None:
    if choose_capacity(q1.ndeps) != choose_capacity(q1.ndeps + 1):
        old_deps = q1.deps
        q1.deps = q1.results.allocator.alloc(sizeof(q1.deps[0]) * choose_capacity(q1.ndeps + 1))
        memcpy(q1.deps, old_deps, sizeof(q1.deps[0]) * q1.ndeps)

    q1.deps[q1.ndeps++] = QueryAndVersion{query = q2, version = q2.version}


def can_reuse_previous_result(q: Query*) -> bool:
    assert not q.running

    for dep = q.deps; dep < &q.deps[q.ndeps]; dep++:
        # If the dependency is currently running, and hence invoking this
        # query as a part of it, that's not necessarily a cyclic dependency
        # error because the dependency may go away when we rerun this query.
        if dep.query.version != dep.version or dep.query.running:
            return False

    return True


# Return value NULL means a cyclic dependency: we are already running a query
# with the same params as given here.
@public
def run_query(state: State*, params: QueryParams*) -> QueryResults*:
    q: Query* = find_query_from_hash_table(state, params)
    if q == NULL:
        if QUERY_ENGINE_DEBUG_PRINTS:
            printf("%s: new query\n", params.debug_string())
        q = allocate_query(params)
        add_query_to_hash_table(state, q)
        assert q.version == 0
    else:
        # Check for cyclic dependencies and reuse previous result if possible
        if q.running:
            printf("%s: cyclic dependency\n", params.debug_string())
            return NULL  # cyclic dependency detected
        if can_reuse_previous_result(q):
            printf("%s: using previous result\n", params.debug_string())
            # TODO: refactor so that this isn't repeated
            if state.innermost_running_query != NULL:
                add_dependency(state.innermost_running_query, q)
            return &q.results
        printf("%s: re-evaluating query\n", params.debug_string())
        assert q.version >= 1

    assert not q.running
    q.running = True

    old_results = q.results
    new_results = QueryResults{}
    # TODO: free one of old_results or new_results, use the other one

    other_running_query = state.innermost_running_query
    state.innermost_running_query = q

    match q.params.kind:
        case QueryKind.ReadFile:
            do_read_file(&q.params, &new_results)
        case QueryKind.FindPublicDefinition | QueryKind.FindAccessibleDefinition:
            assert False  # TODO

    # TODO: check if results match, in that case keep using the old one
    # if results equal:
    #     if q.version == 0:
    #         nuke it from everywhere
    #     free new result
    #     update dependencies ??? not sure what should happen to these, old or new?
    # else:
    if True:
        old_results.allocator.free_everything()
        q.results = new_results
        q.version++

    assert state.innermost_running_query == q
    state.innermost_running_query = other_running_query
    if other_running_query != NULL:
        add_dependency(other_running_query, q)

    assert q.running
    q.running = False

    return &q.results


global big_buffer: byte[1_000_000]


def concat_buffers_plus1(allocator: Allocator*, buf1: byte*, len1: intnative, buf2: byte*, len2: intnative) -> byte*:
    result: byte* = allocator.alloc(len1 + len2 + 1)  # there's always room for '\0' byte at the end
    memcpy(result, buf1, len1)
    memcpy(&result[len1], buf2, len2)
    return result

def do_read_file(params: QueryParams*, results: QueryResults*) -> None:
    results.read_file.content = ""
    results.read_file.error = ""

    f = fopen(params.context.path, "rb")
    if f == NULL:
        snprintf(results.read_file.error, array_count(results.read_file.error), "%s", strerror(get_errno()))
    else:
        content: byte* = results.allocator.alloc(1)
        content_len: intnative = 0
        buffered: intnative = 0

        while True:
            n = fread(&big_buffer[buffered], 1, sizeof(big_buffer) - buffered, f)
            if n == 0:
                break
            buffered += n
            if buffered == sizeof(big_buffer):
                content = concat_buffers_plus1(&results.allocator, content, content_len, big_buffer, buffered)
                content_len += buffered
                buffered = 0

        if ferror(f) != 0:
            snprintf(results.read_file.error, array_count(results.read_file.error), "%s", strerror(get_errno()))
        fclose(f)

        if buffered > 0:
            content = concat_buffers_plus1(&results.allocator, content, content_len, big_buffer, buffered)
            content_len += buffered
            buffered = 0

        # if contains '\0' bytes, delete them and set the error
        dest = content
        for i = 0 as intnative; i < content_len; i++:
            b = content[i]
            if b == '\0':
                results.read_file.error = "source file contains a zero byte"
            else:
                *dest++ = b
        *dest = '\0'

        results.read_file.content = content

    # FNV-1a hash
    # https://en.wikipedia.org/wiki/Fowler%E2%80%93Noll%E2%80%93Vo_hash_function#FNV-1a_hash
    h: uint64 = 0xcbf2_9ce4_8422_2325
    for s = results.read_file.content; *s != '\0'; s++:
        h ^= *s
        h *= 0x100_0000_01b3
    results.read_file.content_hash = h
