import "stdlib/assert.jou"
import "stdlib/list.jou"
import "stdlib/time.jou"
import "stdlib/str.jou"
import "stdlib/io.jou"
import "stdlib/intnative.jou"
import "stdlib/mem.jou"

import "./state.jou"
import "./allocator.jou"


def sanity_check(params: QueryParams*) -> None:
    n = 0

    # kind needs no checking, hopefully
    n++

    # Every query applies to some file
    assert params.uri != NULL
    n++

    match params.kind:
        case QueryKind.ReadFile:
            assert params.name == NULL
            n++
            assert params.funcname == NULL
            n++
            assert params.classname == NULL
            n++
            #params.lineno  # TODO: query for reading a specific line

        case QueryKind.FindDefinition:
            assert params.name != NULL
            n++
            # All combinations of funcname and classname make sense:
            #
            # funcname and classname    --> looking for local variable in a method
            # funcname only             --> looking for local variable in a function
            # classname only            --> looking for class field definition
            # neither                   --> looking for a global symbol
            n += 2

    assert n == NUMBER_OF_THINGS_IN_QUERY_PARAMS


# FNV-1a hash
# https://en.wikipedia.org/wiki/Fowler%E2%80%93Noll%E2%80%93Vo_hash_function#FNV-1a_hash

const FNV_PRIME: uint64 = 0x100_0000_01b3

def hash_string(h: uint64*, s: byte*) -> None:
    while True:
        *h ^= *s
        *h *= FNV_PRIME
        if *s++ == '\0':  # Include '\0' in the hash, so "a" then "bc" hashes different from "ab" then "c"
            break

def hash_query_params(params: QueryParams*) -> uint64:
    n = 0
    hash: uint64 = 0xcbf2_9ce4_8422_2325

    hash ^= params.kind as int
    hash *= FNV_PRIME
    n++

    assert params.uri != NULL
    hash_string(&hash, params.uri)
    n++

    if params.name != NULL:
        hash_string(&hash, params.name)
    n++

    if params.funcname != NULL:
        hash_string(&hash, params.funcname)
    n++

    if params.classname != NULL:
        hash_string(&hash, params.classname)
    n++

#    # Not strictly FNV-1a because we don't go one byte a time
#    hash ^= params.lineno
#    hash *= FNV_PRIME
#    n++
#
#    hash ^= params.column
#    hash *= FNV_PRIME
#    n++

    assert n == NUMBER_OF_THINGS_IN_QUERY_PARAMS
    return hash


def nully_string_equals(s1: byte*, s2: byte*) -> bool:
    return s1 == s2 or (s1 != NULL and s2 != NULL and strcmp(s1, s2) == 0)

def query_params_equal(p1: QueryParams*, p2: QueryParams*) -> bool:
    assert NUMBER_OF_THINGS_IN_QUERY_PARAMS == 5
    return (
        p1.kind == p2.kind
        and strcmp(p1.uri, p2.uri) == 0
        and nully_string_equals(p1.name, p2.name)
        and nully_string_equals(p1.funcname, p2.funcname)
        and nully_string_equals(p1.classname, p2.classname)
    )


def duplicate_string(allocator: Allocator*, s: byte*) -> byte*:
    if s == NULL:
        return NULL

    result = allocator.alloc(strlen(s) + 1)
    strcpy(result, s)
    return result


def add_query_without_growing(state: State*, q: Query*) -> None:
    pos = q.params_hash % state.queries_capacity
    while state.queries_table[pos] != NULL:
        if state.queries_table[pos].params_hash == q.params_hash:
            # If this assert fails, the query already exists, and you should
            # either use its result or re-run it.
            #
            # If this assert succeeds, we have a hash collision, which should
            # be very rare but can happen.
            assert not query_params_equal(&state.queries_table[pos].params, &q.params)
            #printf("hash collision in query table\n")
        pos++
        pos %= state.queries_capacity
    state.queries_table[pos] = q

# Public only for tests. TODO: delete the tests?
@public
def add_query(state: State*, params: QueryParams*) -> Query*:
    sanity_check(params)

    # Reallocate the query
    # TODO: reallocate q using its query_allocator, including most of its params

    old_capacity = state.queries_capacity

    # Keep the hash table at most 25% full
    if (state.queries_len + 1)*4 > state.queries_capacity:
        if state.queries_capacity == 0:
            state.queries_capacity = 4
        else:
            state.queries_capacity *= 2

        # Allocate a bigger hash table
        old_table = state.queries_table
        state.queries_table = calloc(sizeof(state.queries_table[0]), state.queries_capacity)
        assert state.queries_table != NULL

        # Insert all the old queries to their new places
        for i: intnative = 0; i < old_capacity; i++:
            if old_table[i] != NULL:
                add_query_without_growing(state, old_table[i])

        free(old_table)
        printf("Query hash table grew to %zd slots (%d used)\n", state.queries_capacity, state.queries_len + 1)

    # Allocate the query using its own allocator
    temp = Allocator{}
    q: Query* = temp.alloc(sizeof(*q))
    assert q != NULL
    *q = Query{query_allocator = temp, params = *params}

    # Fields are assigned one by one to make sure we reallocate them with the
    # new allocator where needed.
    q.params.kind = params.kind
    q.params.uri = duplicate_string(&q.query_allocator, params.uri)
    q.params.name = duplicate_string(&q.query_allocator, params.name)
    q.params.funcname = duplicate_string(&q.query_allocator, params.funcname)
    q.params.classname = duplicate_string(&q.query_allocator, params.classname)

    h1 = hash_query_params(&q.params)
    h2 = hash_query_params(params)
    assert h1 == h2
    q.params_hash = h1

    add_query_without_growing(state, q)
    state.queries_len++
    return q


# Public only for tests. TODO: delete the tests?
@public
def find_query(state: State*, params: QueryParams*) -> Query*:
    if state.queries_len == 0:
        return NULL

    h = hash_query_params(params)
    for pos = h % state.queries_capacity; state.queries_table[pos] != NULL; pos = (pos+1) % state.queries_capacity:
        if state.queries_table[pos].params_hash == h and query_params_equal(&state.queries_table[pos].params, params):
            return state.queries_table[pos]
    return NULL


# Make sure that nothing outside the query table holds pointers to query
# results when you call this!
@public
def delete_old_queries(state: State*) -> None:
    # TODO: check that all loops elsewhere use 64-bit indexing on 64-bit systems?
    i: intnative

    # If a query was used 5 seconds ago and one of its dependencies was used 10
    # seconds ago, mark the dependency as being used 5 seconds ago.
    #
    # This looks like it's slow: O(nd), where d is depth of the dependency tree.
    # Please replace with a faster algorithm only if this is actually slow.
    while True:
        did_something = False

        for i = 0; i < state.queries_capacity; i++:
            q = state.queries_table[i]
            if q != NULL:
                for dep = q.deps; dep < &q.deps[q.ndeps]; dep++:
                    if dep.query.last_used_time < q.last_used_time:
                        # Dependency was indirectly used more recently than it thinks it was used.
                        dep.query.last_used_time = q.last_used_time
                        did_something = True

        if not did_something:
            break

    threshold_time = time(NULL) - 60

    # Delete old queries from hash table and free their memory
    old_len = state.queries_len
    for i = 0; i < state.queries_capacity; i++:
        q = state.queries_table[i]
        if q != NULL and q.last_used_time < threshold_time:
            q.result_allocator.free_all()
            q.query_allocator.free_all()  # makes q invalid
            state.queries_table[i] = NULL
            state.queries_len--

    if state.queries_len != old_len:
        # Deleting may have caused gaps in the hash table that would prevent
        # finding entries properly. Re-insert everything into the hash table.
        temp = List[Query*]{}
        for i = 0; i < state.queries_capacity; i++:
            q = state.queries_table[i]
            if q != NULL:
                temp.append(q)
        memset(state.queries_table, 0, sizeof(state.queries_table[0]) * state.queries_capacity)
        for qptr = temp.ptr; qptr < temp.end(); qptr++:
            add_query_without_growing(state, *qptr)
        free(temp.ptr)

        printf(
            "Old query cleanup: %zd/%zd queries deleted\n",
            old_len - state.queries_len,
            old_len,
        )
