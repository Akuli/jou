import "stdlib/assert.jou"
import "stdlib/list.jou"
import "stdlib/time.jou"
import "stdlib/str.jou"
import "stdlib/io.jou"
import "stdlib/intnative.jou"
import "stdlib/mem.jou"

import "./state.jou"
import "./allocator.jou"
import "./query_hash_table.jou"


# Return value NULL means a cyclic dependency: we are already running a query
# with the same params as given here.
@public
def run_query(state: State*, params: QueryParams*) -> QueryResults*:
    q = find_query_from_hash_table(state, params)
    if q == NULL:
        # Create new query
        q = add_query_to_hash_table(state, params)
    else:
        if q.running:
            return NULL  # cyclic dependency error

        needs_rerun = False
        for dep = q.deps; dep < &q.deps[q.ndeps]; dep++:
            # If the dependency is currently running, and hence invoking this
            # query as a part of it, that's not necessarily a cyclic dependency
            # error because the dependency may go away when we rerun this query.
            if dep.query.version != dep.version or dep.query.running:
                needs_rerun = True
                break

        if not needs_rerun:
            return &q.results

    old_results = 

    return NULL
