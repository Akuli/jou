import "stdlib/io.jou"
import "stdlib/list.jou"
import "stdlib/json.jou"

import "../analyzer/analyzer_state.jou"


@public
class LangserverState:
    record_file: FILE*
    replay_file: FILE*

    # Used to accumulate input bytes until they form complete jsonrpc messages
    input_accumulator: List[byte]

    # Output JSON is built and stored here before printing it
    out: JSONBuilder

    analyzer_state: AnalyzerState
