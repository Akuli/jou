# If you shrink this, existing files created with --record will no longer work.
#global input_buf: byte[3]  # slow, but catches some bugs during development
global input_buf: byte[4096]

def get_input(state: LangserverState*) -> byte*:
    if state.replay_file == NULL:
        if not read_from_stdin(input_buf, sizeof(input_buf)):
            return NULL
        return input_buf

    while True:
        op_byte = fgetc(state.replay_file)
        match op_byte:
            case EOF:
                if ferror(state.replay_file) != 0:
                    langserver_fail_with_errno("reading replay file failed", get_errno())
                return NULL

            case 'I':
                # Input chunk that came from stdin on previous run
                i = 0
                while True:
                    c = fgetc(state.replay_file)
                    if c == EOF:
                        langserver_fail("reading input from replay file failed")
                    if i == array_count(input_buf):
                        langserver_fail("input string in replay file is too long")
                    input_buf[i++] = c as byte
                    # Stop after we copy zero byte
                    if c == '\0':
                        break

                # TODO: Populate VFS with file contents as long as there's 'F' or 'S' entry in file
                #       (use ungetc() if no EOF after last file)
                #       declare ungetc(c: int, stream: FILE*) -> int
                #       S = stat result
                #       F = file content (can only appear after corresponding 'S')
                #
                # TODO: hook up something to fill these in, callback func?
                return input_buf

            case _:
                if is_ascii_letter(op_byte as byte) or is_ascii_digit(op_byte as byte):
                    snprintf(big_buffer, sizeof(big_buffer), "replay file contains unknown op byte '%c'", op_byte)
                else:
                    snprintf(big_buffer, sizeof(big_buffer), "replay file contains unknown op byte 0x%02x", op_byte)
                langserver_fail(big_buffer)


def init_record_and_replay(state: LangserverState*) -> None:
    # Primeagen says, always add a version number, sure lets do it i guess
    file_format_header = "joulsp replay v1\n"

    if state.replay_file != NULL:
        header_size = fread(big_buffer, 1, strlen(file_format_header), state.replay_file)
        if header_size != strlen(file_format_header) or memcmp(big_buffer, file_format_header, header_size) != 0:
            langserver_fail("unsupported file format in replay file")

        state.analyzer_state.real_file_system_is_banned = True

    if state.record_file != NULL:
        fputs(file_format_header, state.record_file)


def consume_input(state: LangserverState*) -> None:
    if state.replay_file == NULL:
        # If the input contains multiple jsonrpc messages that we process at
        # once, we process them all with the same file contents, without
        # statting files in between. I want to somewhat avoid extra stats,
        # because they are slow, especially on Windows.
        invalidate_analyzer_files_changed_on_disk(&state.analyzer_state)

    # Make sure it ends with '\0' so we can treat it as a string
    state.input_accumulator.append('\0')
    state.input_accumulator.pop()  # does not deallocate/shrink

    ptr = state.input_accumulator.ptr

    body_start, body_end: byte*
    while True:
        body_slice = parse_jsonrpc_message(ptr)
        if body_slice.len == 0:
            break

        # No need to copy to new place in memory, lol
        old_byte = *body_slice.end()
        *body_slice.end() = '\0'
        handle_jsonrpc_message(state, body_slice.ptr)  # may change contents inside body string
        *body_slice.end() = old_byte

        assert body_slice.end() > ptr
        ptr = body_slice.end()

    if ptr == state.input_accumulator.ptr:
        # No complete messages yet
        return

    # Yes, I know that memmove() is not as efficient as a ring buffer, but it's
    # easily good enough for this.
    nbytes_remaining = (state.input_accumulator.end() as intnative) - (ptr as intnative)
    memmove(state.input_accumulator.ptr, ptr, nbytes_remaining)
    state.input_accumulator.len = nbytes_remaining

    # TODO
    #analyze_result = analyze(...)
    #publish_diagnostics(analyze_result)


@public
def langserver(record_file: FILE*, replay_file: FILE*) -> noreturn:
    state = LangserverState{record_file = record_file, replay_file = replay_file}
    state.analyzer_state.mode = AnalyzerMode.Langserver
    #state.analyzer_state.debug_prints = True
    init_record_and_replay(&state)

    while True:
        input = get_input(&state)
        if input == NULL:
            # For some reason I don't understand, whoever designed langserver
            # protocol didn't think that this would be a good way to stop a
            # langserver. Instead, there are TWO requests that the editor has
            # to send to properly stop a langserver (shutdown and exit).
            langserver_fail("stdin was closed")

        if state.record_file != NULL:
            fputc('I', state.record_file)
            fwrite(input, 1, strlen(input) + 1, state.record_file)  # includes '\0' to indicate where it ends
            fflush(state.record_file)  # make input available when this thing crashes

        state.input_accumulator.extend_from_ptr(input, strlen(input))
        consume_input(&state)
