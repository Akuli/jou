import "stdlib/str.jou"
import "stdlib/assert.jou"
import "stdlib/intnative.jou"
import "stdlib/json.jou"
import "stdlib/process.jou"
import "stdlib/math.jou"
import "stdlib/mem.jou"
import "stdlib/utf8.jou"

import "../vfs.jou"
import "./fail.jou"
import "./lsp_enums.jou"
import "./state.jou"
import "./uri.jou"


# TODO(Jou): this belongs to stdlib/json.jou
@public
def json_to_int(json: byte*, fallback: int) -> int:
    # Round-trip through double is fine, because any int fits into a double as is
    d = json_to_double(json)
    if isnan(d):
        return fallback
    return d as int


def lsp_position_to_byte_offset(
    file_content: byte*,
    file_size: intnative,
    json: byte*,
) -> intnative:
    assert file_content != NULL
    assert file_size >= 0

    # There's something dumb about both numbers.
    #
    # Line numbers start at zero. Nobody does that. The convention is that they
    # start from 1. My editor literally shows line numbers 1 2 3 ... on the
    # left side of this code right now, as do most other editors.
    #
    # Column number is in UTF-16, not bytes or Unicode characters, because
    # that's what JavaScript happens to use. There is an option that would
    # change the offsets to UTF-8 or Unicode characters, but vscode doesn't
    # support it, so it's useless.
    lineno_0based = json_to_int(json_get(json, "line"), -1)
    column_utf16 = json_to_int(json_get(json, "character"), -1)
    if lineno_0based < 0 or column_utf16 < 0:
        return -1

    result: intnative = 0

    # Go to start of line
    newline_count = 0
    while result < file_size and newline_count < lineno_0based:
        if file_content[result++] == '\n':
            newline_count++

    # Go to correct place within the line
    utf16_unit_count = 0
    while result < file_size and utf16_unit_count < column_utf16:
        # utf8_decode_char() stops at zero byte, but this shouldn't
        if file_content[result] == '\0':
            result++
            utf16_unit_count++
        else:
            p = &file_content[result]
            codepoint = utf8_decode_char(&p)
            n = (p as intnative) - (&file_content[result] as intnative)
            assert 0 <= n and n <= 4

            if n == 0:
                # invalid UTF-8 or zero byte, just do something without crashing i guess
                assert codepoint == 0 or codepoint == -1
                n = 1

            if codepoint <= 0xffff:
                # fits within one UTF-16 unit
                utf16_unit_count++
            else:
                utf16_unit_count += 2

            result += n

    if newline_count == lineno_0based and utf16_unit_count == column_utf16:
        return result
    return -1


# TODO(Jou): allow accessing string inside JSON without a stupid heap allocation
def json_to_fixed_size_string(json: byte*, out: byte*, out_size: intnative) -> bool:
    assert out_size > 0
    out[0] = '\0'

    s = json_to_string(json)
    if s == NULL or strlen(s) >= out_size:
        return False
    strcpy(out, s)
    free(s)
    return True


def id_to_json(jb: JSONBuilder*, id: RequestID) -> None:
    if id.is_string:
        jb.string(id.string)
    else:
        jb.number(id.number)


def begin_result(jb: JSONBuilder*, id: RequestID) -> None:
    id_to_json(jb.key("id"), id)
    jb.key("result")


def handle_initialize(state: LangserverState*, id: RequestID, params_json: byte*) -> None:
    client_caps = json_get(params_json, "capabilities")
    if client_caps == NULL:
        langserver_fail("received initialize without client capabilities")
    # TODO: use client capabilities for something?

    begin_result(&state.out, id)
    state.out.begin_object()

    state.out.key("capabilities").begin_object()

    # It is tempting to use utf-8, but vscode/vscodium only supports UTF-16.
    state.out.key("positionEncoding").string("utf-16")

    state.out.key("textDocumentSync").begin_object()
    state.out.key("openClose").boolean(True)
    # There is a feature that lets you get the whole text content every time it
    # changes. We don't use it so that --record/--replay files don't become
    # huge you edit a big file. Performance would probably be fine either way.
    state.out.key("change").number(TextDocumentSyncKind.Incremental as int)
    state.out.end_object()

    state.out.end_object()  # capabilities

    state.out.end_object()  # result


def handle_shutdown(state: LangserverState*, id: RequestID) -> None:
    begin_result(&state.out, id)
    state.out.null()

def handle_exit() -> None:
    # Spec says that exit status should be 1 if shutdown wasn't used, but we
    # don't track that because I didn't feel like doing it
    exit(0)


# vscodium likes to send a bunch of $/setTrace requests. We don't use the trace
# feature, but let's silence the warnings
def handle_S_setTrace() -> None:
    pass


def handle_textDocument_didOpen(state: LangserverState*, params_json: byte*) -> None:
    if not json_to_fixed_size_string(json_get(json_get(params_json, "textDocument"), "uri"), big_buffer, sizeof(big_buffer)):
        langserver_fail("could not read file URI from textDocument/didChange params")
    uri_to_path(big_buffer)

    # Track all file types, anything can go into embed_binary_file() or embed_text_file()
    # TODO: is there a way to ask later what file content is currently?
    #if not ends_with(big_buffer, ".jou"):
    #    continue

    file = vfs_get_or_create(&state.vfs, big_buffer)

    # TODO(Jou): what if file contains '\0' byte? Ideally there would be a
    #            variant of json_to_string() that handles them properly.
    file_content = json_to_string(json_get(json_get(params_json, "textDocument"), "text"))
    vfs_write(file, file_content, strlen(file_content))
    free(file_content)


def handle_textDocument_didChange(state: LangserverState*, params_json: byte*) -> None:
    if not json_to_fixed_size_string(json_get(json_get(params_json, "textDocument"), "uri"), big_buffer, sizeof(big_buffer)):
        langserver_fail("could not read file URI from textDocument/didChange params")
    uri_to_path(big_buffer)

    file = vfs_get_if_exists(&state.vfs, big_buffer)
    if file == NULL:
        langserver_warning("received textDocument/didChange for a previously unknown file")
        return
    if file.content == NULL:
        langserver_warning("received textDocument/didChange for a file with unknown content")
        return

    for j = json_array_first(json_get(params_json, "contentChanges")); j != NULL; j = json_array_next(j):
        start = lsp_position_to_byte_offset(file.content, file.size, json_get(json_get(j, "range"), "start"))
        end = lsp_position_to_byte_offset(file.content, file.size, json_get(json_get(j, "range"), "end"))
        if start == -1 or end == -1:
            langserver_fail("failed to get range from textDocument/didChange event")

        # TODO(Jou): what if file contains '\0' byte? Ideally there would be a
        #            variant of json_to_string() that handles them properly.
        text = json_to_string(json_get(j, "text"))
        if text == NULL:
            langserver_fail("failed to get text from textDocument/didChange event")

        vfs_write_change(file, start, end - start, text, strlen(text))
        free(text)


def handle_textDocument_didClose(state: LangserverState*, params_json: byte*) -> None:
    if not json_to_fixed_size_string(json_get(json_get(params_json, "textDocument"), "uri"), big_buffer, sizeof(big_buffer)):
        langserver_fail("could not read file URI from textDocument/didClose params")
    uri_to_path(big_buffer)

    file = vfs_get_if_exists(&state.vfs, big_buffer)
    if file == NULL:
        langserver_fail("received textDocument/didClose for a previously unknown file")
    vfs_expire(file)


def get_id(body_json: byte*) -> RequestID:
    id_json = json_get(body_json, "id")
    if id_json == NULL:
        snprintf(big_buffer, sizeof(big_buffer), "JSON does not have an ID, but it is needed: %s", body_json)
        langserver_fail(big_buffer)

    number = json_to_double(id_json)
    if not isnan(number):
        return RequestID{number = number}

    string_id = RequestID{is_string = True}
    if json_to_fixed_size_string(id_json, string_id.string, array_count(string_id.string)):
        return string_id

    snprintf(big_buffer, sizeof(big_buffer), "could not parse ID in JSON: %s", body_json)
    langserver_fail(big_buffer)


# TODO(Jou): match json_get(body_json, "method") with json_equals_string:
#            Problem is that match statement needs int return value
def json_equals_string_cmp(json: byte*, string: byte*) -> int:
    if json_equals_string(json, string):
        return 0
    else:
        return 1


@public
def handle_request(state: LangserverState*, body_json: byte*) -> None:
    match json_get(body_json, "method") with json_equals_string_cmp:
        case "initialize":
            handle_initialize(state, get_id(body_json), json_get(body_json, "params"))
        case "initialized":
            pass
        case "shutdown":
            handle_shutdown(state, get_id(body_json))

        case "exit":
            handle_exit()

        case "textDocument/didOpen":
            handle_textDocument_didOpen(state, json_get(body_json, "params"))

        case "textDocument/didChange":
            handle_textDocument_didChange(state, json_get(body_json, "params"))

        case "textDocument/didClose":
            handle_textDocument_didClose(state, json_get(body_json, "params"))

        case "$/setTrace":
            handle_S_setTrace()

        case _:
            snprintf(big_buffer, sizeof(big_buffer), "received unknown request: %s", body_json)
            langserver_warning(big_buffer)

            if json_get(body_json, "id") != NULL:
                id_to_json(state.out.key("id"), get_id(body_json))
            state.out.key("error")
            state.out.begin_object()
            state.out.key("code").number(-32601)
            state.out.key("message").string("Method not found")
            state.out.end_object()


@public
def handle_success_response(body_json: byte*) -> None:
    # TODO: do something with these? or just ignore them entirely?
    snprintf(big_buffer, sizeof(big_buffer), "got unexpected success response: %s", body_json)
    langserver_warning(big_buffer)


@public
def handle_error_response(body_json: byte*) -> None:
    snprintf(big_buffer, sizeof(big_buffer), "received an error response: %s", body_json)
    langserver_warning(big_buffer)
