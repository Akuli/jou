import "stdlib/ascii.jou"
import "stdlib/str.jou"

import "../allocator.jou"
import "./fail.jou"


def starts_with_ignore_case(s: byte*, prefix: byte*) -> bool:
    for i = 0; prefix[i] != '\0'; i++:
        if not (
            s[i] == prefix[i]
            or (is_ascii_letter(prefix[i]) and s[i] == prefix[i] ^ 32)
        ):
            return False
    return True


# Returns slice describing where the body is, or empty slice if incomplete message
@public
def parse_jsonrpc_message(s: byte*) -> Slice[byte]:
    content_length = -1

    while True:
        if starts_with_ignore_case(s, "Content-Length: "):
            content_length = atoi(&s[16])

        end_of_header = strchr(s, '\n')
        if end_of_header == NULL:
            return Slice[byte]{}
        end_of_header++

        # Langserver spec guarantees it's \r\n, not just \n, but we support
        # both in case I want to try something by pasting text to terminal.
        if end_of_header == &s[1] or (*s == '\r' and end_of_header == &s[2]):
            s = end_of_header
            break

        # Parse the next header
        s = end_of_header

    if content_length <= 0:
        langserver_fail("failed to parse Content-Length header in input")

    # Check if we have the entire body
    for i = 0; i < content_length; i++:
        if s[i] == '\0':
            return Slice[byte]{}

    return Slice[byte]{ptr = s, len = content_length}
