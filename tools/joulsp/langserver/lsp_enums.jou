# Enums in langserver protocol are just integers. For example, 2 might mean
# TextDocumentSyncKind.Incremental or TextDocumentSaveReason.AfterDelay or a
# number of other things.

@public
enum TextDocumentSyncKind:
    None_  # None is a keyword in Jou
    Full
    Incremental

@public
enum DiagnosticSeverity:
    dummy  # enums start from 0 in Jou, but this should start from 1
    Error
    Warning
    Information
    Hint
