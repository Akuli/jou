import "stdlib/errno.jou"
import "stdlib/process.jou"
import "stdlib/io.jou"


# This shouldn't be used when the langserver would likely continue to work
# despite the problem. A dead langserver is a worse user experience than a
# slightly confused langserver.
@public
def langserver_fail(message: byte*) -> noreturn:
    fprintf(get_stderr(), "jou langserver error: %s\n", message)
    exit(1)

@public
def langserver_fail_with_errno(message: byte*, errno_value: int) -> noreturn:
    fprintf(get_stderr(), "jou langserver error: %s (%s)\n", message, strerror(errno_value))
    exit(1)

if WINDOWS:
    @public
    def langserver_fail_with_windows_error(message: byte*, windows_error: uint32) -> noreturn:
        fprintf(get_stderr(), "jou langserver error: %s (Windows error %u)\n", message, windows_error)
        exit(1)


# TODO: should this send some message to the editor too, not just print to stderr?
@public
def langserver_warning(message: byte*) -> None:
    fprintf(get_stderr(), "jou langserver warning: %s\n", message)
