import "stdlib/assert.jou"
import "stdlib/str.jou"
import "stdlib/io.jou"
import "stdlib/intnative.jou"
import "stdlib/mem.jou"

import "./state.jou"


# Public mostly for tests, but also might help with some debugging
@public
global QUERY_HASH_TABLE_DEBUG_PRINTS = False


# FNV-1a hash
# https://en.wikipedia.org/wiki/Fowler%E2%80%93Noll%E2%80%93Vo_hash_function#FNV-1a_hash

const FNV_PRIME: uint64 = 0x100_0000_01b3

def hash_string(h: uint64*, s: byte*) -> None:
    while True:
        *h ^= *s
        *h *= FNV_PRIME
        if *s++ == '\0':  # Include '\0' in the hash, so "a" then "bc" hashes different from "ab" then "c"
            break

def hash_query_params(params: QueryParams*) -> uint64:
    n = 0
    hash: uint64 = 0xcbf2_9ce4_8422_2325

    hash ^= params.kind as int
    hash *= FNV_PRIME
    n++

    assert params.context.uri != NULL
    hash_string(&hash, params.context.uri)
    if params.context.funcname != NULL:
        hash_string(&hash, params.context.funcname)
    if params.context.classname != NULL:
        hash_string(&hash, params.context.classname)
    n++

    if params.name != NULL:
        hash_string(&hash, params.name)
    n++

#    # Not strictly FNV-1a because we don't go one byte a time
#    hash ^= params.lineno
#    hash *= FNV_PRIME
#    n++
#
#    hash ^= params.column
#    hash *= FNV_PRIME
#    n++

    assert n == NUMBER_OF_THINGS_IN_QUERY_PARAMS
    return hash


def nully_string_equals(s1: byte*, s2: byte*) -> bool:
    return s1 == s2 or (s1 != NULL and s2 != NULL and strcmp(s1, s2) == 0)

def symbol_contexts_equal(ctx1: SymbolContext*, ctx2: SymbolContext*) -> bool:
    assert ctx1.uri != NULL
    assert ctx2.uri != NULL

    return (
        strcmp(ctx1.uri, ctx2.uri) == 0
        and nully_string_equals(ctx1.funcname, ctx2.funcname)
        and nully_string_equals(ctx1.classname, ctx2.classname)
    )

def query_params_equal(p1: QueryParams*, p2: QueryParams*) -> bool:
    assert NUMBER_OF_THINGS_IN_QUERY_PARAMS == 3
    return (
        p1.kind == p2.kind
        and symbol_contexts_equal(&p1.context, &p2.context)
        and nully_string_equals(p1.name, p2.name)
    )


def add_without_growing(state: State*, q: Query*) -> None:
    N = state.queries_capacity
    pos = q.params_hash % N
    while state.queries_table[pos] != NULL:
        pos = (pos+1) % N
    state.queries_table[pos] = q

@public
def add_query_to_hash_table(state: State*, q: Query*) -> None:
    # Keep the hash table at most 50% full
    if 2*(state.queries_count + 1) > state.queries_capacity:
        old_capacity = state.queries_capacity
        if state.queries_capacity == 0:
            state.queries_capacity = 4
        else:
            state.queries_capacity *= 2

        if QUERY_HASH_TABLE_DEBUG_PRINTS:
            printf(
                "Growing query hash table to %zd slots (%zd used)\n",
                state.queries_capacity,
                state.queries_count + 1,
            )

        # Allocate a bigger hash table
        old_table = state.queries_table
        state.queries_table = calloc(sizeof(state.queries_table[0]), state.queries_capacity)
        assert state.queries_table != NULL

        # Insert all the old queries to their new places
        for i = 0 as intnative; i < old_capacity; i++:
            if old_table[i] != NULL:
                add_without_growing(state, old_table[i])

        free(old_table)

    q.params_hash = hash_query_params(&q.params)
    add_without_growing(state, q)
    state.queries_count++


@public
def find_query_from_hash_table(state: State*, params: QueryParams*) -> Query*:
    if state.queries_count == 0:
        return NULL

    h = hash_query_params(params)
    N = state.queries_capacity
    for i = h % N; state.queries_table[i] != NULL; i = (i+1) % N:
        if (
            state.queries_table[i].params_hash == h
            and query_params_equal(&state.queries_table[i].params, params)
        ):
            return state.queries_table[i]

    return NULL


# A hole in the hash table means an empty slot (that is, NULL) that prevents an
# element from being found.
#
# This function fixes a hole by moving another element to where the hole is,
# but it may introduce another hole to where the element was.
#
# Return values:
#   -1      hole fixed, no new hole created
#   other   index where a new hole may be, needs to be fixed by calling again
def fix_hole(state: State*, hole: intnative) -> intnative:
    N = state.queries_capacity

    assert 0 <= hole and hole < N
    assert state.queries_table[hole] == NULL

    # Look at consecutive elements after the hole. Try to move them to where
    # the hole is.
    for i = (hole+1) % N; state.queries_table[i] != NULL; i = (i+1) % N:
        ideal = state.queries_table[i].params_hash % N

        # These rely on how '%' handles negative numbers in Python and Jou.
        # For example, this code wouldn't work as is in C.
        how_far_it_would_be = (hole - ideal) % N
        how_far_it_is_now = (i - ideal) % N

        if how_far_it_would_be < how_far_it_is_now:
            # The element is happier in the hole we're trying to fill than
            # in its current place. Let's move it into the hole.
            state.queries_table[hole] = state.queries_table[i]
            state.queries_table[i] = NULL

            # We may have created a new hole to where the item as.
            # That needs to be fixed by calling this function again.
            return i

    # The hole doesn't matter because the ideal place of every element
    # immediately after the hole is somewhere after the hole.
    return -1


@public
def remove_query_from_hash_table_by_index(state: State*, i: intnative) -> None:
    assert 0 <= i and i < state.queries_capacity
    assert state.queries_table[i] != NULL

    state.queries_table[i] = NULL
    state.queries_count--

    while i != -1:
        i = fix_hole(state, i)


@public
def remove_query_from_hash_table(state: State*, q: Query*) -> None:
    assert state.queries_count > 0
    assert q != NULL

    # Find the query
    N = state.queries_capacity
    i = q.params_hash % N
    while state.queries_table[i] != q and state.queries_table[i] != NULL:
        i++

    # If this assert fails, the query is not in the hash table
    assert state.queries_table[i] == q
    remove_query_from_hash_table_by_index(state, i)
