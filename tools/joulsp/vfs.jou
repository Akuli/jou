# VFS = Virtual File System. Fancy name for file contents stored in memory.

import "stdlib/assert.jou"
import "stdlib/io.jou"
import "stdlib/limits.jou"
import "stdlib/time.jou"
import "stdlib/mem.jou"
import "stdlib/str.jou"
import "stdlib/intnative.jou"
import "stdlib/list.jou"

import "./hash.jou"


# TODO(Jou): This should probably be a `const`, but that triggers unreachable
#            code warnings.
global DEBUG_PRINTS: bool = True


@public
class VfsFile:
    path: byte*  # allocated together with VfsFile, no need for a separate free()

    # monotonic_ns() value when to check this file again, to avoid disk IO
    # Anything before current time means that file needs to be checked again.
    # INT64_MAX (opened) and 0 (closed) are used for files that do not come from disk.
    expires_ns: int64

    # You can't have both error and content, but if you have neither, it means
    # that reading the file hasn't been attempted yet.
    error: byte[200]  # empty if no error
    content: byte*  # NULL if not known, '\0' terminated, may contain '\0' bytes (check size), needs free()

    # -1 means unknown
    #
    # Can be known even if file content is not in memory. That is useful for
    # embed_binary_file(), because we only need to know the array size.
    size: int64
    mtime: int64

    content_hash: uint64[2]  # meaningful only when content != NULL

    @public
    def print(self) -> None:
        fprintf(get_stderr(), "VfsFile \"%s\"\n", self.path)
        fprintf(get_stderr(), "  expires: %lld\n", self.expires_ns)
        fprintf(get_stderr(), "  error = %s\n", self.error)
        if self.content == NULL:
            fprintf(get_stderr(), "  content = NULL\n")
        else:
            if strlen(self.content) <= 200:
                fprintf(get_stderr(), "  content = %zd bytes:\n------begin content------\n%s\n------end content------\n", strlen(self.content), self.content)
            else:
                fprintf(get_stderr(), "  content = %zd bytes\n", strlen(self.content))
            fprintf(get_stderr(), "  content_hash = %016llx%016llx\n", self.content_hash[0], self.content_hash[1])
        fprintf(get_stderr(), "  size = %zd\n", self.size)
        fprintf(get_stderr(), "  mtime = %zd\n", self.mtime)


@public
class VFS:
    # I may want to add a hash table here later, but not needed yet
    # If you add a hash table, be careful with path normalization! (e.g. Windows case insensitivity)
    files: List[VfsFile*]

    # If True, uses `assert` to ensure that nothing is read from the actual file
    # system. Used when langserver is reproducing what it did before (--replay)
    real_file_system_is_banned: bool

    # After reading a file from the real file system, how long should the file
    # contents be considered valid until it needs to be read again?
    #
    # Nanoseconds. 0 means files are valid forever (good for compiler).
    real_file_system_expire_delay_ns: int64
    

# Used to avoid frequent realloc()'s
def next_power_of_2(n: intnative) -> intnative:
    n--
    n |= n >> 1
    n |= n >> 2
    n |= n >> 4
    n |= n >> 8
    n |= n >> 16
    n |= n >> 32  # This is fine on 32-bit, because in Jou, shifting beyond width produces 0
    return n + 1


@inline
def normalize_path_byte(b: byte) -> byte:
    if WINDOWS:
        # Non-ASCII is also case-insensitive on windows, but this should be
        # good enough for anything practical
        if 'A' <= b and b <= 'Z':
            return 'a' + (b - 'A')
        if b == '\\':
            return '/'
    return b

def path_strcmp(a: byte*, b: byte*) -> int:
    while *a != '\0' or *b != '\0':
        a_byte = normalize_path_byte(*a++)
        b_byte = normalize_path_byte(*b++)
        if a_byte != b_byte:
            return (a_byte as int) - (b_byte as int)
    return 0


# Returned pointer stays stable for a pretty long time
@public
def vfs_get_if_exists(vfs: VFS*, path: byte*) -> VfsFile*:
    # A hash table should be added if this becomes a bottleneck
    for p = vfs.files.ptr; p < vfs.files.end(); p++:
        if path_strcmp((*p).path, path) == 0:
            return *p
    return NULL


# Returned pointer stays stable for a pretty long time
@public
def vfs_get_or_create(vfs: VFS*, path: byte*) -> VfsFile*:
    existing = vfs_get_if_exists(vfs, path)
    if existing != NULL:
        return existing

    file: VfsFile* = malloc(sizeof(*file) + strlen(path) + 1)
    assert file != NULL
    *file = VfsFile{path = &file[1] as byte*, size = -1, mtime = -1}
    strcpy(file.path, path)
    vfs.files.append(file)
    if DEBUG_PRINTS:
        fprintf(get_stderr(), "vfs: created file \"%s\", content is unknown for now\n", path)
    return file


def read_file_from_the_real_file_system(vfs: VFS*, file: VfsFile*) -> None:
    assert not vfs.real_file_system_is_banned  # real file input should never happen during langserver --replay
    assert False  # TODO


# Returns error message or file contents
@public
def vfs_read(vfs: VFS*, file: VfsFile*, is_error: bool*) -> byte*:
    if file.expires_ns != INT64_MAX:  # Pseudo-optimization: don't call monotonic_ns() if not needed
        now = monotonic_ns()
        if file.expires_ns < now:
            # File has expired
            assert vfs.real_file_system_expire_delay_ns >= 0
            if vfs.real_file_system_expire_delay_ns == 0:
                # No expiration
                file.expires_ns = INT64_MAX
            else:
                file.expires_ns = now + vfs.real_file_system_expire_delay_ns
            read_file_from_the_real_file_system(vfs, file)

    assert False  # TODO


# Does not actually write to disk, just pretends that file content is as specified
@public
def vfs_write(file: VfsFile*, content: byte*, content_size: intnative) -> None:
    assert content_size >= 0

    if file.content == NULL or next_power_of_2(file.size + 1) != next_power_of_2(content_size + 1):
        file.content = realloc(file.content, next_power_of_2(content_size + 1))
        assert file.content != NULL
    memcpy(file.content, content, content_size)
    file.content[content_size] = '\0'

    file.size = content_size
    file.error[0] = '\0'
    file.expires_ns = INT64_MAX
    file.mtime = -1
    file.content_hash = hash(file.content, file.size)

    if DEBUG_PRINTS:
        fprintf(get_stderr(), "vfs: \"wrote\" file content of \"%s\" (now %lld bytes)\n", file.path, file.size)


@public
def vfs_write_change(file: VfsFile*, offset: intnative, old_len: intnative, new_data: byte*, new_len: intnative) -> None:
    assert old_len >= 0
    assert new_len >= 0
    assert offset >= 0

    # File should have been read already
    assert file.error[0] == '\0'
    assert file.content != NULL
    assert file.size >= offset + old_len

    # File should be manually tracked, as in vfs_write(), not read from disk
    assert file.expires_ns == INT64_MAX
    assert file.mtime == -1

    new_size = file.size - old_len + new_len
    if next_power_of_2(new_size + 1) > next_power_of_2(file.size + 1):
        # Grow it first, otherwise result won't fit
        file.content = realloc(file.content, next_power_of_2(new_size + 1))
        assert file.content != NULL

    # Move everything after the changing part
    memmove(
        &file.content[offset + new_len],
        &file.content[offset + old_len],
        file.size - (offset + old_len) + 1,  # +1 to preserve '\0'
    )

    # Put new data to its place
    memcpy(&file.content[offset], new_data, new_len)

    file.size = new_size
    file.content_hash = hash(file.content, file.size)

    if DEBUG_PRINTS:
        fprintf(get_stderr(), "vfs: \"wrote\" a change to file content of \"%s\" (now %lld bytes)\n", file.path, file.size)
        if file.size < 100:
            fprintf(get_stderr(), "--- begin vfs file content ---\n%s\n--- end vfs file content---\n", file.content)


# Marks a file so that content will be read from disk next time it's needed
@public
def vfs_expire(file: VfsFile*) -> None:
    file.expires_ns = 0

    if DEBUG_PRINTS:
        fprintf(get_stderr(), "vfs: marked \"%s\" as expired, currently stored file content won't be used\n", file.path)
