# This file takes in chunks of data from stdin, collects them until they form
# complete jsonrpc messages, and splits to individual messages.

import "stdlib/mem.jou"
import "stdlib/math.jou"
import "stdlib/assert.jou"
import "stdlib/json.jou"
import "stdlib/ascii.jou"
import "stdlib/intnative.jou"
import "stdlib/list.jou"
import "stdlib/str.jou"

import "./state.jou"
import "./stdin_and_stdout.jou"
import "./fail.jou"
import "./handlers.jou"


def starts_with_ignore_case(s: byte*, prefix: byte*) -> bool:
    for i = 0; prefix[i] != '\0'; i++:
        if not (
            s[i] == prefix[i]
            or (is_ascii_letter(prefix[i]) and s[i] == prefix[i] ^ 32)
        ):
            return False
    return True


# Returns pointer just after headers, or NULL if headers are incomplete
def parse_headers(s: byte*, content_length: int*) -> byte*:
    while True:
        end_of_header = strchr(s, '\n')
        if end_of_header == NULL:
            return NULL
        end_of_header++

        # Langserver spec guarantees it's \r\n, not just \n, but we support
        # both in case I want to try something by pasting text to terminal.
        if end_of_header == &s[1] or (*s == '\r' and end_of_header == &s[2]):
            return end_of_header

        if starts_with_ignore_case(s, "Content-Length: "):
            *content_length = atoi(&s[16])

        s = end_of_header


@public
def process_input(state: LangserverState*, input_chunk: byte*) -> None:
    state.input_accumulator.extend_from_ptr(input_chunk, strlen(input_chunk))

    # Make sure it ends with '\0' so we can treat it as a string
    state.input_accumulator.append('\0')
    state.input_accumulator.pop()  # does not deallocate/shrink

    message_start = state.input_accumulator.ptr
    while True:
        content_length = -1
        body = parse_headers(message_start, &content_length)
        if body == NULL:
            break  # not enough data yet
        if content_length <= 0:
            fail("failed to parse Content-Length header in input")

        # This would be UB in C, because this may index beyond the array's end.
        if &body[content_length] > state.input_accumulator.end():
            break  # not enough data yet

        # No need to copy to new place in memory, lol
        old_byte = body[content_length]
        body[content_length] = '\0'
        handle_one_message(state, body)
        body[content_length] = old_byte
        message_start = &body[content_length]

    # Yes, I know that memmove() is not as efficient as a ring buffer, but it's
    # easily good enough for this.
    nbytes_remaining = (state.input_accumulator.end() as intnative) - (message_start as intnative)
    memmove(state.input_accumulator.ptr, message_start, nbytes_remaining)
    state.input_accumulator.len = nbytes_remaining


# TODO(Jou): allow accessing string inside JSON without a stupid heap allocation
def json_to_fixed_size_string(json: byte*, out: byte*, out_size: intnative) -> bool:
    assert out_size > 0
    out[0] = '\0'

    s = json_to_string(json)
    if s == NULL:
        return False
    snprintf(out, out_size, "%s", s)
    free(s)
    return True


def parse_id(json: byte*) -> RequestID:
    number = json_to_double(json)
    if not isnan(number):
        return RequestID{number = number}

    id = RequestID{is_string = True}
    if not json_to_fixed_size_string(json, id.string, array_count(id.string)):
        snprintf(big_buffer, sizeof(big_buffer), "could not parse ID in JSON: %s", json)
        fail(big_buffer)
    return id


# TODO(Jou): this should probably be a method on JSONBuilder
def finish_json_builder_without_freeing_memory(jb: JSONBuilder*) -> byte*:
    assert jb.depth == 0  # If this fails, you forgot to call end_array() or end_object()

    jb.output.append('\0')
    jb.output.len = 0
    return jb.output.ptr


# See https://www.jsonrpc.org/specification
# TODO: handle batches?
def handle_one_message(state: LangserverState*, body_string: byte*) -> None:
    if not json_is_valid(body_string):
        fail("message body is not valid JSON")

    if not json_equals_string(json_get(body_string, "jsonrpc"), "2.0"):
        fail("JSON doesn't specify jsonrpc \"2.0\"")

    assert state.out.output.len == 0
    state.out.begin_object()
    state.out.key("jsonrpc").string("2.0")

    old_len = state.out.output.len

    method_json = json_get(body_string, "method")
    if method_json != NULL:
        # It is a request
        method: byte[200]
        if not json_to_fixed_size_string(method_json, method, sizeof(method)):
            fail("could not get method from JSON")

        params_json = json_get(body_string, "params")  # may be NULL

        id_json = json_get(body_string, "id")
        if id_json == NULL:
            # no ID
            handle_request(state, method, NULL, params_json)
        else:
            id = parse_id(id_json)
            handle_request(state, method, &id, params_json)

    else:
        # It is a response. Responses always contain ID of the corresponding request.
        id = parse_id(json_get(body_string, "id"))

        result_json = json_get(body_string, "result")
        if result_json == NULL:
            handle_error_response(body_string)
        else:
            handle_success_response(id, result_json)

    something_was_added = state.out.output.len > old_len

    state.out.end_object()
    out_json = finish_json_builder_without_freeing_memory(&state.out)

    if something_was_added:
        headers: byte[100]
        sprintf(headers, "Content-Length: %zd\r\n\r\n", strlen(out_json))
        write_to_stdout(headers)
        write_to_stdout(out_json)
