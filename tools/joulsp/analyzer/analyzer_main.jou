import "stdlib/list.jou"
import "stdlib/limits.jou"
import "stdlib/intnative.jou"
import "stdlib/str.jou"
import "stdlib/assert.jou"

import "../allocator.jou"
import "./analyzer_state.jou"


def add_diagnostic(
    state: AnalyzerState*,
    file: AnalyzerFile*,
    slice: Slice[byte],
    text: byte*,
) -> None:
    assert slice.len > 0
    assert slice.ptr >= file.content
    assert slice.end() <= &file.content[file.size]

    if (slice.end() as intnative) - (file.content as intnative) > INT32_MAX:
        # source file bigger than 2GB?...lol
        return

    diag = Diagnostic{
        start_offset = ((slice.ptr as intnative) - (file.content as intnative)) as int,
        end_offset = ((slice.end() as intnative) - (file.content as intnative)) as int,
        text = state.analyze_allocator.strdup(text),
    }
    file.diagnostics.append(&state.analyze_allocator, diag)


@public
def analyze(state: AnalyzerState*) -> None:
    state.analyze_allocator.reset(0)

    for fp = state.files.ptr; fp < state.files.end(); fp++:
        (*fp).diagnostics = Slice[Diagnostic]{}

    for fp = state.files.ptr; fp < state.files.end(); fp++:
        file: AnalyzerFile* = *fp

        if not file.is_open_in_editor:
            continue

        assert file.content != NULL

        # TODO: do better analyzing than looking for string "caca"
        for p = file.content; p < &file.content[file.size]; p++:
            if starts_with(p, "caca"):
                add_diagnostic(state, file, Slice[byte]{ptr=p, len=4}, "märkää kakkaa")
