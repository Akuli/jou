import "stdlib/assert.jou"
import "stdlib/io.jou"
import "stdlib/limits.jou"
import "stdlib/time.jou"
import "stdlib/mem.jou"
import "stdlib/str.jou"
import "stdlib/intnative.jou"
import "stdlib/list.jou"

import "../allocator.jou"
import "../hash.jou"
import "./analyzer_state.jou"


# TODO(Jou): This should probably be a `const`, but that triggers unreachable
#            code warnings.
global DEBUG_PRINTS: bool = True


@inline
def normalize_path_byte(b: byte) -> byte:
    if WINDOWS:
        # Non-ASCII is also case-insensitive on windows, but this should be
        # good enough for anything practical
        if 'A' <= b and b <= 'Z':
            return 'a' + (b - 'A')
        if b == '\\':
            return '/'
    return b

def path_strcmp(a: byte*, b: byte*) -> int:
    while *a != '\0' or *b != '\0':
        a_byte = normalize_path_byte(*a++)
        b_byte = normalize_path_byte(*b++)
        if a_byte != b_byte:
            return (a_byte as int) - (b_byte as int)
    return 0


# Returned pointer stays stable for a pretty long time
@public
def find_analyzer_file(state: AnalyzerState*, path: byte*) -> AnalyzerFile*:
    # A hash table should be added if this becomes a bottleneck
    for p = state.files.ptr; p < state.files.end(); p++:
        if path_strcmp((*p).path, path) == 0:
            return *p
    return NULL


# Returned pointer stays stable for a pretty long time
@public
def find_or_create_analyzer_file(state: AnalyzerState*, path: byte*) -> AnalyzerFile*:
    existing = find_analyzer_file(state, path)
    if existing != NULL:
        return existing

    temp = Allocator{}
    file: AnalyzerFile* = temp.alloc(sizeof(*file))
    *file = AnalyzerFile{allocator = temp, size = -1, mtime = -1}
    # After this point, the allocator must be accessed through file.allocator.

    file.path = file.allocator.strdup(path)
    strcpy(file.path, path)

    state.files.append(file)
    if DEBUG_PRINTS:
        fprintf(get_stderr(), "\"created\" file \"%s\", content is unknown for now\n", path)
    return file


def read_file_from_the_real_file_system(state: AnalyzerState*, file: AnalyzerFile*) -> None:
    assert not state.real_file_system_is_banned  # real file input should never happen during langserver --replay
    assert False  # TODO
    # TODO: remember to hash it


# Ensure the file has error message or file contents available
@public
def read_analyzer_file(state: AnalyzerState*, file: AnalyzerFile*) -> None:
    if file.expires_ns != INT64_MAX:  # Pseudo-optimization: don't call monotonic_ns() if not needed
        now = monotonic_ns()
        if file.expires_ns < now:
            # File has expired
            match state.mode:
                case AnalyzerMode.Langserver:
                    # Read file again from real system in 100ms
                    file.expires_ns = now + 100_000_000
                case AnalyzerMode.Compiler:
                    # File was never read before, and will never expire again
                    assert file.expires_ns == 0
                    file.expires_ns = INT64_MAX

            read_file_from_the_real_file_system(state, file)

    assert file.content != NULL
    assert file.content == file.content_memory
    assert file.size != -1
    assert file.content[file.size] == '\0'


def ensure_capacity(file: AnalyzerFile*, capacity_needed: intnative) -> None:
    if file.content_capacity < capacity_needed:
        if file.content_capacity == 0:
            file.content_capacity = 1
        while file.content_capacity < capacity_needed:
            file.content_capacity *= 2
        file.content_memory = file.allocator.alloc(file.content_capacity)


# After calling this, file won't be read from disk again.
# To undo this and read file from disk when needed, set expires_ns to zero.
@public
def set_analyzer_file_content(file: AnalyzerFile*, content: Slice[byte]) -> None:
    assert content.len >= 0

    ensure_capacity(file, content.len + 1)
    file.content = file.content_memory
    memcpy(file.content, content.ptr, content.len)
    file.content[content.len] = '\0'

    file.expires_ns = INT64_MAX  # does not expire by itself
    file.read_error = NULL
    file.size = content.len
    file.mtime = -1
    file.content_hash = hash(file.content, file.size)

    if DEBUG_PRINTS:
        fprintf(get_stderr(), "\"wrote\" file content of \"%s\" (now %lld bytes)\n", file.path, file.size)


@public
def apply_change_to_analyzer_file_content(
    file: AnalyzerFile*,
    offset: intnative,
    old_len: intnative,
    new: Slice[byte],
) -> None:
    assert old_len >= 0
    assert new.len >= 0
    assert offset >= 0

    # File should have been read already
    assert file.read_error == NULL
    assert file.content != NULL
    assert file.size >= offset + old_len

    # File should be manually tracked, as in vfs_write(), not read from disk
    assert file.expires_ns == INT64_MAX
    assert file.mtime == -1

    new_size = file.size - old_len + new.len
    if new_size + 1 > file.content_capacity:
        # Grow it first, otherwise result won't fit
        assert new_size > file.size
        assert file.content == file.content_memory
        assert file.content[file.size] == '\0'
        ensure_capacity(file, new_size + 1)
        if file.content != file.content_memory:
            # New, bigger chunk was allocated. Old memory was not and will not
            # be freed.
            assert file.content[file.size] == '\0'
            memcpy(file.content_memory, file.content, file.size + 1)
            file.content = file.content_memory

    # Move everything after the changing part
    memmove(
        &file.content[offset + new.len],
        &file.content[offset + old_len],
        file.size - (offset + old_len) + 1,  # +1 to preserve '\0'
    )

    # Put new data to its place
    memcpy(&file.content[offset], new.ptr, new.len)

    file.size = new_size
    file.content_hash = hash(file.content, file.size)

    if DEBUG_PRINTS:
        fprintf(get_stderr(), "\"wrote\" a change to file content of \"%s\" (now %lld bytes)\n", file.path, file.size)
        if file.size < 100:
            fprintf(get_stderr(), "--- begin file content ---\n%s\n--- end file content---\n", file.content)
