import "stdlib/list.jou"
import "stdlib/intnative.jou"

import "../allocator.jou"


@public
class Diagnostic:
    # If you have source file bigger than 2GB, you're screwed anyway
    start_offset: int
    end_offset: int
    text: byte*


@public
class AnalyzerFile:
    allocator: Allocator  # freed when the entire file is no longer needed
    path: byte*

    # Used to .reset() the allocator before allocating content or error. The
    # allocator is used for them once the AnalyzerFile* is constructed.
    allocator_checkpoint: intnative

    # Langserver remembers which files are open in the editor
    is_open_in_editor: bool

    # Stat results, -1 means unknown.
    #
    # Can be known even if file content is not in memory. That is useful for
    # embed_binary_file(), because we only need to know the array size.
    size: int64
    mtime_ns: int64

    # NULL means unknown. You can't have error and content, but if you have
    # neither, it means that reading the file hasn't been attempted yet.
    error: byte*  # '\0' terminated, from statting or reading the file
    content: byte*  # '\0' terminated but may contain '\0' bytes (check size)

    # These are meaningful only when content != NULL. Hopefully the name is
    # enough to remind you of that.
    content_capacity: intnative  # how many bytes could be stored, at least size+1 because '\0'
    content_hash: uint64[2]

    # Allocated with analyze_allocator
    diagnostics: Slice[Diagnostic]


@public
enum AnalyzerMode:
    Compiler
    Langserver


@public
class AnalyzerState:
    mode: AnalyzerMode

    files: List[AnalyzerFile*]
    debug_prints: bool

    # Resets at start of analyze().
    # Used for e.g. the final list of diagnostics returned from analyze()
    analyze_allocator: Allocator

    # Used to ensure that langserver --replay does not depend on any other
    # files than the file being replayed.
    real_file_system_is_banned: bool
