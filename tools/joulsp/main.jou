import "stdlib/mem.jou"
import "stdlib/ascii.jou"
import "stdlib/argparse.jou"
import "stdlib/io.jou"
import "stdlib/process.jou"
import "stdlib/str.jou"

import "./state.jou"
import "./jsonrpc_parser.jou"
import "./fail.jou"

if WINDOWS:
    import "stdlib/windows_api/kernel32.jou"
else:
    import "../joutest/posix.jou"  # TODO: move this stuff to stdlib , or copy here
    import "stdlib/errno.jou"


# If you shrink this, existing files created with --record will no longer work.
# So, starting pretty small.
global stdin_buf: byte[3]  # slow, but catches some bugs during development
#global stdin_buf: byte[1024]


# Stops reading when there is no more data available in stdin.
# Returns a string. NULL means EOF.
#
# Example usage:
#
#    def main() -> int:
#        while True:
#            s = read_from_stdin()
#            if s == NULL:
#                printf("EOF\n")
#                return 0
#            printf("%s", s)
#            fflush(get_stdout())
#
# Run with:
#
#   $ yes hello | (while IFS= read -n1 c; do echo -n $c; sleep 0.1; done) | jou example.jou
#
# This should produce hellohellohellohello... so that it appears one chunk at a time.
#
# A couple ways to test read errors (both on posix)
#
#   $ jou example.jou <&-
#   $ jou example.jou < /
def read_from_stdin() -> byte*:
    if WINDOWS:
        nbytes: uint32 = 0
        ret = ReadFile(GetStdHandle(STD_INPUT_HANDLE), stdin_buf, (sizeof(stdin_buf) - 1) as uint32, &nbytes, NULL)
        if ret == 0:
            fail_with_windows_error("reading stdin failed", GetLastError())
    else:
        nbytes = read(0, stdin_buf, sizeof(stdin_buf) - 1) as int
        if nbytes < 0:
            fail_with_errno("reading stdin failed", get_errno())

    if nbytes == 0:
        return NULL

    for i = 0; i < nbytes; i++:
        if stdin_buf[i] == '\0':
            fail("received zero byte on stdin")
    stdin_buf[nbytes] = '\0'
    return stdin_buf


def get_input(state: LangserverState*) -> byte*:
    if state.replay_file == NULL:
        return read_from_stdin()

    while True:
        op_byte = fgetc(state.replay_file)
        match op_byte:
            case EOF:
                if ferror(state.replay_file) != 0:
                    fail_with_errno("reading replay file failed", get_errno())
                return NULL

            case 'I':
                # Input chunk that came from stdin on previous run
                i = 0
                while True:
                    c = fgetc(state.replay_file)
                    if c == EOF:
                        fail("reading input from replay file failed")
                    if i == array_count(stdin_buf):
                        fail("input string in replay file is too long")
                    stdin_buf[i++] = c as byte
                    # Stop after we copy zero byte
                    if c == '\0':
                        break

                # TODO: Populate VFS with file contents as long as there's 'F' entry in file
                #       (use ungetc() if no EOF after last file)
                #       declare ungetc(c: int, stream: FILE*) -> int

                return stdin_buf

            case _:
                if is_ascii_letter(op_byte as byte) or is_ascii_digit(op_byte as byte):
                    snprintf(big_buffer, sizeof(big_buffer), "replay file contains unknown op byte '%c'", op_byte)
                else:
                    snprintf(big_buffer, sizeof(big_buffer), "replay file contains unknown op byte 0x%02x", op_byte)
                fail(big_buffer)


def parse_command_line_args(state: LangserverState*, argv: byte**) -> None:
    parser = ArgumentParser{argv = argv}

    while parser.next():
        match parser.flag with strcmp:
            case "--help":
                printf("Usage: %s [options]\n", argv[0])
                printf("\n")
                printf("Options:\n")
                printf("  --record FILE.bin   write inputs needed to reproduce bugs to FILE.bin\n")
                printf("  --replay FILE.bin   instead of reading stdin and project files, take all\n")
                printf("                      input from a file produced by --record and reproduce\n")
                printf("                      what the langserver did\n")
                exit(0)

            case "--record":
                if state.record_file != NULL:
                    fprintf(get_stderr(), "%s: --record cannot be specified twice (try --help)\n", argv[0])
                    exit(2)

                filename = parser.take_value()
                if filename == NULL:
                    fprintf(get_stderr(), "%s: missing file name after --record (try --help)\n", argv[0])
                    exit(2)

                state.record_file = fopen(filename, "wb")
                if state.record_file == NULL:
                    fprintf(get_stderr(), "%s: cannot open \"%s\": %s\n", argv[0], filename, strerror(get_errno()))
                    exit(2)

            case "--replay":
                if state.replay_file != NULL:
                    fprintf(get_stderr(), "%s: --replay cannot be specified twice (try --help)\n", argv[0])
                    exit(2)

                filename = parser.take_value()
                if filename == NULL:
                    fprintf(get_stderr(), "%s: missing file name after --replay (try --help)\n", argv[0])
                    exit(2)

                state.replay_file = fopen(filename, "rb")
                if state.replay_file == NULL:
                    fprintf(get_stderr(), "%s: cannot open \"%s\": %s\n", argv[0], filename, strerror(get_errno()))
                    exit(2)

            case _:
                fprintf(get_stderr(), "%s: unknown argument '%s' (try --help)\n", argv[0], parser.flag if parser.flag[0] != '\0' else parser.take_value())
                exit(2)

        if parser.pending_value != NULL:
            fprintf(get_stderr(), "%s: flag \"%s\" does not take a value (try --help)\n", argv[0], parser.flag)
            exit(2)


def init_record_and_replay(state: LangserverState*) -> None:
    # Primeagen says, always add a version number, sure lets do it i guess
    file_format_header = "joulsp replay v1\n"

    if state.replay_file != NULL:
        header_size = fread(big_buffer, 1, strlen(file_format_header), state.replay_file)
        if header_size != strlen(file_format_header) or memcmp(big_buffer, file_format_header, header_size) != 0:
            fail("unsupported file format in replay file")

    if state.record_file != NULL:
        fputs(file_format_header, state.record_file)


def main(argc: int, argv: byte**) -> int:
    state = LangserverState{}
    parse_command_line_args(&state, argv)

    init_record_and_replay(&state)

    while True:
        input = get_input(&state)
        if input == NULL:
            # Editor closed our stdin
            return 0  # TODO: is this the correct thing to do here?

        if state.record_file != NULL:
            fputc('I', state.record_file)
            fwrite(input, 1, strlen(input) + 1, state.record_file)  # includes '\0' to indicate where it ends
            fflush(state.record_file)

        process_input(&state, input)
