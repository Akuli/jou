import "stdlib/argparse.jou"
import "stdlib/io.jou"
import "stdlib/process.jou"
import "stdlib/str.jou"
import "stdlib/errno.jou"

import "./langserver/langserver_main.jou"


def main(argc: int, argv: byte**) -> int:
    parser = ArgumentParser{argv = argv}
    record_file: FILE* = NULL
    replay_file: FILE* = NULL

    while parser.next():
        match parser.flag with strcmp:
            case "--help":
                printf("Usage: %s [options]\n", argv[0])
                printf("\n")
                printf("Options:\n")
                printf("  --record FILE.bin   write inputs needed to reproduce bugs to FILE.bin\n")
                printf("  --replay FILE.bin   instead of reading stdin and project files, take all\n")
                printf("                      input from a file produced by --record and reproduce\n")
                printf("                      what the langserver did\n")
                exit(0)

            case "--record":
                if record_file != NULL:
                    fprintf(get_stderr(), "%s: --record cannot be specified twice (try --help)\n", argv[0])
                    exit(2)

                filename = parser.take_value()
                if filename == NULL:
                    fprintf(get_stderr(), "%s: missing file name after --record (try --help)\n", argv[0])
                    exit(2)

                record_file = fopen(filename, "wb")
                if record_file == NULL:
                    fprintf(get_stderr(), "%s: cannot open \"%s\": %s\n", argv[0], filename, strerror(get_errno()))
                    exit(2)

            case "--replay":
                if replay_file != NULL:
                    fprintf(get_stderr(), "%s: --replay cannot be specified twice (try --help)\n", argv[0])
                    exit(2)

                filename = parser.take_value()
                if filename == NULL:
                    fprintf(get_stderr(), "%s: missing file name after --replay (try --help)\n", argv[0])
                    exit(2)

                replay_file = fopen(filename, "rb")
                if replay_file == NULL:
                    fprintf(get_stderr(), "%s: cannot open \"%s\": %s\n", argv[0], filename, strerror(get_errno()))
                    exit(2)

            case _:
                fprintf(get_stderr(), "%s: unknown argument '%s' (try --help)\n", argv[0], parser.flag if parser.flag[0] != '\0' else parser.take_value())
                exit(2)

        if parser.pending_value != NULL:
            fprintf(get_stderr(), "%s: flag \"%s\" does not take a value (try --help)\n", argv[0], parser.flag)
            exit(2)

    langserver(record_file, replay_file)
