if WINDOWS:
    import "../joutest/windows_api.jou"
else:
    import "../joutest/posix.jou"


global stdin_buf: byte[65536]

# Reads from stdin to stdin_buf.
# Stops reading when there is no more data available in stdin or stdin_buf is full.
# Returns number of bytes read.
#
# Example usage:
#
#    declare sleep(seconds: uint32) -> uint32
#
#    def main() -> int:
#        while True:
#            nbytes = read_from_stdin()
#            if nbytes < 0:
#                fprintf(get_stderr(), "joulsp: error reading from stdin\n")
#                return 1
#
#            fwrite(stdin_buf, 1, nbytes, get_stdout())
#            fflush(get_stdout())
#            sleep(1)
#
# Run with:
#
#   $ yes hello | (while IFS= read -n1 c; do echo -n $c; sleep 0.1; done) | jou example.jou
#
# This should produce hellohellohellohello... so that it appears one chunk at a time.
def read_from_stdin() -> int:
    if WINDOWS:
        nbytes: uint32 = 0
        ret = ReadFile(GetStdHandle((-10) as uint32), stdin_buf, sizeof(stdin_buf) as uint32, &nbytes, NULL)
        if ret == 0:
            return -1
        return nbytes as int
    else:
        return read(0, stdin_buf, sizeof(stdin_buf)) as int


