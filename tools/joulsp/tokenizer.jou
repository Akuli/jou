def error(message: byte*) -> None:
    # TODO: collect the errors, don't print right away
    printf("ERROR: %s\n", message)


def looks_like_identifier(b: byte) -> bool:
    return b >= 128 or is_ascii_letter(b) or is_ascii_digit(b) or b == '_'

# This function mostly splits the code into tokens and does as little other
# work as possible. A lot of checking is done after calling this.
def tokenize(code: byte*) -> None:
    while *code != '\0':
        t = Token{start = code}
        match *code:
            case '#':
                while *code != '\0' and *code != '\n':
                    code++
                continue

            case '@':
                t.kind = TokenKind.Decorator
                code++
                while looks_like_identifier(*code):
                    code++

            case ' ':
                code++
                continue

            case '"' | '\'':
                quote = *code++
                t.kind = TokenKind.String if quote == '"' else TokenKind.Byte
                # TODO: test backslash at end of file without anything (not even newline) after it
                while *code != '\0' and *code != '\n' and *code != quote:
                    c = *code++
                    if c == '\\' and *code != '\0':
                        code++  # ignore byte just after backslash
                if *code == quote:
                    code++

            case '\n':
                t.kind = TokenKind.Newline
                # TODO: read indentation level
                # TODO: ignore everything if in space only mode
                code++

            # TODO: numbers

            case (
                '=' | '<' | '>' | '!' | '.' | ',' | '(' | ')' | '[' | ']' | '{' | '}'
                | ';' | ':' | '+' | '-' | '*' | '/' | '&' | '%' | '|' | '^' | '~'
            ):
                t.kind = TokenKind.Operator
                # Please update the syntax documentation if you add new operators.
                # Longer operators are first, so that '==' does not tokenize as '=' '='
                if (
                    starts_with(code, "<<=")
                    or starts_with(code, ">>=")
                    or starts_with(code, "//=")
                    or starts_with(code, "...")
                    or starts_with(code, "===")  # only for error messages
                    or starts_with(code, "!==")  # only for error messages
                ):
                    code = &code[3]
                elif (
                    starts_with(code, "==")
                    or starts_with(code, "!=")
                    or starts_with(code, "->")
                    or starts_with(code, "<=")
                    or starts_with(code, ">=")
                    or starts_with(code, "++")
                    or starts_with(code, "--")
                    or starts_with(code, "+=")
                    or starts_with(code, "-=")
                    or starts_with(code, "*=")
                    or starts_with(code, "/=")
                    or starts_with(code, "%=")
                    or starts_with(code, "&=")
                    or starts_with(code, "|=")
                    or starts_with(code, "^=")
                    or starts_with(code, "<<")
                    or starts_with(code, ">>")
                    or starts_with(code, "//")
                    or starts_with(code, "&&")  # only for error messages
                    or starts_with(code, "||")  # only for error messages
                ):
                    code = &code[2]
                else:
                    code++

            case _:
                if looks_like_identifier(*code):
                    # variable name or keyword, numbers were handled above
                    while looks_like_identifier(*code):
                        code++
                    if is_keyword(t.start, code):
                        t.kind = TokenKind.Keyword
                    else:
                        t.kind = TokenKind.Name
                else:
                    if is_ascii_printable(*code):
                        sprintf(big_buffer, "unexpected byte '%c' (%#02x)", *code, *code)
                    else:
                        sprintf(big_buffer, "unexpected byte %#02x", *code)
                    error(big_buffer)
                    # Don't get stuck when an error happens, move on to tokenize the rest
                    code++
                    continue

        t.end = code
        t.print()


def main() -> int:
    memset(big_buffer, 0, sizeof(big_buffer))
    fread(big_buffer, 1, sizeof(big_buffer) - 1, get_stdin())
    tokenize(strdup(big_buffer))
    return 0
