import "stdlib/assert.jou"
import "stdlib/time.jou"
import "stdlib/io.jou"

import "../joulsp/query_hash_table.jou"
import "../joulsp/state.jou"
import "../joulsp/allocator.jou"


def test_adding_and_finding() -> None:
    state = State{}

    p1 = QueryParams{kind = QueryKind.ReadFile, context = SymbolContext{uri = "file:///home/akuli/jou/stdlib/io.jou"}}
    p2 = QueryParams{kind = QueryKind.FindAccessibleDefinition, context = SymbolContext{uri = "file:///home/akuli/jou/foo.jou"}, name = "thing"}
    assert find_query_from_hash_table(&state, &p1) == NULL
    assert find_query_from_hash_table(&state, &p2) == NULL

    add_query_to_hash_table(&state, &p1)  # Output: Query hash table grew to 4 slots (1 used)
    puts("---")  # Output: ---
    assert find_query_from_hash_table(&state, &p1) != NULL
    assert find_query_from_hash_table(&state, &p2) == NULL

    add_query_to_hash_table(&state, &p2)
    puts("---")  # Output: ---
    assert find_query_from_hash_table(&state, &p1) != NULL
    assert find_query_from_hash_table(&state, &p2) != NULL

    # Output: queries_table:
    # Output:   Query: uri="file:///home/akuli/jou/foo.jou", last_used_time=0, ndeps=0
    # Output:   Query: uri="file:///home/akuli/jou/stdlib/io.jou", last_used_time=0, ndeps=0
    # Output:   NULL
    # Output:   NULL
    printf("queries_table:\n")
    for i = 0; i < state.queries_capacity; i++:
        q = state.queries_table[i]
        if q == NULL:
            printf("  NULL\n")
        else:
            printf("  Query: uri=\"%s\", last_used_time=%lld, ndeps=%d\n", q.params.context.uri, q.last_used_time, q.ndeps)


def test_deleting_old() -> None:
    state = State{}

    p1 = QueryParams{kind = QueryKind.ReadFile, context = SymbolContext{uri = "file:///home/akuli/jou/stdlib/io.jou"}}
    p2 = QueryParams{kind = QueryKind.FindAccessibleDefinition, context = SymbolContext{uri = "file:///home/akuli/jou/foo.jou"}, name = "foo"}
    p3 = QueryParams{kind = QueryKind.FindAccessibleDefinition, context = SymbolContext{uri = "file:///home/akuli/jou/foo.jou"}, name = "bar"}
    # Output: Query hash table grew to 4 slots (1 used)
    # Output: Query hash table grew to 8 slots (3 used)
    add_query_to_hash_table(&state, &p1)
    add_query_to_hash_table(&state, &p2)
    add_query_to_hash_table(&state, &p3)
    q1 = find_query_from_hash_table(&state, &p1)
    q2 = find_query_from_hash_table(&state, &p2)
    q3 = find_query_from_hash_table(&state, &p3)

    # Queries 2 and 3 depend on query 1
    for i = 2; i <= 3; i++:
        q = q2 if i == 2 else q3
        q.deps = q.results.allocator.alloc(sizeof(q.deps[0]) * 1)
        q.deps[0] = QueryAndVersion{query = q1, version = q1.version}
        q.ndeps = 1

    # Output: queries_table:
    # Output:   NULL
    # Output:   Query: uri="file:///home/akuli/jou/stdlib/io.jou", last_used_time=0, ndeps=0
    # Output:   NULL
    # Output:   Query: uri="file:///home/akuli/jou/foo.jou", last_used_time=0, ndeps=1
    # Output:   Query: uri="file:///home/akuli/jou/foo.jou", last_used_time=0, ndeps=1
    # Output:   NULL
    # Output:   NULL
    # Output:   NULL
    printf("queries_table:\n")
    for i = 0; i < state.queries_capacity; i++:
        q = state.queries_table[i]
        if q == NULL:
            printf("  NULL\n")
        else:
            printf("  Query: uri=\"%s\", last_used_time=%lld, ndeps=%d\n", q.params.context.uri, q.last_used_time, q.ndeps)

    # Suppose it's been a long time since file was read or we had anything to
    # do with foo, but we used bar recently
    q1.last_used_time = time(NULL) - 100
    q2.last_used_time = time(NULL) - 100
    q3.last_used_time = time(NULL) - 5

    printf("%zd\n", state.queries_count)  # Output: 3
    delete_old_queries(&state)          # Output: Old query cleanup: 1/3 queries deleted
    printf("%zd\n", state.queries_count)  # Output: 2

    # Query 2 is gone, queries 1 and 3 remain
    assert find_query_from_hash_table(&state, &p1) == q1
    assert find_query_from_hash_table(&state, &p2) == NULL
    assert find_query_from_hash_table(&state, &p3) == q3


def main() -> int:
    QUERY_HASH_TABLE_DEBUG_PRINTS = True

    test_adding_and_finding()
    test_deleting_old()
    return 0
