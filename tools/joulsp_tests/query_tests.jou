import "stdlib/assert.jou"
import "stdlib/str.jou"
import "stdlib/errno.jou"
import "stdlib/time.jou"
import "stdlib/io.jou"

import "../joulsp/allocator.jou"
import "../joulsp/query_hash_table.jou"
import "../joulsp/query_engine.jou"
import "../joulsp/state.jou"


def test_adding_and_finding() -> None:
    state = State{}

    q1 = Query{
        params = QueryParams{
            kind = QueryKind.ReadFile,
            context = SymbolContext{path = "/home/akuli/jou/stdlib/io.jou"},
        },
    }
    q2 = Query{
        params = QueryParams{
            kind = QueryKind.FindAccessibleDefinition,
            context = SymbolContext{path = "/home/akuli/foo.jou"},
            name = "thing",
        },
    }
    assert find_query_from_hash_table(&state, &q1.params) == NULL
    assert find_query_from_hash_table(&state, &q2.params) == NULL

    add_query_to_hash_table(&state, &q1)  # Output: Growing query hash table to 4 slots (1 used)
    puts("---")  # Output: ---
    assert find_query_from_hash_table(&state, &q1.params) == &q1
    assert find_query_from_hash_table(&state, &q2.params) == NULL

    add_query_to_hash_table(&state, &q2)
    puts("---")  # Output: ---
    assert find_query_from_hash_table(&state, &q1.params) == &q1
    assert find_query_from_hash_table(&state, &q2.params) == &q2

    # Output: queries_table:
    # Output:   NULL
    # Output:   ReadFile "/home/akuli/jou/stdlib/io.jou"
    # Output:   NULL
    # Output:   FindAccessibleDefinition "/home/akuli/foo.jou" thing
    printf("queries_table:\n")
    for i = 0; i < state.queries_capacity; i++:
        q = state.queries_table[i]
        if q == NULL:
            printf("  NULL\n")
        else:
            printf("  %s\n", q.params.debug_string())


def test_deleting_old() -> None:
    state = State{}

    q1 = Query{
        params = QueryParams{
            kind = QueryKind.ReadFile,
            context = SymbolContext{path = "/home/akuli/jou/stdlib/io.jou"},
        },
    }
    q2 = Query{
        params = QueryParams{
            kind = QueryKind.FindAccessibleDefinition,
            context = SymbolContext{path = "/home/akuli/jou/foobar.jou"},
            name = "foo",
        },
    }
    q3 = Query{
        params = QueryParams{
            kind = QueryKind.FindAccessibleDefinition,
            context = SymbolContext{path = "/home/akuli/jou/foobar.jou"},
            name = "bar",
        },
    }
    # Output: Growing query hash table to 4 slots (1 used)
    # Output: Growing query hash table to 8 slots (3 used)
    add_query_to_hash_table(&state, &q1)
    add_query_to_hash_table(&state, &q2)
    add_query_to_hash_table(&state, &q3)

    # Queries 2 and 3 depend on query 1
    for i = 2; i <= 3; i++:
        q = &q2 if i == 2 else &q3
        q.deps = q.results.allocator.alloc(sizeof(q.deps[0]) * 1)
        q.deps[0] = QueryAndVersion{query = &q1, version = q1.version}
        q.ndeps = 1

    # Output: queries_table:
    # Output:   FindAccessibleDefinition "/home/akuli/jou/foobar.jou" bar ndeps=1
    # Output:   ReadFile "/home/akuli/jou/stdlib/io.jou" ndeps=0
    # Output:   NULL
    # Output:   FindAccessibleDefinition "/home/akuli/jou/foobar.jou" foo ndeps=1
    # Output:   NULL
    # Output:   NULL
    # Output:   NULL
    # Output:   NULL
    printf("queries_table:\n")
    for i = 0; i < state.queries_capacity; i++:
        q = state.queries_table[i]
        if q == NULL:
            printf("  NULL\n")
        else:
            printf("  %s ndeps=%d\n", q.params.debug_string(), q.ndeps)

    # Suppose it's been a long time since file was read or we had anything to
    # do with foo, but we used bar recently
    q1.last_used_time = time(NULL) - 100
    q2.last_used_time = time(NULL) - 100
    q3.last_used_time = time(NULL) - 5

    printf("%zd\n", state.queries_count)  # Output: 3
    delete_old_queries(&state)          # Output: Old query cleanup: 1/3 queries deleted
    printf("%zd\n", state.queries_count)  # Output: 2

    # Query 2 is gone, queries 1 and 3 remain
    assert find_query_from_hash_table(&state, &q1.params) == &q1
    assert find_query_from_hash_table(&state, &q2.params) == NULL
    assert find_query_from_hash_table(&state, &q3.params) == &q3


def show_nicely(s: byte*) -> byte*:
    if WINDOWS and s != NULL and strcmp(s, strerror(2)) == 0:
        return "No such file or directory"
    if s != NULL and s[0] == '\0':
        return "(empty)"
    return s

def test_read_file() -> None:
    state = State{}
    params = QueryParams{kind = QueryKind.ReadFile, context = SymbolContext{path="hello.txt"}}

    # Output: ReadFile "hello.txt": new query
    results = run_query(&state, &params)
    assert results != NULL  # not cyclic dependency

    # Output: File content: hello
    # Output:
    # Output: File content hash: 0xa9bc80cca21f28b3
    # Output: Error: (empty)
    # Output: ----
    printf("File content: %s\n", show_nicely(results.read_file.content))
    printf("File content hash: 0x%llx\n", results.read_file.content_hash)
    printf("Error: %s\n", show_nicely(results.read_file.error))
    printf("----\n")

    # Output: ReadFile "hello.txt": using previous result
    results = run_query(&state, &params)
    assert results != NULL  # not cyclic dependency

    # Output: File content: hello
    # Output:
    # Output: File content hash: 0xa9bc80cca21f28b3
    # Output: Error: (empty)
    # Output: ----
    printf("File content: %s\n", show_nicely(results.read_file.content))
    printf("File content hash: 0x%llx\n", results.read_file.content_hash)
    printf("Error: %s\n", show_nicely(results.read_file.error))
    printf("----\n")

    params.context.path = "does_not_exist.txt"

    # Output: ReadFile "does_not_exist.txt": new query
    results = run_query(&state, &params)
    assert results != NULL  # not cyclic dependency

    # Output: File content: (empty)
    # Output: File content hash: 0xcbf29ce484222325
    # Output: Error: No such file or directory
    # Output: ----
    printf("File content: %s\n", show_nicely(results.read_file.content))
    printf("File content hash: 0x%llx\n", results.read_file.content_hash)
    printf("Error: %s\n", show_nicely(results.read_file.error))
    printf("----\n")

    # Output: ReadFile "does_not_exist.txt": using previous result
    results = run_query(&state, &params)
    assert results != NULL  # not cyclic dependency

    # Output: File content: (empty)
    # Output: File content hash: 0xcbf29ce484222325
    # Output: Error: No such file or directory
    # Output: ----
    printf("File content: %s\n", show_nicely(results.read_file.content))
    printf("File content hash: 0x%llx\n", results.read_file.content_hash)
    printf("Error: %s\n", show_nicely(results.read_file.error))
    printf("----\n")


def main() -> int:
    QUERY_HASH_TABLE_DEBUG_PRINTS = True
    test_adding_and_finding()
    test_deleting_old()
    QUERY_HASH_TABLE_DEBUG_PRINTS = False

    QUERY_ENGINE_DEBUG_PRINTS = True
    test_read_file()
    QUERY_ENGINE_DEBUG_PRINTS = False

    return 0
