import "stdlib/argparse.jou"
import "stdlib/ascii.jou"
import "stdlib/mem.jou"
import "stdlib/assert.jou"
import "stdlib/math.jou"
import "stdlib/io.jou"
import "stdlib/list.jou"
import "stdlib/process.jou"
import "stdlib/str.jou"

import "./ansi_colors.jou"
import "./state.jou"

if WINDOWS:
    import "stdlib/windows_api/kernel32.jou"
else:
    import "stdlib/intnative.jou"


if not WINDOWS:
    # Number of CPUs determining stuff
    declare sysconf(n: int) -> intnative
    if LINUX:
        const _SC_NPROCESSORS_ONLN: int = 84
    elif MACOS:
        const _SC_NPROCESSORS_ONLN: int = 58
    elif NETBSD:
        const _SC_NPROCESSORS_ONLN: int = 1002
    else:
        assert False

def get_number_of_cpus() -> int:
    if WINDOWS:
        return GetActiveProcessorCount(ALL_PROCESSOR_GROUPS) as int
    else:
        return sysconf(_SC_NPROCESSORS_ONLN) as int


def print_help(argv0: byte*) -> None:
    printf("Usage: %s [options] [FILTER FILTER2 FILTER3 ...]\n", argv0)
    printf("\n")
    printf("Options:\n")
    printf("  -v / --verbose        show more output than by default\n")
    printf("  --no-colors           do not print with colors\n")
    printf("  --lf / --last-failed  only run tests that failed or were not present in the\n")
    printf("                        previous test run (useful in large projects)\n")
    printf("  -j1/-j2/-j3/...       how many tests to run in parallel (default = number of\n")
    printf("                        CPU cores)\n")
    printf("  --jou=\"...\"           what to use instead of \"jou\" in the default command\n")
    printf("                        (example: --jou=\"jou -O3\")\n")
    printf("\n")
    printf("If FILTER arguments are given, only run the tests whose file path contains one\n")
    printf("or more FILTERs as a substring.\n")


@public
def step1_parse_command_line_args(argc: int, argv: byte**) -> CommandLineArgs:
    args = CommandLineArgs{parallelism = min(get_number_of_cpus(), MAX_PARALLELISM)}
    args.jou_command.append("jou")

    parser = ArgumentParser{argv = argv}
    while parser.next():
        match parser.flag with strcmp:
            case "--help":
                print_help(argv[0])
                exit(0)
            case "-v" | "--verbose":
                args.verbose = True
            case "--no-colors":
                disable_colors()
            case "--lf" | "--last-failed":
                args.last_failed = True
            case "-j":
                string = parser.take_value()
                args.parallelism = atoi("" if string == NULL else string)
                string2: byte[100]
                sprintf(string2, "%d", args.parallelism)
                if args.parallelism < 1 or strcmp(string, string2) != 0:
                    fprintf(get_stderr(), "%s: after -j, you must specify the number of tests to run in parallel (try --help)\n", argv[0])
                    exit(2)
                if args.parallelism > MAX_PARALLELISM:
                    fprintf(get_stderr(), "%s: -j%d is not supported (the maximum is -j%d)\n", argv[0], args.parallelism, MAX_PARALLELISM)
                    exit(2)
            case "--jou":
                s = parser.take_value()
                if s == NULL:
                    fprintf(get_stderr(), "%s: you need to specify a command that invokes jou after --jou-command (try --help)\n", argv[0])
                    exit(2)
                if strchr(s, '"') != NULL or strchr(s, '\'') != NULL:
                    fprintf(get_stderr(), "%s: --jou-command cannot contain quotes, please create an issue on GitHub if you need to quote something\n")
                    exit(2)
                s = strdup(s)
                assert s != NULL
                free(args.jou_command.ptr)
                args.jou_command = split_by_ascii_whitespace(s)
                if args.jou_command.len == 0:
                    fprintf(get_stderr(), "%s: --jou-command cannot be empty (try --help)\n")
                    exit(2)
            case "":
                args.filter_strings.append(parser.take_value())
            case _:
                fprintf(get_stderr(), "%s: unknown argument \"%s\" (try --help)\n", argv[0], parser.flag)
                exit(2)

        if parser.pending_value != NULL:
            fprintf(get_stderr(), "%s: flag \"%s\" does not take a value (try --help)\n", argv[0], parser.flag)
            exit(2)

    assert 1 <= args.parallelism and args.parallelism <= MAX_PARALLELISM
    return args
