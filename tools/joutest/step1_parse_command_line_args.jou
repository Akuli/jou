import "stdlib/ascii.jou"
import "stdlib/io.jou"
import "stdlib/list.jou"
import "stdlib/process.jou"
import "stdlib/str.jou"

import "./ansi_colors.jou"
import "./state.jou"


def print_help(program_name: byte*) -> None:
    printf("Usage: %s [options] [FILTER FILTER2 FILTER3 ...]\n", program_name)
    printf("\n")
    printf("Options:\n")
    printf("  -v / --verbose        show more output than by default\n")
    printf("  --no-colors           do not print with colors\n")
    printf("  -S / --skip-success   skip tests that succeeded last time joutest was invoked\n")
    printf("\n")
    printf("If FILTER arguments are given, only run the tests whose path contains one or\n")
    printf("more FILTERs as a substring.\n")


# Checks if s looks like e.g. -Sv
def is_combined_flag(s: byte*) -> bool:
    if strlen(s) <3 or s[0] != '-':
        return False
    for i = 1; s[i] != '\0'; i++:
        if not (is_ascii_letter(s[i]) or is_ascii_digit(s[i])):
            return False
    return True


def parse_arg(program_name: byte*, args: CommandLineArgs*, arg: byte*) -> None:
    match arg with strcmp:
        case "--help":
            print_help(program_name)
            exit(0)

        case "-v" | "--verbose":
            args.verbose = True

        case "--no-colors":
            disable_colors()

        case "-S" | "--skip-success":
            args.skip_success = True

        case _:
            if arg[0] == '-':
                fprintf(get_stderr(), "%s: unknown argument \"%s\" (try \"%s --help\")\n", program_name, arg, program_name)
                exit(2)
            args.filter_strings.append(arg)


@public
def step1_parse_command_line_args(argc: int, argv: byte**) -> CommandLineArgs:
    args = CommandLineArgs{}

    for i = 1; i < argc; i++:
        if is_combined_flag(argv[i]):
            # turn "-Sv" into separate "-S" and "-v"
            for flag = &argv[i][1]; *flag != '\0'; flag++:
                arg = ['-', *flag, '\0']
                parse_arg(argv[0], &args, arg)
        else:
            parse_arg(argv[0], &args, argv[i])

    return args
