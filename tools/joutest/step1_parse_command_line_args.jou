import "stdlib/argparse.jou"
import "stdlib/io.jou"
import "stdlib/list.jou"
import "stdlib/process.jou"
import "stdlib/str.jou"

import "./ansi_colors.jou"
import "./state.jou"


def print_help(argv0: byte*) -> None:
    printf("Usage: %s [options] [FILTER FILTER2 FILTER3 ...]\n", argv0)
    printf("\n")
    printf("Options:\n")
    printf("  -v / --verbose        show more output than by default\n")
    printf("  --no-colors           do not print with colors\n")
    printf("  --lf / --last-failed  only run tests that failed or were not present in the\n")
    printf("                        previous test run (useful in large projects)\n")
    printf("\n")
    printf("If FILTER arguments are given, only run the tests whose file path contains one\n")
    printf("or more FILTERs as a substring.\n")


@public
def step1_parse_command_line_args(argc: int, argv: byte**) -> CommandLineArgs:
    args = CommandLineArgs{}

    parser = ArgumentParser{argv = argv}
    while parser.next():
        match parser.flag with strcmp:
            case "--help":
                print_help(argv[0])
                exit(0)
            case "-v" | "--verbose":
                args.verbose = True
            case "--no-colors":
                disable_colors()
            case "--lf" | "--last-failed":
                args.last_failed = True
            case "":
                args.filter_strings.append(parser.take_value())
            case _:
                fprintf(get_stderr(), "%s: unknown argument \"%s\" (try --help)\n", argv[0], parser.flag)
                exit(2)

        if parser.pending_value != NULL:
            fprintf(get_stderr(), "%s: flag \"%s\" does not take a value (try --help)\n", argv[0], parser.flag)
            exit(2)

    return args
