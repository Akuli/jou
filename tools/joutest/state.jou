import "stdlib/list.jou"
import "stdlib/str.jou"
import "stdlib/assert.jou"
import "stdlib/toml.jou"


# Advantage: easy to format error messages and other temporary things
# Disadvantage: easy to get overlapping snprintf() if two functions use this and call each other
@public
global big_buffer: byte[1_000_000]


# If you make this bigger, note that on Windows, WaitForMultipleObjects() can't
# can't take more than 64 handles at once (MAXIMUM_WAIT_OBJECTS = 64), and we
# pass two handles for every test that reads output.
@public
const MAX_PARALLELISM: int = 32

@public
class CommandLineArgs:
    verbose: bool
    filter_strings: List[byte*]  # Only tests with one or more of these as substring are executed
    last_failed: bool
    parallelism: int  # -j1, -j2 etc
    jou_command: List[byte*]
    skip_if_contains: List[byte*]


@public
enum CaptureMode:
    CompareToComments   # (default) expected output comes from comments like "# Output: hello"
    DoNotCapture        # do nothing with the output, let it go to console
    Discard             # send the output to the null device

@public
enum SkipMode:
    DontSkip
    SkipNormally
    SkipSilently

@public
enum SimpleResult:
    Success
    Failed

@public
class Test:
    # These are set in step 3 (discover tests)
    path: byte*
    configs: List[TOML*]  # last in the list is the most important
    code_in_markdown: byte*     # For markdown files, code in the code block, NULL if not markdown file
    first_markdown_lineno: int  # Line number if markdown file, 0 if not markdown file
    last_markdown_lineno: int   # Line number if markdown file, 0 if not markdown file

    # These are set in step 4 (gather expected output)
    expected_output: byte*

    # These are set in step 5 (configure tests)
    succeeded_before: bool  # with --lf/--last-failed, remember success from several runs ago
    skipped_with_last_failed_flag: bool
    skip: SkipMode
    command_list: List[byte*]
    command_string: byte*
    working_directory: byte*  # NULL means use current directory
    stdout: CaptureMode
    stderr: CaptureMode
    uses_output_capturing: bool
    expected_exit_code: int

    # These are set in step 6 (run tests)
    start_error: int  # If nonzero, the test failed to start: errno on posix, GetLastError() on windows
    terminating_signal: int  # (POSIX only) signal number that killed the test while running
    actual_exit_code: int  # If no start error, and not killed by signal, it exited normally with this status code
    actual_output: byte*
    simple_result: SimpleResult

    # This can't really be a part of some "let's configure everything" step,
    # because this is needed very early, e.g. before a markdown file has been
    # parsed to discover the tests inside it.
    @public
    def get_config(self, key: byte*) -> TOML*:
        assert self.configs.len > 0  # can loop backwards with pointers
        for config = &self.configs.end()[-1]; config >= self.configs.ptr; config--:
            toml = toml_get(*config, key)
            if toml != NULL:
                return toml
        return NULL

    # This is a getter because it must be always available, even before the
    # "configure tests" step that sets up many of the members here.
    #
    # TODO: maybe the "configure tests" step be split into two parts...
    @public
    def get_relative_path(self) -> byte*:
        assert self.configs.len > 0
        if toml_is_true(self.get_config("cd_to_containing_directory")):
            # Take just the file name: "some/workdir/hello.jou" --> "hello.jou"
            p = &self.path[strlen(self.path)]
            while p > self.path and not (p[-1] == '/' or (p[-1] == '\\' and WINDOWS)):
                p--
            return p
        return self.path
