def list_contains_string(list: List[byte*], string: byte*) -> bool:
    for p = list.ptr; p < list.end(); p++:
        if strcmp(*p, string) == 0:
            return True
    return False


def add_tests_from_markdown(out: List[Test]*, template_test: Test*) -> None:
    langs_toml = template_test.get_config("markdown_code_block_languages")
    assert langs_toml != NULL  # specified in builtin_defaults.toml
    assert langs_toml.type == TOMLType.Array  # TODO: error handling
    langs = List[byte*]{}
    for lang_toml = langs_toml.array.ptr; lang_toml < langs_toml.array.end(); lang_toml++:
        lang = toml_to_string(lang_toml)
        assert lang != NULL  # TODO: error handling
        langs.append(lang)

    assert template_test.path != NULL
    f = fopen(template_test.path, "rb")
    if f != NULL:
        lineno = 0
        code_first_lineno = 0  # 0 if not inside a code block
        code = List[byte]{}

        while fgets(big_buffer, sizeof(big_buffer), f) != NULL:
            lineno++

            if starts_with(big_buffer, "```"):
                lang = &big_buffer[3]
                trim_ascii_whitespace(lang)

                if *lang != '\0' and list_contains_string(langs, lang):
                    # Start of code block
                    code_first_lineno = lineno + 1
                    assert code.len == 0

                elif *lang == '\0' and code_first_lineno != 0:
                    # End of code block
                    code.append('\0')

                    # Note: Lists inside the test that already contain something
                    # can no longer be appended to after this point. If you need
                    # to add more stuff later, you probably need to copy the
                    # list properly here.
                    test = *template_test
                    test.first_markdown_lineno = code_first_lineno
                    test.last_markdown_lineno = lineno - 1
                    test.code_in_markdown = strdup(code.ptr)
                    assert test.code_in_markdown != NULL
                    out.append(test)

                    code_first_lineno = 0
                    code.len = 0

                else:
                    # Whatever this is, it cannot occur in the middle of a code block
                    code_first_lineno = 0
                    code.len = 0

            elif code_first_lineno != 0:
                # Line inside a code block
                code.extend_from_ptr(big_buffer, strlen(big_buffer))

        free(code.ptr)

    if f == NULL or ferror(f) != 0:
        assert False  # TODO: error handling
        snprintf(big_buffer, sizeof(big_buffer), "failed to read file '%s': %s", template_test.path, strerror(get_errno()))
        # Find out where the path was first specified, put the error there
        for config = template_test.configs.ptr; config < template_test.configs.end(); config++:
            files_toml = toml_get(*config, "files")
            if files_toml != NULL:
                fail_in_toml(files_toml.lineno, big_buffer)
        assert False

    free(langs.ptr)
    fclose(f)


def is_markdown_file(path: byte*) -> bool:
    # This is documented as being case-insensitive
    return (
        ends_with(path, ".md")
        or ends_with(path, ".mD")
        or ends_with(path, ".Md")
        or ends_with(path, ".MD")
    )


