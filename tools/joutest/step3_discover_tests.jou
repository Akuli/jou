def do_glob_from_toml(glob: byte*, glob_lineno: int, out: List[byte*]*) -> None:
    assert glob_is_valid(glob)  # TODO: error handling

    old_len = out.len
    do_glob(glob, ".", out, 10)  # TODO: don't hard-code depth limit?
    num_new = out.len - old_len
    assert num_new >= 0
    assert num_new != 0  # TODO: error handling
    sort_strings(&out.end()[-num_new], num_new)


@public
def step3_discover_tests(toml: TOML*) -> List[Test]:
    tests = List[Test]{}

    defaults_for_all_tests = toml_get(toml, "defaults_for_all_tests")
    if defaults_for_all_tests != NULL:
        assert defaults_for_all_tests.type == TOMLType.Table  # TODO: error handling
        assert toml_get(defaults_for_all_tests, "files") == NULL    # TODO: error handling

    tests_array = toml_get(toml, "tests")
    assert tests_array != NULL  # TODO: error handling
    assert tests_array.type == TOMLType.Array  # TODO: error handling
    assert tests_array.array.len > 0  # TODO: error handling

    for tests_item = tests_array.array.ptr; tests_item < tests_array.array.end(); tests_item++:
        assert tests_item.type == TOMLType.Table

        files_toml = toml_get(tests_item, "files")
        if files_toml == NULL:
            fail_in_toml(tests_item.lineno, "each 'tests' table must contain 'files'")

        paths = List[byte*]{}
        s = toml_to_string(files_toml)
        if s != NULL:
            do_glob_from_toml(s, files_toml.lineno, &paths)
        else:
            assert files_toml.type == TOMLType.Array  # TODO: error handling
            for files_item = files_toml.array.ptr; files_item < files_toml.array.end(); files_item++:
                s = toml_to_string(files_item)
                assert s != NULL  # TODO: error handling
                do_glob_from_toml(s, files_item.lineno, &paths)

        for p = paths.ptr; p < paths.end(); p++:
            test: Test* = NULL
            for t = tests.ptr; t < tests.end(); t++:
                if strcmp(t.path, *p) == 0:
                    test = t
                    break

            if test == NULL:
                tests.append(Test{path = *p})
                test = &tests.end()[-1]
                test.configs.append(get_builtin_defaults())
                if defaults_for_all_tests != NULL:
                    test.configs.append(defaults_for_all_tests)

            test.configs.append(tests_item)
        free(paths.ptr)

    tests2 = List[Test]{}
    for t = tests.ptr; t < tests.end(); t++:
        if is_markdown_file(t.path):
            add_tests_from_markdown(&tests2, t)
        else:
            tests2.append(*t)

    free(tests.ptr)
    return tests2
