# This is public and available on all platforms, because there's a test that
# imports this.
@public
def command_to_string_windows(command: List[byte*]) -> byte*:
    result = List[byte]{}

    for i = 0; i < command.len; i++:
        if i != 0:
            result.append(' ')
        arg = command.ptr[i]

        quoting = arg[0] == '\0' or strstr(arg, " ") != NULL or strstr(arg, "\t") != NULL
        if quoting:
            result.append('"')

        backslash_count = 0
        for p = arg; *p != '\0'; p++:
            match *p:
                case '\\':
                    result.append('\\')
                    backslash_count++
                case '"':
                    # Put double backslashes before quote
                    for ; backslash_count > 0; backslash_count--:
                        result.append('\\')
                    result.append('\\')
                    result.append('"')
                case _:
                    result.append(*p)
                    backslash_count = 0

        if quoting:
            # Put double backslashes before quote
            for ; backslash_count > 0; backslash_count--:
                result.append('\\')
            result.append('"')

    result.append('\0')
    return result.ptr


if not WINDOWS:
    def command_to_string_posix(command: List[byte*]) -> byte*:
        result = List[byte]{}

        for i = 0; i < command.len; i++:
            if i != 0:
                result.append(' ')
            arg = command.ptr[i]

            # The string below is ASCII characters that are safe to include in
            # commands without quoting, in ASCII order (doesn't really matter).
            #
            # I was unsure about '%' and '^' so I left them out.
            if *arg != '\0' and strspn(arg, "+,-./0123456789:=@ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz") == strlen(arg):
                result.extend_from_ptr(arg, strlen(arg))
            else:
                result.append('\'')
                for ; *arg != '\0'; arg++:
                    if *arg == '\'':
                        result.append('\'')  # End single quotes
                        result.append('"')  # Begin double quotes
                        result.append('\'')  # Put the single quote inside the double quotes
                        result.append('"')  # End double quotes
                        result.append('\'')  # Begin single quotes
                    else:
                        result.append(*arg)
                result.append('\'')

        result.append('\0')
        return result.ptr


def figure_out_which_tests_succeeded_before(tests: List[Test]) -> None:
    f = fopen("jou_compiled/joutest_last_run.json", "rb")
    if f == NULL:
        return

    file_content = List[byte]{}
    while True:
        n = fread(big_buffer, 1, array_count(big_buffer), f)
        if n == 0:
            break
        file_content.extend_from_ptr(big_buffer, n)
    fclose(f)
    file_content.append('\0')

    if (
        not json_is_valid(file_content.ptr)
        or json_to_double(json_get(file_content.ptr, "file_format_version")) != 1
    ):
        free(file_content.ptr)
        return

    # For n tests this is O(n^2), but I don't think it will ever be noticeable
    # as long as the inner loop is fast. That's why outer loop parses JSON.
    for j = json_array_first(json_get(file_content.ptr, "tests")); j != NULL; j = json_array_next(j):
        if not (
            json_equals_string(json_get(j, "result"), "success")
            or (
                # Carry around success from multiple test runs ago
                json_equals_string(json_get(j, "result"), "skipped")
                and json_is_true(json_get(j, "succeeded_before"))
            )
        ):
            continue

        path = json_to_string(json_get(j, "path"))
        if path == NULL:
            # weird...
            continue

        code_in_markdown = json_to_string(json_get(j, "code_in_markdown"))

        for test = tests.ptr; test < tests.end(); test++:
            if (
                strcmp(test.path, path) == 0
                and (
                    (test.code_in_markdown == NULL and code_in_markdown == NULL)
                    or (
                        test.code_in_markdown != NULL
                        and code_in_markdown != NULL
                        and strcmp(test.code_in_markdown, code_in_markdown) == 0
                    )
                )
            ):
                # Consider it a match
                test.succeeded_before = True

        free(path)
        free(code_in_markdown)

    free(file_content.ptr)


# Returns True if source code for the test contains any of given strings
def file_content_has_substring(test: Test*, strings: List[byte*]) -> bool:
    if strings.len == 0:
        return False

    if test.code_in_markdown != NULL:
        for s = strings.ptr; s < strings.end(); s++:
            if strstr(test.code_in_markdown, *s) != NULL:
                return True
        return False

    preserve_amount = 0
    for s = strings.ptr; s < strings.end(); s++:
        n = strlen(*s)
        if n > 0.5*sizeof(big_buffer):
            # just give up, user is trying to troll
            return False
        preserve_amount = max(preserve_amount, n as int)

    f = fopen(test.path, "rb")
    if f != NULL:
        len: intnative = 0
        while True:
            n = fread(&big_buffer[len], 1, sizeof(big_buffer) - len - 1, f)
            if n == 0:
                if ferror(f) != 0:
                    break  # go to error handling below
                fclose(f)
                return False
            # A bit of a hack, but works well enough: get rid of '\0' bytes
            # in file content
            for i = len; i < len + n; i++:
                if big_buffer[i] == '\0':
                    big_buffer[i] = 255 as byte
            len += n

            assert len < sizeof(big_buffer)
            big_buffer[len] = '\0'

            for s = strings.ptr; s < strings.end(); s++:
                if strstr(big_buffer, *s) != NULL:
                    fclose(f)
                    return True

            # Preserve some of the data in big_buffer to avoid missing a
            # substring on the boundary between big_buffer sized chunks.
            if len > preserve_amount:
                memmove(big_buffer, &big_buffer[len - preserve_amount], preserve_amount + 1)
                len = preserve_amount
                assert big_buffer[len] == '\0'  # this is the +1 above

    e = get_errno()
    snprintf(big_buffer, sizeof(big_buffer), "reading \"%s\" failed", test.path)
    fail_with_errno(big_buffer, e)


def get_skip_mode_from_config(test: Test*, key: byte*) -> SkipMode:
    toml = test.get_config(key)
    assert toml != NULL  # specified in builtin_defaults.toml

    string = toml_to_string(toml)
    assert string != NULL  # TODO: error handling

    match string with strcmp:
        case "dont_skip":
            return SkipMode.DontSkip
        case "skip_normally":
            return SkipMode.SkipNormally
        case "skip_silently":
            return SkipMode.SkipSilently
        case _:
            puts(string)
            assert False  # TODO: error handling

def assign_skip(dest: SkipMode*, value: SkipMode) -> bool:
    # The "highest" skip mode wins (no skip specified < normal skip < silent skip)
    if (value as int) > (*dest as int):
        *dest = value
        return True
    return False

def configure_skip(test: Test*, args: CommandLineArgs*) -> None:
    assert test.skip == SkipMode.DontSkip
    assert test.skip as int == 0

    if args.filter_strings.len > 0:
        matches_some_filter = False
        for f = args.filter_strings.ptr; f < args.filter_strings.end(); f++:
            if strstr(test.path, *f) != NULL:
                matches_some_filter = True
                break
        if not matches_some_filter:
            assign_skip(&test.skip, SkipMode.SkipSilently)

    if file_content_has_substring(test, args.skip_if_contains):
        # should this be normal skip or silent skip?
        # I don't know. Let's be explicit for now, unless that causes problems.
        assign_skip(&test.skip, SkipMode.SkipNormally)

    assign_skip(&test.skip, get_skip_mode_from_config(test, "skip_mode"))

    # do this every time, so that errors are detected even if there is expected output
    # TODO: is there a test that ensures this behavior?
    mode = get_skip_mode_from_config(test, "skip_mode_if_no_expected_output")
    if *test.expected_output == '\0':
        assign_skip(&test.skip, mode)

    if test.succeeded_before:
        test.skipped_with_last_failed_flag = assign_skip(&test.skip, SkipMode.SkipNormally)


declare dirname(path: byte*) -> byte*

def configure_working_directory(test: Test*) -> None:
    assert test.working_directory == NULL

    cd = test.get_config("cd_to_containing_directory")
    assert cd != NULL  # specified in builtin_defaults.toml

    assert cd.type == TOMLType.Boolean  # TODO: error handling
    if cd.boolean:
        temp = strdup(test.path)
        assert temp != NULL
        test.working_directory = strdup(dirname(temp))  # may modify temp string
        free(temp)


def configure_command(test: Test*, args: CommandLineArgs*) -> None:
    toml = test.get_config("command")
    if toml == NULL:
        test.command_list.extend(args.jou_command)
        if test.code_in_markdown != NULL:
            test.command_list.append("--lines={lines}")
        test.command_list.append("{file}")
    else:
        if toml.type != TOMLType.Array:
            fail_in_toml(toml.lineno, "'command' must be an array of strings")
        for item = toml.array.ptr; item < toml.array.end(); item++:
            s = toml_to_string(item)
            if s == NULL:
                fail_in_toml(item.lineno, "'command' must be an array of strings")
            test.command_list.append(s)

    params: byte*[enum_count(FormatParam)]
    memset(params, 0, sizeof(params))
    params[FormatParam.File as int] = test.get_relative_path()

    lines_string: byte[100] = ""
    if test.first_markdown_lineno != 0 and test.last_markdown_lineno != 0:
        sprintf(lines_string, "%d-%d", test.first_markdown_lineno, test.last_markdown_lineno)
    params[FormatParam.Lines as int] = lines_string

    for arg = test.command_list.ptr; arg < test.command_list.end(); arg++:
        *arg = format_string(*arg, params)

    assert test.command_string == NULL
    if WINDOWS:
        test.command_string = command_to_string_windows(test.command_list)
    else:
        test.command_string = command_to_string_posix(test.command_list)


def get_capture_mode_from_config(test: Test*, key: byte*) -> CaptureMode:
    toml = test.get_config(key)
    assert toml != NULL  # specified in builtin_defaults.toml

    string = toml_to_string(toml)
    if string != NULL:
        match string with strcmp:
            case "compare_to_comments":
                return CaptureMode.CompareToComments
            case "do_not_capture":
                return CaptureMode.DoNotCapture
            case "discard":
                return CaptureMode.Discard

    snprintf(big_buffer, sizeof(big_buffer), "'%s' must be \"compare_to_comments\", \"do_not_capture\" or \"discard\"", key)
    fail_in_toml(toml.lineno, big_buffer)

def configure_output_streams(test: Test*) -> None:
    test.stdout = get_capture_mode_from_config(test, "stdout")
    test.stderr = get_capture_mode_from_config(test, "stderr")
    test.uses_output_capturing = (test.stdout == CaptureMode.CompareToComments or test.stderr == CaptureMode.CompareToComments)


def configure_exit_code(test: Test*) -> None:
    toml = test.get_config("expected_exit_code")
    assert toml != NULL  # specified in builtin_defaults.toml

    s = toml_to_string(toml)
    if s != NULL and strcmp(s, "any") == 0:
        test.expected_exit_code = -1
    else:
        test.expected_exit_code = toml_to_int(toml, -1)
        if test.expected_exit_code < 0 or test.expected_exit_code > 255:
            # TODO: windows allows exit codes beyond 0-255
            fail_in_toml(toml.lineno, "'expected_exit_code' must be an integer between 0 and 255")


@public
def step5_configure_tests(tests: List[Test], args: CommandLineArgs*) -> None:
    if args.last_failed:
        figure_out_which_tests_succeeded_before(tests)

    for test = tests.ptr; test < tests.end(); test++:
        configure_skip(test, args)
        if test.skip == SkipMode.SkipSilently:
            continue
        configure_working_directory(test)
        configure_command(test, args)
        configure_output_streams(test)
        configure_exit_code(test)
