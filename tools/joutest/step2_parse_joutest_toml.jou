import "stdlib/assert.jou"
import "stdlib/errno.jou"
import "stdlib/io.jou"
import "stdlib/list.jou"
import "stdlib/str.jou"
import "stdlib/toml.jou"

import "./builtin_defaults.jou"
import "./fail.jou"
import "./state.jou"


def condition_is_true(toml: TOML*) -> bool:
    condition = toml_to_string(toml)
    if condition == NULL:
        fail_in_toml(toml.lineno, "'if' condition must be a string")

    match condition with strcmp:
        case "WINDOWS":
            return WINDOWS
        case "MACOS":
            return MACOS
        case "LINUX":
            return LINUX
        case "NETBSD":
            return NETBSD
        case "IS_32BIT":
            return IS_32BIT
        case "ARM_CPU":
            return ARM_CPU
        case "X86_CPU":
            return X86_CPU
        case _:
            snprintf(big_buffer, sizeof(big_buffer), "unsupported 'if' condition: %s", condition)
            fail_in_toml(toml.lineno, big_buffer)

def eliminate_if_then_else_tables(toml: TOML*, depth: int) -> None:
    while True:
        assert toml.depth >= depth  # may become more shallow when doing this
        toml.depth = depth

        match toml.type:
            case TOMLType.Error:
                assert False  # should never happen
            case TOMLType.Table:
                condition = toml_get(toml, "if")
                if condition != NULL:
                    then_value = toml_get(toml, "then")
                    else_value = toml_get(toml, "else")
                    if then_value == NULL or else_value == NULL:
                        fail_in_toml(toml.lineno, "if/then/else tables must contain 'if', 'then' and 'else'")

                    for kv = toml.table.ptr; kv < toml.table.end(); kv++:
                        if (
                            strcmp(kv.key, "if") != 0
                            and strcmp(kv.key, "then") != 0
                            and strcmp(kv.key, "else") != 0
                        ):
                            snprintf(big_buffer, sizeof(big_buffer), "unknown setting '%s' in an if/then/else table", kv.key)
                            fail_in_toml(kv.value.lineno, big_buffer)

                    if condition_is_true(condition):
                        new_value = then_value
                    else:
                        new_value = else_value

                    temp = *new_value
                    *new_value = TOML{type = TOMLType.Error}  # avoid freeing the value
                    toml.free()
                    *toml = temp
                    continue  # Repeat to handle nested `if` tables

                # Normal table
                for kv = toml.table.ptr; kv < toml.table.end(); kv++:
                    eliminate_if_then_else_tables(&kv.value, depth + 1)
                return

            case TOMLType.Array:
                for p = toml.array.ptr; p < toml.array.end(); p++:
                    eliminate_if_then_else_tables(p, depth + 1)
                return
            case TOMLType.String | TOMLType.Boolean | TOMLType.Integer | TOMLType.Floating:
                return


def read_joutest_toml_and_parse_to_toml_object() -> TOML:
    f = fopen("joutest.toml", "rb")
    if f == NULL:
        fail_with_errno("cannot open joutest.toml", get_errno())

    n = fread(big_buffer, 1, sizeof(big_buffer), f)
    if ferror(f) != 0:
        fail_with_errno("reading joutest.toml failed", get_errno())

    fclose(f)

    if n == sizeof(big_buffer):
        fail("joutest.toml is very large, something is probably wrong with it")

    assert n < sizeof(big_buffer)
    big_buffer[n] = '\0'
    if strlen(big_buffer) != n:
        fail("joutest.toml contains a zero byte")

    toml = parse_toml(big_buffer)
    if toml.type == TOMLType.Error:
        fail_with_toml_syntax_error(toml.lineno, toml.error_message)

    return toml


def check_test_config(table: List[TOMLKeyVal]) -> None:
    for kv = table.ptr; kv < table.end(); kv++:
        # We only check for non-existing options here. Each option is checked
        # later properly whenever it's used. This way we don't have much
        # separate checking and using code far apart, which could cause bugs.
        if (
            strcmp(kv.key, "files") != 0
            and strcmp(kv.key, "command") != 0
            and toml_get(get_builtin_defaults(), kv.key) == NULL
        ):
            snprintf(big_buffer, sizeof(big_buffer), "unknown setting '%s' for a test", kv.key)
            fail_in_toml(kv.value.lineno, big_buffer)

def check_tests_array(toml: TOML*) -> None:
    if toml.type != TOMLType.Array:
        fail_in_toml(toml.lineno, "'tests' must be an array")
    if toml.array.len == 0:
        fail_in_toml(toml.lineno, "the 'tests' array cannot be empty")

    for item = toml.array.ptr; item < toml.array.end(); item++:
        if item.type != TOMLType.Table:
            fail_in_toml(toml.lineno, "each item of 'tests' must be a table")
        check_test_config(item.table)
        if toml_get(item, "files") == NULL:
            fail_in_toml(toml.lineno, "each 'tests' table must contain 'files'")

def check_the_whole_toml_file(toml: TOML*) -> None:
    assert toml.type == TOMLType.Table
    for kv = toml.table.ptr; kv < toml.table.end(); kv++:
        match kv.key with strcmp:
            case "tests":
                check_tests_array(&kv.value)
            case "defaults_for_all_tests":
                if kv.value.type != TOMLType.Table:
                    fail_in_toml(toml.lineno, "'defaults_for_all_tests' must be a table")
                check_test_config(kv.value.table)

                files = toml_get(&kv.value, "files")
                if files != NULL:
                    fail_in_toml(files.lineno, "you cannot specify 'files' inside defaults_for_all_tests")
            case _:
                snprintf(big_buffer, sizeof(big_buffer), "unknown setting '%s'", kv.key)
                fail_in_toml(kv.value.lineno, big_buffer)

    if toml_get(toml, "tests") == NULL:
        fail("joutest.toml must define an array named 'tests'")


@public
def step2_parse_joutest_toml() -> TOML:
    toml = read_joutest_toml_and_parse_to_toml_object()
    eliminate_if_then_else_tables(&toml, 0)
    check_the_whole_toml_file(&toml)
    return toml
