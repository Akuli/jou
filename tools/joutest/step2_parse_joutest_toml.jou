import "stdlib/mem.jou"
import "stdlib/assert.jou"
import "stdlib/errno.jou"
import "stdlib/io.jou"
import "stdlib/list.jou"
import "stdlib/str.jou"
import "stdlib/toml.jou"

import "./fail.jou"
import "./glob.jou"
import "./string_formatter.jou"
import "./state.jou"


enum Condition:
    Windows
    MacOS
    Linux
    Is32Bit
    Default

global CONDITION_STRINGS: byte*[enum_count(Condition)] = [
    "windows",
    "macos",
    "linux",
    "32bit",
    "default",
]

def condition_is_true(c: Condition) -> bool:
    match c:
        case Condition.Windows:
            return WINDOWS
        case Condition.MacOS:
            return MACOS
        case Condition.Linux:
            return LINUX
        case Condition.Is32Bit:
            return IS_32BIT
        case Condition.Default:
            return True

def eliminate_condition_tables(location: Location, toml: TOML*, depth: int) -> None:
    error: byte[300]

    while True:
        assert toml.depth >= depth  # may become more shallow when doing this
        toml.depth = depth

        match toml.type:
            case TOMLType.Error:
                assert False  # should never happen
            case TOMLType.Table:
                # TODO: This is probably not the best way to detect condition tables.
                #       Or is it? It's simple and easy to document.
                default = toml_get(toml, "default")
                if default == NULL:
                    # Normal table
                    for kv = toml.table.ptr; kv < toml.table.end(); kv++:
                        eliminate_condition_tables(location, &kv.value, depth + 1)
                    return

                # Condition table, pick the correct value
                chosen: TOMLKeyVal* = NULL
                for kv = toml.table.ptr; kv < toml.table.end(); kv++:
                    cond_index = -1
                    for i = 0; i < enum_count(Condition); i++:
                        if strcmp(CONDITION_STRINGS[i], kv.key) == 0:
                            cond_index = i
                            break
                    if cond_index == -1:
                        snprintf(error, sizeof(error), "unknown condition '%s'", kv.key)
                        location.lineno = kv.value.lineno
                        fail(location, error)
                    cond = cond_index as Condition
                    if cond != Condition.Default and condition_is_true(cond):
                        if chosen != NULL:
                            # TODO: test this?
                            snprintf(error, sizeof(error), "conditions '%s' and '%s' are both true", chosen.key, kv.key)
                            location.lineno = kv.value.lineno
                            fail(location, error)
                        chosen = kv

                if chosen == NULL:
                    new_value = default
                else:
                    new_value = &chosen.value
                assert new_value != NULL

                temp = *new_value
                *new_value = TOML{type = TOMLType.Error}  # avoid freeing the value
                toml.free()
                *toml = temp
                continue  # Repeat in case it's a nested condition table

            case TOMLType.Array:
                for p = toml.array.ptr; p < toml.array.end(); p++:
                    eliminate_condition_tables(location, p, depth + 1)
                return
            case TOMLType.String | TOMLType.Boolean | TOMLType.Integer | TOMLType.Floating:
                return


global big_buffer: byte[1_000_000]


def parse_toml_from_file_object(f: FILE*, location: Location) -> TOML:
    message: byte[1000]

    # TODO: file name hard coded in many places
    n = fread(big_buffer, 1, sizeof(big_buffer), f)
    if ferror(f) != 0:
        fail_with_errno(location, "reading file failed", get_errno())

    fclose(f)

    if n == sizeof(big_buffer):
        fail(location, "file is very large, something is probably wrong with it")

    assert n < sizeof(big_buffer)
    big_buffer[n] = '\0'
    if strlen(big_buffer) != n:
        fail(location, "file contains a zero byte")

    toml = parse_toml(big_buffer)
    if toml.type == TOMLType.Error:
        fail_with_toml_syntax_error(Location{path = location.path, lineno = toml.lineno}, toml.error_message)

    eliminate_condition_tables(location, &toml, 0)
    return toml


def array_of_strings_from_toml(location: Location, kv: TOMLKeyVal*, error: byte*, duplicates_are_banned: bool) -> List[byte*]:
    default_error: byte[200]
    if error == NULL:
        snprintf(default_error, sizeof(default_error), "'%s' must be an array of strings", kv.key)
        error = default_error

    if kv.value.type != TOMLType.Array:
        location.lineno = kv.value.lineno
        fail(location, error)

    result = List[byte*]{}
    for item = kv.value.array.ptr; item < kv.value.array.end(); item++:
        s = toml_to_string(item)
        if s == NULL:
            location.lineno = item.lineno
            fail(location, error)

        if duplicates_are_banned:
            for old = result.ptr; old < result.end(); old++:
                if strcmp(*old, s) == 0:
                    duplicate_error: byte[200]
                    snprintf(duplicate_error, sizeof(duplicate_error), "'%s' is repeated in '%s'", s, kv.key)
                    location.lineno = item.lineno
                    fail(location, duplicate_error)

        result.append(s)

    return result


def table_with_string_values_from_toml(location: Location, kv: TOMLKeyVal*) -> List[byte*[2]]:
    error: byte[200]
    snprintf(error, sizeof(error), "'%s' must be a table with string keys and string values", kv.key)

    if kv.value.type != TOMLType.Table:
        fail(Location{path = location.path, lineno = kv.value.lineno}, error)

    result = List[byte*[2]]{}
    for inner_kv = kv.value.table.ptr; inner_kv < kv.value.table.end(); inner_kv++:
        if toml_to_string(&inner_kv.value) == NULL:
            fail(Location{path = location.path, lineno = inner_kv.value.lineno}, error)
        result.append([inner_kv.key, toml_to_string(&inner_kv.value)])

    return result


def enum_from_toml(location: Location, kv: TOMLKeyVal*, strings: byte**, nstrings: int) -> int:
    # Sanity checks, so that creating the error message below is simpler
    # This ensures that the strings themselves take up less than 1.1kB.
    assert strlen(kv.key) < 100
    assert nstrings > 0
    assert nstrings <= 10
    for i = 0; i < nstrings; i++:
        assert strlen(strings[i]) < 100

    s = toml_to_string(&kv.value)
    if s != NULL:
        for i = 0; i < nstrings; i++:
            if strcmp(s, strings[i]) == 0:
                return i

    error: byte[2000]  # surely big enough, see above
    sprintf(error, "'%s' must be \"%s\"", kv.key, strings[0])
    for i = 1; i < nstrings; i++:
        if i == nstrings - 1:
            sprintf(&error[strlen(error)], " or \"%s\"", strings[i])
        else:
            sprintf(&error[strlen(error)], ", \"%s\"", strings[i])
    location.lineno = kv.value.lineno
    fail(location, error)


def option_to_config(location: Location, opt: TestConfigOption, kv: TOMLKeyVal*, config: TestConfig*) -> None:
    allowed: bool[enum_count(FormatParam)]
    error: byte[500]  # surely big enough, see above

    match opt:
        case TestConfigOption.Files:
            s = toml_to_string(&kv.value)
            if s == NULL:
                free(config.files.ptr)
                config.files = array_of_strings_from_toml(location, kv, "'files' must be a path, a glob pattern such as \"tests/*.jou\", or an array of paths and/or glob patterns", False)
                config.files_locations.len = 0
                for item = kv.value.array.ptr; item < kv.value.array.end(); item++:
                    config.files_locations.append(Location{path = location.path, lineno = item.lineno})
            else:
                config.files.len = 0
                config.files.append(s)
                config.files_locations.len = 0
                config.files_locations.append(Location{path = location.path, lineno = kv.value.lineno})

            assert config.files.len == config.files_locations.len
            for i = 0; i < config.files.len; i++:
                glob = config.files.ptr[i]
                glob_location = config.files_locations.ptr[i]
                if strstr(glob, "\\") != NULL:
                    fail(glob_location, "please use forward slashes instead of backslashes")
                if not glob_is_valid(glob):
                    snprintf(error, sizeof(error), "invalid path or glob pattern: %s", glob)
                    fail(glob_location, error)

        case TestConfigOption.Stdout:
            config.stdout = enum_from_toml(location, kv, CAPTURE_MODE_NAMES, enum_count(CaptureMode)) as CaptureMode

        case TestConfigOption.Stderr:
            config.stdout = enum_from_toml(location, kv, CAPTURE_MODE_NAMES, enum_count(CaptureMode)) as CaptureMode

        case TestConfigOption.OutputCommentRules:
            free(config.output_comment_rules.ptr)
            config.output_comment_rules = table_with_string_values_from_toml(location, kv)

            assert kv.value.type == TOMLType.Table
            for inner_kv = kv.value.table.ptr; inner_kv < kv.value.table.end(); inner_kv++:
                if strstr(inner_kv.key, ":") != NULL or strstr(inner_kv.key, "#") != NULL:
                    location.lineno = inner_kv.value.lineno
                    fail(location, "keys of 'output_comment_rules' cannot contain '#' or ':' characters")

                s = toml_to_string(&inner_kv.value)
                assert s != NULL

                memset(allowed, 0, sizeof(allowed))
                allowed[FormatParam.File as int] = True
                allowed[FormatParam.Line as int] = True
                allowed[FormatParam.Comment as int] = True
                validate_format_string_in_toml(s, Location{path = location.path, lineno = inner_kv.value.lineno}, allowed)

        case TestConfigOption.OutputCommentOrder:
            free(config.output_comment_order.ptr)
            config.output_comment_order = array_of_strings_from_toml(location, kv, NULL, True)

        case TestConfigOption.SkipMode:
            config.skip_mode = enum_from_toml(location, kv, SKIP_MODE_NAMES, enum_count(SkipMode)) as SkipMode

        case TestConfigOption.SkipModeIfNoExpectedOutput:
            config.skip_mode_if_no_expected_output = enum_from_toml(location, kv, SKIP_MODE_NAMES, enum_count(SkipMode)) as SkipMode

        case TestConfigOption.Command:
            free(config.command.ptr)
            config.command = array_of_strings_from_toml(location, kv, NULL, False)

            if config.command.len == 0:
                snprintf(error, sizeof(error), "'%s' cannot be empty", kv.key)
                fail(Location{path = location.path, lineno = kv.value.lineno}, error)

            assert kv.value.type == TOMLType.Array
            for item = kv.value.array.ptr; item < kv.value.array.end(); item++:
                arg = toml_to_string(item)
                assert arg != NULL
                memset(allowed, 0, sizeof(allowed))
                allowed[FormatParam.File as int] = True
                validate_format_string_in_toml(arg, Location{path = location.path, lineno = item.lineno}, allowed)

        case TestConfigOption.CdToContainingDirectory:
            if toml_is_true(&kv.value):
                config.cd_to_containing_directory = True
            elif toml_is_false(&kv.value):
                config.cd_to_containing_directory = False
            else:
                fail(Location{path = location.path, lineno = kv.value.lineno}, "'cd_to_containing_directory' must be a boolean")

        case TestConfigOption.ExpectedExitCode:
            config.expected_exit_code = toml_to_int(&kv.value, -1)
            if config.expected_exit_code < 0 or config.expected_exit_code > 255:
                fail(Location{path = location.path, lineno = kv.value.lineno}, "'expected_exit_code' must be an integer between 0 and 255")

        case TestConfigOption.MarkdownCodeBlockLanguages:
            free(config.markdown_code_block_languages.ptr)
            config.markdown_code_block_languages = array_of_strings_from_toml(location, kv, NULL, False)


def toml_to_config(location: Location, toml: TOML*, this_is_the_defaults_for_all_tests: bool) -> TestConfig:
    assert toml != NULL
    location.lineno = toml.lineno

    if toml.type != TOMLType.Table:
        if this_is_the_defaults_for_all_tests:
            fail(location, "'defaults_for_all_tests' must be a table")
        else:
            fail(location, "each item of 'tests' must be a table")

    config = TestConfig{location = location}
    error: byte[500]

    for kv = toml.table.ptr; kv < toml.table.end(); kv++:
        kv_location = Location{path = location.path, lineno = kv.value.lineno}

        opt = 0 as TestConfigOption
        found = False
        for i = 0; i < enum_count(TestConfigOption); i++:
            if strcmp(kv.key, TEST_CONFIG_OPTION_NAMES[i]) == 0:
                opt = i as TestConfigOption
                found = True
                break

        if not found:
            snprintf(error, sizeof(error), "unknown setting '%s' for a test", kv.key)
            fail(kv_location, error)

        if this_is_the_defaults_for_all_tests and opt == TestConfigOption.Files:
            fail(kv_location, "you cannot specify 'files' inside defaults_for_all_tests")

        assert not config.value_present[opt as int]
        option_to_config(location, opt, kv, &config)
        config.value_present[opt as int] = True
        config.value_locations[opt as int] = kv_location

    return config


def parse_tests_array(location: Location, toml: TOML*) -> List[TestConfig]:
    result = List[TestConfig]{}

    if toml != NULL:
        location.lineno = toml.lineno
        if toml.type != TOMLType.Array:
            fail(location, "'tests' must be an array")
        if toml.array.len == 0:
            fail(location, "the 'tests' array cannot be empty")
        for p = toml.array.ptr; p < toml.array.end(); p++:
            result.append(toml_to_config(location, p, False))

    return result


@public
def step2_parse_joutest_toml() -> ParsedJoutestToml:
    location = Location{path = "joutest.toml"}
    f = fopen("joutest.toml", "rb")

    if f == NULL:
        # TODO: make just one big buffer in the whole program, use it more like this
        snprintf(big_buffer, sizeof(big_buffer), "cannot open file: %s", strerror(get_errno()))
        fail(location, big_buffer)
    toml = parse_toml_from_file_object(f, location)

    tests_toml: TOML* = NULL
    defaults_for_all_tests = TestConfig{}

    assert toml.type == TOMLType.Table
    for kv = toml.table.ptr; kv < toml.table.end(); kv++:
        match kv.key with strcmp:
            case "tests":
                tests_toml = &kv.value
            case "defaults_for_all_tests":
                defaults_for_all_tests = toml_to_config(location, &kv.value, True)
            case _:
                error: byte[200]
                snprintf(error, sizeof(error), "unknown setting '%s'", kv.key)
                location.lineno = kv.value.lineno
                fail(location, error)

    if tests_toml == NULL:
        fail(location, "there must be an array named 'tests'")

    return ParsedJoutestToml{
        tests = parse_tests_array(location, tests_toml),
        defaults_for_all_tests = defaults_for_all_tests,
    }
