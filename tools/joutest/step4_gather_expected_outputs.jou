import "./state.jou"


def get_output_comment_rules(test: Test*) -> List[TOMLKeyVal]:
    toml = test.get_config("output_comment_rules")
    assert toml != NULL  # specified in builtin_defaults.toml

    assert toml.type == TOMLType.Table  # TODO: error handling
    for kv = toml.table.ptr; kv < toml.table.end(); kv++:
        assert toml_to_string(&kv.value) != NULL  # TODO: error handling
    return toml.table


def order_matches_rules(order: List[byte*], rules: List[TOMLKeyVal]) -> bool:
    # Check that they contain the same strings in some order
    if order.len != rules.len:
        return False
    for ord = order.ptr; ord < order.end(); ord++:
        # TODO: do the tests notice that there is a bug? (duplicate in order)
        found = False
        for r = rules.ptr; r < rules.end(); r++:
            if strcmp(*ord, r.key) == 0:
                found = True
                break
        if not found:
            return False
    return True

def get_output_comment_order(test: Test*, rules: List[TOMLKeyVal]) -> List[byte*]:
    toml = test.get_config("output_comment_order")
    assert toml != NULL  # specified in builtin_defaults.toml

    order = List[byte*]{}
    assert toml.type == TOMLType.Array  # TODO: error handling
    for s_toml = toml.array.ptr; s_toml < toml.array.end(); s_toml++:
        s = toml_to_string(s_toml)
        assert s != NULL  # TODO: error handling
        order.append(s)
    if order.len != 0 and not order_matches_rules(order, rules):
        assert False  # TODO: error handling
    return order


class Comment:
    key: byte*   # e.g. "Output"
    formatted_text: byte*  # without the trailing '\n', owned string
    sort_key: int64


# Examples:
#   "# Output: whatever\n", "Output" --> "whatever\n"
#   "# Lolwat: whatever\n", "Output" --> NULL
def skip_start_of_comment(p: byte*, key: byte*) -> byte*:
    if *p++ != '#':
        return NULL
    if *p++ != ' ':
        return NULL
    while *key != '\0':
        if *p++ != *key++:
            return NULL
    if *p++ != ':':
        return NULL

    match *p:
        case ' ':
            # skip space so "# Output: foo\n" becomes "foo\n"
            return &p[1]
        case '\0':
            # treat "# Output:" as blank line
            return p
        case _:
            return NULL

def parse_comment_from_line(test: Test*, rules: List[TOMLKeyVal], lineno: int, line: byte*) -> Comment:
    for p = &line[strlen(line)]; p >= &line[0]; p--:
        for r = rules.ptr; r < rules.end(); r++:
            comment_text = skip_start_of_comment(p, r.key)
            if comment_text != NULL:
                template = toml_to_string(&r.value)
                assert template != NULL

                lineno_str: byte[100]
                sprintf(lineno_str, "%d", lineno)
                params: byte*[enum_count(FormatParam)]
                memset(params, 0, sizeof(params))
                params[FormatParam.File as int] = test.get_relative_path()
                params[FormatParam.Line as int] = lineno_str
                params[FormatParam.Comment as int] = comment_text

                return Comment{
                    key = r.key,
                    formatted_text = format_string(template, params),
                }

    return Comment{}

def parse_comments(test: Test*, rules: List[TOMLKeyVal]) -> List[Comment]:
    comments = List[Comment]{}

    if test.code_in_markdown == NULL:
        f = fopen(test.path, "rb")
        if f == NULL:
            e = get_errno()
            snprintf(big_buffer, sizeof(big_buffer), "reading expected output from '%s' failed", test.path)
            fail_with_errno(big_buffer, e)

        lineno = 1
        while fgets(big_buffer, sizeof(big_buffer), f) != NULL:
            big_buffer[strcspn(big_buffer, "\r\n")] = '\0'

            c = parse_comment_from_line(test, rules, lineno++, big_buffer)
            if c.key != NULL:
                comments.append(c)

        fclose(f)

    else:
        p = test.code_in_markdown
        lineno = test.first_markdown_lineno

        while *p != '\0':
            line_len = llmin(strcspn(p, "\r\n"), sizeof(big_buffer) - 1) as intnative
            memcpy(big_buffer, p, line_len)
            big_buffer[line_len] = '\0'

            c = parse_comment_from_line(test, rules, lineno++, big_buffer)
            if c.key != NULL:
                comments.append(c)

            p = &p[line_len]
            if *p == '\r':
                p++
            if *p == '\n':
                p++

    return comments


def compare_comments(a: Comment*, b: Comment*) -> int:
    assert a.sort_key != b.sort_key
    return 1 if a.sort_key > b.sort_key else -1

def sort_comments(comments: List[Comment], order: List[byte*]) -> None:
    if order.len == 0:
        return

    for comment_index = 0; comment_index < comments.len; comment_index++:
        c = &comments.ptr[comment_index]

        # Sort by index of the comment's key in the configured order
        c.sort_key = -1
        for i = 0; i < order.len; i++:
            if strcmp(order.ptr[i], c.key) == 0:
                c.sort_key = i
                break
        assert c.sort_key != -1

        # Original index as tie breaker
        c.sort_key <<= 32
        c.sort_key |= comment_index

    Sorter[Comment]{}.sort(comments.ptr, comments.len, compare_comments)


def join_comments_to_string(comments: List[Comment]) -> byte*:
    result = List[byte]{}
    for c = comments.ptr; c < comments.end(); c++:
        result.extend_from_ptr(c.formatted_text, strlen(c.formatted_text))
        result.append('\n')

    result.append('\0')
    return result.ptr


@public
def step4_gather_expected_outputs(tests: List[Test]) -> None:
    for test = tests.ptr; test < tests.end(); test++:
        rules = get_output_comment_rules(test)
        order = get_output_comment_order(test, rules)

        comments = parse_comments(test, rules)
        sort_comments(comments, order)
        test.expected_output = join_comments_to_string(comments)

        while comments.len > 0:
            free(comments.pop().formatted_text)
        free(comments.ptr)
