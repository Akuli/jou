import "stdlib/assert.jou"
import "stdlib/errno.jou"
import "stdlib/io.jou"
import "stdlib/list.jou"
import "stdlib/str.jou"
import "stdlib/mem.jou"
import "stdlib/math.jou"
import "stdlib/intnative.jou"
import "stdlib/sort.jou"

import "./fail.jou"
import "./string_formatter.jou"
import "./state.jou"


# Examples:
#   "# Output: whatever\n", "Output" --> "whatever\n"
#   "# Lolwat: whatever\n", "Output" --> NULL
def skip_start_of_comment(p: byte*, key: byte*) -> byte*:
    if *p++ != '#':
        return NULL
    if *p++ != ' ':
        return NULL
    while *key != '\0':
        if *p++ != *key++:
            return NULL
    if *p++ != ':':
        return NULL

    match *p:
        case ' ':
            # skip space so "# Output: foo\n" becomes "foo\n"
            return &p[1]
        case '\0':
            # treat "# Output:" as blank line
            return p
        case _:
            return NULL


class Comment:
    key: byte*   # e.g. "Output"
    formatted_text: byte*  # without the trailing '\n', owned string
    sort_key: int


def parse_comment_from_line(test: Test*, lineno: int, line: byte*) -> Comment:
    for p = &line[strlen(line)]; p >= &line[0]; p--:
        for pair = test.config.output_comment_rules.ptr; pair < test.config.output_comment_rules.end(); pair++:
            key = (*pair)[0]
            template = (*pair)[1]

            comment_text = skip_start_of_comment(p, key)
            if comment_text != NULL:
                lineno_str: byte[100]
                sprintf(lineno_str, "%d", lineno)

                params: byte*[enum_count(FormatParam)]
                memset(params, 0, sizeof(params))
                params[FormatParam.File as int] = test.get_relative_path()
                params[FormatParam.Line as int] = lineno_str
                params[FormatParam.Comment as int] = comment_text

                return Comment{
                    key = key,
                    formatted_text = format_string(template, params),
                }

    return Comment{}


global big_buffer: byte[1_000_000]  # surely big enough to fit entire lines!


def parse_comments(test: Test*) -> List[Comment]:
    comments = List[Comment]{}
    lineno = 1

    if test.stdin_input == NULL:
        f = fopen(test.path, "rb")
        if f == NULL:
            e = get_errno()
            message: byte[300]
            snprintf(message, sizeof(message), "reading expected output from '%s' failed", test.path)
            fail_with_errno(message, e)

        while fgets(big_buffer, sizeof(big_buffer), f) != NULL:
            big_buffer[strcspn(big_buffer, "\r\n")] = '\0'

            c = parse_comment_from_line(test, lineno++, big_buffer)
            if c.key != NULL:
                comments.append(c)

        fclose(f)

    else:
        p = test.stdin_input
        while *p != '\0':
            line_len = llmin(strcspn(p, "\r\n"), sizeof(big_buffer) - 1) as intnative
            memcpy(big_buffer, p, line_len)
            big_buffer[line_len] = '\0'

            c = parse_comment_from_line(test, lineno++, big_buffer)
            if c.key != NULL:
                comments.append(c)

            p = &p[line_len]
            if *p == '\r':
                p++
            if *p == '\n':
                p++

    return comments


# This must be done after merging configuration from different places but
# before we need to use the order for sorting. That's why it's here.
def check_config(config: TestConfig*) -> None:
    if config.output_comment_order.len == 0:
        ok = True
    elif config.output_comment_order.len == config.output_comment_rules.len:
        # Check that they contain the same strings in some order
        ok = True
        n = config.output_comment_order.len
        for i1 = 0; i1 < n; i1++:
            found = False
            for i2 = 0; i2 < n; i2++:
                if strcmp(config.output_comment_order.ptr[i1], config.output_comment_rules.ptr[i2][0]) == 0:
                    found = True
                    break
            if not found:
                ok = False
                break
    else:
        ok = False

    if not ok:
        fail_in_toml(
            config.value_linenos[TestConfigOption.OutputCommentOrder as int],
            "'output_comment_order' must contain the keys of 'output_comment_rules' in some order",
        )


def compare_comments(a: Comment*, b: Comment*) -> int:
    if a.sort_key == b.sort_key:
        # Preserve the original order when the sort keys are the same.
        #
        # Ideally this wouldn't be needed, but standard library qsort() is not
        # a stable sort algorithm :(
        if a < b:
            return -1
        if a > b:
            return 1
        return 0

    return a.sort_key - b.sort_key


def sort_comments(comments: List[Comment], config: TestConfig*) -> None:
    if config.output_comment_order.len == 0:
        return

    for comment_index = 0; comment_index < comments.len; comment_index++:
        c = &comments.ptr[comment_index]

        # Sort by index of the comment's key in the configured order
        c.sort_key = -1
        for i = 0; i < config.output_comment_order.len; i++:
            if strcmp(config.output_comment_order.ptr[i], c.key) == 0:
                c.sort_key = i
                break
        assert c.sort_key != -1

    Sorter[Comment]{}.sort(comments.ptr, comments.len, compare_comments)


def join_comments_to_string(comments: List[Comment]) -> byte*:
    result = List[byte]{}
    for c = comments.ptr; c < comments.end(); c++:
        result.extend_from_ptr(c.formatted_text, strlen(c.formatted_text))
        result.append('\n')

    result.append('\0')
    return result.ptr


@public
def step4_gather_expected_outputs(tests: List[Test]) -> None:
    for test = tests.ptr; test < tests.end(); test++:
        check_config(test.config)

        comments = parse_comments(test)
        sort_comments(comments, test.config)
        test.expected_output = join_comments_to_string(comments)

        while comments.len > 0:
            free(comments.pop().formatted_text)
        free(comments.ptr)
