import "stdlib/io.jou"
import "stdlib/json.jou"
import "stdlib/mem.jou"
import "stdlib/str.jou"

def main() -> int:
    decoded = json_to_string("\"left\\u0000right\"")
    printf("strlen=%zd bytes=%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
        strlen(decoded),
        decoded[0], decoded[1], decoded[2], decoded[3], decoded[4],
        decoded[5], decoded[6], decoded[7], decoded[8], decoded[9], decoded[10])
    free(decoded)
    return 0
