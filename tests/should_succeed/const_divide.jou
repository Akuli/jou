import "stdlib/io.jou"

const DOUBLE_INF: double = 1.0 / 0.0
const DOUBLE_INF_I: double = 1 / 0
# TOOD: no nice float syntax yet
#const FLOAT_INF: float = (1 as float) / (0 as float)
const FLOAT_INF_I: float = 1 / 0

def main() -> int:
    printf("%d %d\n", FLOAT_INF_I == DOUBLE_INF, DOUBLE_INF == DOUBLE_INF_I)  # Output: 1 1
    return 0
