import "stdlib/assert.jou"
import "stdlib/process.jou"
import "stdlib/str.jou"


def main() -> int:
    assert system("jou -g -O0 -o tmp/list-gdb-test examples/list.jou") == 0
    command: byte[1000]
    strcpy(command, "gdb -q -batch -ex 'set confirm off' -ex 'set pagination off' ")
    strcat(command, "-ex 'break main' -ex run -ex next -ex next ")

    # Output: line=14
    # Output: len=1
    strcat(command, "-ex 'info line' -ex 'printf \"len=%d\\n\", foo.len' ")

    # Output: line=15
    # Output: len=2
    strcat(command, "-ex next -ex 'info line' -ex 'printf \"len=%d\\n\", foo.len' ")

    # Output: line=21
    # Output: len=3
    strcat(command, "-ex next -ex 'info line' -ex 'printf \"len=%d\\n\", foo.len' ")
    strcat(command, "-ex quit --args ./tmp/list-gdb-test 2>&1 ")
    strcat(command, "| grep -E 'Line (14|15|21) of \"examples/list.jou\"|^len=' ")
    strcat(command, "| sed -E 's/Line ([0-9]+) of.*/line=\\1/'")
    assert system(command) == 0
    return 0
