import "stdlib/io.jou"

def same_parity(a: int, b: int) -> bool:
    return a % 2 == b % 2

def main() -> int:
    match 4 with same_parity:
        case 1:
            printf("no match\n")
        case 2:
            printf("same parity\n")  # Output: same parity
        case _:
            printf("no match\n")
    return 0
