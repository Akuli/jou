# The example programs in doc/argparse.md are also in examples/ folder.
# This test ensures that these two places stay in sync.

import "stdlib/assert.jou"
import "stdlib/ascii.jou"
import "stdlib/io.jou"
import "stdlib/str.jou"


def normalize_newline(line: byte*) -> None:
    len = strlen(line)
    if len >= 2 and line[len - 2] == '\r' and line[len - 1] == '\n':
        line[len - 2] = '\n'
        line[len - 1] = '\0'


def main() -> int:
    crlf_line: byte[10] = "line\r\n"
    normalize_newline(crlf_line)
    assert strcmp(crlf_line, "line\n") == 0

    doc = fopen("doc/argparse.md", "rb")
    assert doc != NULL

    doc_line: byte[4096]
    source_line: byte[4096]
    path: byte[256]
    example_count = 0

    while fgets(doc_line, sizeof(doc_line), doc) != NULL:
        normalize_newline(doc_line)
        if not starts_with(doc_line, "# This program comes with Jou: "):
            continue

        p = strstr(doc_line, ":")
        p++
        assert strlen(p) < sizeof(path)
        strcpy(path, p)
        trim_ascii_whitespace(path)
        if not starts_with(path, "examples/"):
            puts(path)
        assert starts_with(path, "examples/")

        source = fopen(path, "rb")
        if source == NULL:
            printf("failed to open %s\n", path)
        assert source != NULL
        assert fgets(source_line, sizeof(source_line), source) != NULL
        normalize_newline(source_line)
        if strcmp(source_line, "# See also: doc/argparse.md\n") != 0:
            printf("Unexpected first line in %s: %s\n", path, source_line)

        while True:
            assert fgets(doc_line, sizeof(doc_line), doc) != NULL
            normalize_newline(doc_line)
            if starts_with(doc_line, "```"):
                break

            assert fgets(source_line, sizeof(source_line), source) != NULL
            normalize_newline(source_line)
            if strcmp(doc_line, source_line) != 0:
                fprintf(get_stderr(), "%s differs:\nDocumentation: %sSource: %s", path, doc_line, source_line)
                assert False

        assert fgets(source_line, sizeof(source_line), source) == NULL
        fclose(source)
        example_count++

    fclose(doc)
    assert example_count == 3
    return 0
