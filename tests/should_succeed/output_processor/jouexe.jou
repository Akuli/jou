import "stdlib/io.jou"
import "stdlib/str.jou"

global line: byte[100_000]

def main() -> int:
    if WINDOWS:
        jouexe = "jou.exe"
    else:
        jouexe = "./jou"

    while fgets(line, sizeof(line), get_stdin()) != NULL:
        p = &line[0]
        while *p != '\0':
            if starts_with(p, jouexe) and (p[strlen(jouexe)] == ' ' or p[strlen(jouexe)] == ':'):
                printf("<jouexe>")
                p = &p[strlen(jouexe)]
            else:
                putchar(*p++)

    return 0
