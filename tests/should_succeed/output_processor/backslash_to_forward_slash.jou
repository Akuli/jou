import "stdlib/ascii.jou"
import "stdlib/io.jou"

def main() -> int:
    prev = '\0'
    while True:
        c = getchar()
        if c == EOF:
            return 0
        # A bit of a hack: tests/other_errors/assert_fail_complex.jou output
        # contains file path in backslashes but also \\ and \n in strings.
        putchar('/' if c == '\\' and is_ascii_letter(prev) else c)
        prev = c as byte
