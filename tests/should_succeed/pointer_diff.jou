import "stdlib/io.jou"

def main() -> int:
    nums = [10, 20, 30]
    p1 = &nums[0]
    p2 = &nums[2]
    printf("%d\n", pointer_diff(p2, p1))  # Output: 2
    printf("%d\n", pointer_diff(p1, p2))  # Output: -2
    printf("%d\n", pointer_diff(p1, p1))  # Output: 0
    printf("%d\n", pointer_diff(&nums[2], nums))  # Output: 2
    return 0
