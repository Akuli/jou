import "stdlib/assert.jou"
import "stdlib/random.jou"
import "stdlib/list.jou"
import "stdlib/ascii.jou"
import "stdlib/mem.jou"
import "stdlib/io.jou"
import "stdlib/str.jou"
import "stdlib/argv_iter.jou"


global ENABLE_PRINTS: bool = True


def simple_cli_program(args: byte*) -> None:
    args = strdup(args)
    args_list = split_by_ascii_whitespace(args)
    args_list.append(NULL)

    iter = ArgvIter{argv_ptr = args_list.ptr}
    while *iter.argv_ptr != NULL:
        match &iter with argv_iter_next:
            case "--help":
                if ENABLE_PRINTS:
                    printf("Usage: my_program [-v/--verbose] [-o FILE] [--debug-dump FILE] [input files]\n")
                break
            case "-v" | "--verbose":
                if ENABLE_PRINTS:
                    printf("Verbose\n")
            case "-o=":
                assert iter.value != NULL
                if ENABLE_PRINTS:
                    printf("Output file: '%s'\n", iter.value)
            case "-o":
                if ENABLE_PRINTS:
                    printf("Error: -o needs a value (try --help)\n")
                break
            case "--debug-dump=":
                assert iter.value != NULL
                if ENABLE_PRINTS:
                    printf("Debug dump to '%s'\n", iter.value)
            case "--debug-dump":
                printf("Error: --debug-dump needs a value (try --help)\n")
                break
            case _:
                arg = *iter.argv_ptr++
                assert arg != NULL
                if arg[0] == '-':
                    if ENABLE_PRINTS:
                        printf("Error: unknown argument %s (try --help)\n", arg)
                    break
                if ENABLE_PRINTS:
                    printf("Input file: '%s'\n", arg)

    if ENABLE_PRINTS:
        printf("---\n")

    free(args_list.ptr)
    free(args)


def main() -> int:
    # Output: Usage: my_program [-v/--verbose] [-o FILE] [--debug-dump FILE] [input files]
    # Output: ---
    simple_cli_program("--help")

    # Output: Output file: '-outfile'
    # Output: Debug dump to '--special-dump'
    # Output: ---
    simple_cli_program("-o=-outfile --debug-dump=--special-dump")

    # Output: Output file: ''
    # Output: Debug dump to ''
    # Output: ---
    simple_cli_program("-o= --debug-dump=")

    # Output: Error: -o needs a value (try --help)
    # Output: ---
    simple_cli_program("-o")

    # Output: Error: --debug-dump needs a value (try --help)
    # Output: ---
    simple_cli_program("--debug-dump")

    # Output: Error: unknown argument -x (try --help)
    # Output: ---
    simple_cli_program("-x")

    # Output: Error: unknown argument --unknown-flag (try --help)
    # Output: ---
    simple_cli_program("--unknown-flag")

    # Output: Error: unknown argument - (try --help)
    # Output: ---
    simple_cli_program("-")

    # Output: Input file: 'input1.txt'
    # Output: Verbose
    # Output: Output file: 'out.txt'
    # Output: Input file: 'input2.txt'
    # Output: Debug dump to 'log.txt'
    # Output: Input file: 'input3.txt'
    # Output: ---
    simple_cli_program("input1.txt -v -o=out.txt input2.txt --debug-dump=log.txt input3.txt")

    # Output: Input file: 'input.txt'
    # Output: Verbose
    # Output: Output file: 'out.txt'
    # Output: ---
    simple_cli_program("input.txt --verbose -o=out.txt")

    # Throw many random inputs at it
    ENABLE_PRINTS = False
    alphabet = "-= bdegmoprsuv"  # includes --verbose, -o, --debug-dump
    alphabet_len = strlen(alphabet)
    string: byte[10]
    n = 100000
    while n --> 0:
        len = rand() % sizeof(string)
        for i = 0; i < len; i++:
            string[i] = alphabet[rand() % alphabet_len]
        string[len] = '\0'
        simple_cli_program(string)

    printf("ok\n")  # Output: ok

    return 0
