# This file is used to calculate 128-bit hashes. They are used to check whether
# source files have changed so that we need to recompile.
#
# The hash algorithm we use is MurmurHash3_x64_128:
# https://github.com/aappleby/smhasher/blob/07bb4de10a63e8cc2e1724865454eba635742383/src/MurmurHash3.cpp#L255
#
# Of course, this is not cryptographically secure, but it doesn't matter for a
# compiler: if someone can place whatever they want into `jou_compiled`, you're
# doomed anyway :)

import "stdlib/intnative.jou"
import "stdlib/str.jou"


@inline
def rotl64(x: uint64, r: int8) -> uint64:
    return (x << r) | (x >> (64 - r))

@inline
def fmix64(k: uint64) -> uint64:
    k ^= k >> 33
    k *= 0xff51afd7ed558ccd
    k ^= k >> 33
    k *= 0xc4ceb9fe1a85ec53
    k ^= k >> 33
    return k

const c1: uint64 = 0x87c37b91114253d5
const c2: uint64 = 0x4cf5ad432745937f

@inline
def murmur_iteration(h1: uint64, h2: uint64, k1: uint64, k2: uint64) -> uint64[2]:
    k1 *= c1
    k1 = rotl64(k1, 31)
    k1 *= c2
    h1 ^= k1

    h1 = rotl64(h1, 27)
    h1 += h2
    h1 *= 5
    h1 += 0x52dce729

    k2 *= c2
    k2 = rotl64(k2, 33)
    k2 *= c1
    h2 ^= k2

    h2 = rotl64(h2, 31)
    h2 += h1
    h2 *= 5
    h2 += 0x38495ab5

    return [h1, h2]


# Use `Hasher{}` to initialize this with seed 0.
@public
class Hasher:
    state: uint64[2]
    union:
        buffer: byte[16]  # buffer[15] is the length, it's never full
        buffer64: uint64[2]
    total_len: intnative

    # Add data to hash
    @public
    def add_bytes(self, data: byte*, data_len: intnative) -> None:
        self.total_len += data_len
        i: intnative

        buffer_pos = self.buffer[15]
        if buffer_pos + data_len < 16:
            # Just buffer it, no full blocks
            for i = 0; i < data_len; i++:
                self.buffer[buffer_pos + i] = data[i]
            self.buffer[15] += data_len as byte
            return

        if buffer_pos > 0:
            # Process one full block that partially consists of buffered data
            n = 16 - buffer_pos
            for i = 0; i < n; i++:
                self.buffer[buffer_pos + i] = data[i]
            data = &data[n]
            data_len -= n
            self.state = murmur_iteration(self.state[0], self.state[1], self.buffer64[0], self.buffer64[1])

        state = self.state  # Tricks LLVM into generating different code with -O1, not sure if better
        nblocks = data_len >> 4
        for i = 0; i < nblocks; i++:
            # Load uint64's from the input data
            #
            # This will work on platforms that don't support unaligned access.
            # LLVM optimizes the mess.
            k1: uint64 = 0
            k2: uint64 = 0
            for k = 0; k < 8; k++:
                k1 |= (data[16*i + k] as uint64) << (8*k)
            for k = 0; k < 8; k++:
                k2 |= (data[16*i + 8 + k] as uint64) << (8*k)
            state = murmur_iteration(state[0], state[1], k1, k2)

        self.state = state

        tail_len = (data_len & 15) as byte
        for i = 0; i < tail_len; i++:
            self.buffer[i] = data[16*nblocks + i]
        self.buffer[15] = tail_len

    @public
    def add_byte(self, b: byte) -> None:
        self.add_bytes(&b, 1)

    @public
    def add_bool(self, b: bool) -> None:
        self.add_byte(b as byte)

    @public
    def add_int(self, i: int) -> None:
        self.add_bytes(&i as byte*, sizeof(i))

    @public
    def add_int64(self, i: int64) -> None:
        self.add_bytes(&i as byte*, sizeof(i))

    @public
    def add_uint64(self, i: uint64) -> None:
        self.add_bytes(&i as byte*, sizeof(i))

    @public
    def add_string(self, s: byte*) -> None:
        len = strlen(s)
        self.add_int64(len)
        self.add_bytes(s, len)

    @public
    def finish(self) -> uint64[2]:
        h1 = self.state[0]
        h2 = self.state[1]
        k1: uint64 = 0
        k2: uint64 = 0

        tail_len = self.buffer[15]
        # TODO: can this be cleaned up without affecting performance?
        if tail_len >= 15:
            k2 ^= (self.buffer[14] as uint64) << 48
        if tail_len >= 14:
            k2 ^= (self.buffer[13] as uint64) << 40
        if tail_len >= 13:
            k2 ^= (self.buffer[12] as uint64) << 32
        if tail_len >= 12:
            k2 ^= (self.buffer[11] as uint64) << 24
        if tail_len >= 11:
            k2 ^= (self.buffer[10] as uint64) << 16
        if tail_len >= 10:
            k2 ^= (self.buffer[ 9] as uint64) << 8
        if tail_len >=  9:
            k2 ^= (self.buffer[ 8] as uint64) << 0
            k2 *= c2
            k2 = rotl64(k2, 33)
            k2 *= c1
            h2 ^= k2
        if tail_len >=  8:
            k1 ^= (self.buffer[ 7] as uint64) << 56
        if tail_len >=  7:
            k1 ^= (self.buffer[ 6] as uint64) << 48
        if tail_len >=  6:
            k1 ^= (self.buffer[ 5] as uint64) << 40
        if tail_len >=  5:
            k1 ^= (self.buffer[ 4] as uint64) << 32
        if tail_len >=  4:
            k1 ^= (self.buffer[ 3] as uint64) << 24
        if tail_len >=  3:
            k1 ^= (self.buffer[ 2] as uint64) << 16
        if tail_len >=  2:
            k1 ^= (self.buffer[ 1] as uint64) << 8
        if tail_len >=  1:
            k1 ^= (self.buffer[ 0] as uint64) << 0
            k1 *= c1
            k1 = rotl64(k1, 31)
            k1 *= c2
            h1 ^= k1

        h1 ^= self.total_len
        h2 ^= self.total_len

        h1 += h2
        h2 += h1

        h1 = fmix64(h1)
        h2 = fmix64(h2)

        h1 += h2
        h2 += h1

        return [h1, h2]
