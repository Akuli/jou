    declare global environ: byte**
    declare posix_spawnp(
        pid: int*,
        file: byte*,
        file_actions: void*,
        attrp: void*,
        argv: byte**,
        envp: byte**,
    ) -> int
    declare waitpid(pid: int, status: int*, options: int) -> int
    const EINTR: int = 4


# TODO: move to stdlib?
if WINDOWS:
    declare SetEnvironmentVariableA(name: byte*, value: byte*) -> int
else:
    declare setenv(name: byte*, value: byte*, overwrite: int) -> int

def set_env_var(name: byte*, value: byte*) -> bool:
    if WINDOWS:
        return SetEnvironmentVariableA(name, value) != 0
    else:
        return setenv(name, value, 1) == 0


# Linker flags come from:
#   - files with 'link' statements
#   - command-line --linker-flags argument
def collect_linker_flags() -> byte*:
    maxlen: intnative = 0
    maxlen += strlen("-lm") + 1  # TODO: delete this
    if global_compiler_state.args.linker_flags != NULL:
        maxlen += strlen(global_compiler_state.args.linker_flags) + 1
    for jou_file = global_compiler_state.jou_files.ptr; jou_file < global_compiler_state.jou_files.end(); jou_file++:
        for stmt = jou_file.ast.ptr; stmt < jou_file.ast.end(); stmt++:
            if stmt.kind == AstStatementKind.Link:
                maxlen += strlen(stmt.link_statement.resolved_flags) + 1

    result: byte* = malloc(maxlen + 1)
    assert result != NULL
    strcpy(result, "")

    strcat(result, "-lm ")  # TODO: delete this
    if global_compiler_state.args.linker_flags != NULL:
        strcat(result, global_compiler_state.args.linker_flags)
        strcat(result, " ")
    for jou_file = global_compiler_state.jou_files.ptr; jou_file < global_compiler_state.jou_files.end(); jou_file++:
        for stmt = jou_file.ast.ptr; stmt < jou_file.ast.end(); stmt++:
            if stmt.kind == AstStatementKind.Link:
                strcat(result, stmt.link_statement.resolved_flags)
                strcat(result, " ")

    return result


if WINDOWS:
    def append_windows_argument(command_line: List[byte]*, argument: byte*) -> None:
        command_line.append('"')
        backslash_count = 0
        for p = argument; *p != '\0'; p++:
            if *p == '\\':
                backslash_count++
            elif *p == '"':
                for i = 0; i < backslash_count * 2 + 1; i++:
                    command_line.append('\\')
                command_line.append('"')
                backslash_count = 0
            else:
                for i = 0; i < backslash_count; i++:
                    command_line.append('\\')
                command_line.append(*p)
                backslash_count = 0
        for i = 0; i < backslash_count * 2; i++:
            command_line.append('\\')
        command_line.append('"')

    def run_process(command_line: byte*) -> int:
        wide_command_line = string_to_windows(command_line, NULL, 0)
        if wide_command_line == NULL:
            fprintf(get_stderr(), "error: process command line is not valid UTF-8\n")
            return 1

        startup_info = STARTUPINFOW{}
        startup_info.cb = sizeof(startup_info) as uint32
        process_info = PROCESS_INFORMATION{}
        ret = CreateProcessW(
            NULL,
            wide_command_line,
            NULL,
            NULL,
            False as int,
            0,
            NULL,
            NULL,
            &startup_info,
            &process_info,
        )
        free(wide_command_line)
        if ret == 0:
            fprintf(get_stderr(), "error: CreateProcessW() failed (Windows error %u)\n", GetLastError())
            return 1

        if WaitForSingleObject(process_info.hProcess, INFINITE) != 0:
            fprintf(get_stderr(), "error: WaitForSingleObject() failed (Windows error %u)\n", GetLastError())
            CloseHandle(process_info.hThread)
            CloseHandle(process_info.hProcess)
            return 1

        exit_code: uint32
        if GetExitCodeProcess(process_info.hProcess, &exit_code) == 0:
            fprintf(get_stderr(), "error: GetExitCodeProcess() failed (Windows error %u)\n", GetLastError())
            CloseHandle(process_info.hThread)
            CloseHandle(process_info.hProcess)
            return 1

        CloseHandle(process_info.hThread)
        CloseHandle(process_info.hProcess)
        return 0 if exit_code == 0 else 1
else:
    def run_process(args: List[byte*]*) -> int:
        assert args.len > 0
        args.append(NULL)

        child_pid: int
        ret = posix_spawnp(&child_pid, args.ptr[0], NULL, NULL, args.ptr, environ)
        if ret != 0:
            fprintf(get_stderr(), "error: posix_spawnp() failed: %s\n", strerror(ret))
            return 1

        status: int
        while True:
            if waitpid(child_pid, &status, 0) >= 0:
                break
            if get_errno() != EINTR:
                fprintf(get_stderr(), "error: waitpid() failed: %s\n", strerror(get_errno()))
                return 1

        return 0 if (status & 0x7f) == 0 and ((status >> 8) & 0xff) == 0 else 1


@public
def run_linker(exepath: byte*) -> None:
    linker_flags = collect_linker_flags()

    if WINDOWS:
        # Assume mingw with clang has been downloaded with windows_setup.sh.
        #
        # During the bootstrapping, the location of mingw is something
        # like ../../../mingw64 relative to jou.exe location, and it is passed
        # with an environment variable.
        mingw_dir = getenv("JOU_MINGW_DIR")
        if mingw_dir != NULL:
            # Environment variable given
            mingw_dir = strdup(mingw_dir)
        else:
            # Assume the folder that contains jou.exe also contains mingw64
            jou_exe = find_current_executable()
            if jou_exe == NULL:
                fprintf(get_stderr(), "error: cannot locate the currently running Jou compiler executable\n")
                exit(1)
            asprintf(&mingw_dir, "%s\\mingw64", dirname(jou_exe))
            free(jou_exe)

        # Could also use clang, but gcc has less dependencies so we can make the Windows zips smaller.
        linker_path: byte*
        asprintf(&linker_path, "%s\\bin\\gcc.exe", mingw_dir)
        free(mingw_dir)

        command_line = List[byte]{}
        append_windows_argument(&command_line, linker_path)
        for jou_file = global_compiler_state.jou_files.ptr; jou_file < global_compiler_state.jou_files.end(); jou_file++:
            assert jou_file.object_file_path != NULL
            command_line.append(' ')
            append_windows_argument(&command_line, jou_file.object_file_path)
        command_line.append(' ')
        append_windows_argument(&command_line, "-o")
        command_line.append(' ')
        append_windows_argument(&command_line, exepath)
        if *linker_flags != '\0':
            command_line.append(' ')
            command_line.extend_from_ptr(linker_flags, strlen(linker_flags))
        command_line.append('\0')
        free(linker_path)

        if global_compiler_state.args.verbosity >= 1:
            printf("Running linker: %s\n", command_line.ptr)

        ret = run_process(command_line.ptr)
        free(command_line.ptr)
    else:
        args = List[byte*]{}
        args.append(strdup(JOU_CLANG_PATH))
        for jou_file = global_compiler_state.jou_files.ptr; jou_file < global_compiler_state.jou_files.end(); jou_file++:
            assert jou_file.object_file_path != NULL
            args.append(strdup(jou_file.object_file_path))
        args.append(strdup("-o"))
        args.append(strdup(exepath))

        parsed_linker_flags = List[byte*]{}
        if not split_command_line_posix(linker_flags, &parsed_linker_flags):
            fprintf(get_stderr(), "error: linker flags contain invalid quoting\n")
            exit(1)
        args.extend(parsed_linker_flags)
        free(parsed_linker_flags.ptr)

        if global_compiler_state.args.verbosity >= 1:
            printf("Running linker:")
            for arg = args.ptr; arg < args.end(); arg++:
                printf(" [%s]", *arg)
            printf("\n")

        ret = run_process(&args)
        for arg = args.ptr; arg < args.end(); arg++:
            free(*arg)
        free(args.ptr)

    free(linker_flags)
    if ret != 0:
        exit(1)


@public
def run_exe(exepath: byte*) -> int:
    if global_compiler_state.args.verbosity >= 1:
        printf("Run: %s\n", exepath)

    if WINDOWS:
        command_line = List[byte]{}
        append_windows_argument(&command_line, exepath)
        for i = 0; i < command_line.len; i++:
            if command_line.ptr[i] == '/':
                command_line.ptr[i] = '\\'
        command_line.append('\0')
    else:
        args = List[byte*]{}
        if global_compiler_state.args.valgrind:
            args.append("valgrind")
            args.append("-q")
            args.append("--leak-check=full")
            args.append("--show-leak-kinds=all")
            args.append("--error-exitcode=1")
        args.append(exepath)

    # Jou programs can use JOU_COMPILER_PATH environment variable to detect
    # whether they are being ran from the Jou compiler or invoke the compiler
    # to e.g. do hot reloading.
    jou_compiler = find_current_executable()
    if jou_compiler == NULL:
        fprintf(get_stderr(), "error: cannot locate the currently running Jou compiler executable\n")
        exit(1)
    if not set_env_var("JOU_COMPILER_PATH", jou_compiler):
        fprintf(get_stderr(), "error: failed to set JOU_COMPILER_PATH environment variable\n")
        exit(1)
    free(jou_compiler)

    # Make sure that everything else shows up before the user's prints.
    fflush(get_stdout())
    fflush(get_stderr())

    if WINDOWS:
        ret = run_process(command_line.ptr)
        free(command_line.ptr)
    else:
        ret = run_process(&args)
        free(args.ptr)

    # Do not exit immediately, so that the compiler can clean up the memory it
    # uses. This makes error messages much shorter when running tests with
    # valgrind fails.
    return ret
