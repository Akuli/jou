import "stdlib/assert.jou"
import "stdlib/fs.jou"
import "stdlib/intnative.jou"
import "stdlib/str.jou"
import "stdlib/list.jou"
import "stdlib/mem.jou"
import "stdlib/io.jou"
import "stdlib/process.jou"

import "./ast.jou"
import "./state.jou"
import "./paths.jou"

if WINDOWS:
    import "stdlib/utf8.jou"
    import "stdlib/windows_api/kernel32.jou"
else:
    import "stdlib/errno.jou"
    import "../config.jou"


# TODO: move to stdlib?
if WINDOWS:
    declare SetEnvironmentVariableA(name: byte*, value: byte*) -> int
else:
    declare setenv(name: byte*, value: byte*, overwrite: int) -> int
    declare waitpid(pid: int, wstatus: int*, options: int) -> int
    declare posix_spawn(
        pid: int*,
        path: byte*,
        file_actions: void*,  # actually posix_spawn_file_actions_t*
        attrp: void*,         # actually posix_spawnattr_t*
        argv: byte**,
        envp: byte**,
    ) -> int
    declare posix_spawnp(
        pid: int*,
        path: byte*,
        file_actions: void*,  # actually posix_spawn_file_actions_t*
        attrp: void*,         # actually posix_spawnattr_t*
        argv: byte**,
        envp: byte**,
    ) -> int
    declare strsignal(signal: int) -> byte*

def set_env_var(name: byte*, value: byte*) -> bool:
    if WINDOWS:
        return SetEnvironmentVariableA(name, value) != 0
    else:
        return setenv(name, value, 1) == 0


def get_quoted_object_file_paths() -> byte*:
    result = List[byte]{}
    for jou_file = global_compiler_state.jou_files.ptr; jou_file < global_compiler_state.jou_files.end(); jou_file++:
        assert jou_file.object_file_path != NULL
        # TODO: quote better?
        result.append(' ')
        result.append('"')
        result.extend_from_ptr(jou_file.object_file_path, strlen(jou_file.object_file_path))
        result.append('"')
    result.append('\0')
    return result.ptr


# Linker flags come from:
#   - files with 'link' statements
#   - command-line --linker-flags argument
def collect_linker_flags() -> byte*:
    maxlen: intnative = 0
    maxlen += strlen("-lm") + 1  # TODO: delete this
    if global_compiler_state.args.linker_flags != NULL:
        maxlen += strlen(global_compiler_state.args.linker_flags) + 1
    for jou_file = global_compiler_state.jou_files.ptr; jou_file < global_compiler_state.jou_files.end(); jou_file++:
        for stmt = jou_file.ast.ptr; stmt < jou_file.ast.end(); stmt++:
            if stmt.kind == AstStatementKind.Link:
                maxlen += strlen(stmt.link_statement.resolved_flags) + 1

    result: byte* = malloc(maxlen + 1)
    assert result != NULL
    strcpy(result, "")

    strcat(result, "-lm ")  # TODO: delete this
    if global_compiler_state.args.linker_flags != NULL:
        strcat(result, global_compiler_state.args.linker_flags)
        strcat(result, " ")
    for jou_file = global_compiler_state.jou_files.ptr; jou_file < global_compiler_state.jou_files.end(); jou_file++:
        for stmt = jou_file.ast.ptr; stmt < jou_file.ast.end(); stmt++:
            if stmt.kind == AstStatementKind.Link:
                strcat(result, stmt.link_statement.resolved_flags)
                strcat(result, " ")

    return result


@public
def run_linker(exepath: byte*) -> None:
    linker_flags = collect_linker_flags()
    quoted_object_files = get_quoted_object_file_paths()

    command: byte*
    if WINDOWS:
        # Assume mingw with clang has been downloaded with windows_setup.sh.
        #
        # During the bootstrapping, the location of mingw is something
        # like ../../../mingw64 relative to jou.exe location, and it is passed
        # with an environment variable.
        mingw_dir = getenv("JOU_MINGW_DIR")
        if mingw_dir != NULL:
            # Environment variable given
            mingw_dir = strdup(mingw_dir)
        else:
            # Assume the folder that contains jou.exe also contains mingw64
            jou_exe = find_current_executable()
            if jou_exe == NULL:
                fprintf(get_stderr(), "error: cannot locate the currently running Jou compiler executable\n")
                exit(1)
            asprintf(&mingw_dir, "%s\\mingw64", dirname(jou_exe))
            free(jou_exe)

        # Could also use clang, but gcc has less dependencies so we can make the Windows zips smaller.
        # Windows quoting is weird. The outermost quotes get stripped here.
        asprintf(&command, "\"\"%s\\bin\\gcc.exe\" %s -o \"%s\" %s\"", mingw_dir, quoted_object_files, exepath, linker_flags)
        free(mingw_dir)
    else:
        # Assume clang is installed and use it to link. Could use ld, but clang is needed anyway.
        asprintf(&command, "'%s' %s -o '%s' %s", JOU_CLANG_PATH, quoted_object_files, exepath, linker_flags)

    free(linker_flags)
    free(quoted_object_files)

    if global_compiler_state.args.verbosity >= 1:
        printf("Running linker: %s\n", command)

    if system(command) != 0:
        exit(1)
    free(command)


if not WINDOWS:
    declare global environ: byte**

    # TODO(Jou): put these to stdlib, copy/pasta from joutest

    # Returns True if the process terminated with a signal
    @inline
    def WIFSIGNALED(s: int) -> bool:
        # 127 means "stopped", see WIFSTOPPED(). We should never get that value.
        return WTERMSIG(s) != 0 and WTERMSIG(s) != 127

    # Returns True if the process exited normally.
    @inline
    def WIFEXITED(s: int) -> bool:
        return WTERMSIG(s) == 0

    # If the process terminated by exiting normally, returns the exit code.
    @inline
    def WEXITSTATUS(s: int) -> int:
        return (s >> 8) & 0xff

    # If the process terminated with a signal, returns the signal number.
    @inline
    def WTERMSIG(s: int) -> int:
        return s & 0x7f


@public
def run_exe(exe: byte*) -> int:
    if global_compiler_state.args.verbosity >= 1:
        printf("Run: %s\n", exe)

    # Jou programs can use JOU_COMPILER_PATH environment variable to detect
    # whether they are being ran from the Jou compiler or invoke the compiler
    # to e.g. do hot reloading.
    jou_compiler = find_current_executable()
    if jou_compiler == NULL:
        fprintf(get_stderr(), "error: cannot locate the currently running Jou compiler executable\n")
        exit(1)
    if not set_env_var("JOU_COMPILER_PATH", jou_compiler):
        fprintf(get_stderr(), "error: failed to set JOU_COMPILER_PATH environment variable\n")
        exit(1)
    free(jou_compiler)

    # Make sure that everything else shows up before the user's prints.
    fflush(get_stdout())
    fflush(get_stderr())

    if WINDOWS:
        wide_exe = string_to_windows(exe, NULL, 0)
        assert wide_exe != NULL

        startup_info = STARTUPINFOW{}
        startup_info.cb = sizeof(startup_info) as uint32
        process_info = PROCESS_INFORMATION{}

        ret = CreateProcessW(
            wide_exe,
            NULL,
            NULL,
            NULL,
            False as int,
            0,
            NULL,
            NULL,
            &startup_info,
            &process_info,
        )
        if ret == 0:
            fprintf(get_stderr(), "error: running %s failed (Windows error %u)\n", exe, GetLastError())
            exit(1)

        free(wide_exe)

    else:
        child_pid: int

        if global_compiler_state.args.valgrind:
            valgrind_command = [
                "valgrind",
                "-q",
                "--leak-check=full",
                "--show-leak-kinds=all",
                "--error-exitcode=1",
                exe,
                NULL,
            ]
            # We use posix_spawnp() to find valgrind from PATH
            ret = posix_spawnp(&child_pid, valgrind_command[0], NULL, NULL, valgrind_command, environ)
            if ret != 0:
                fprintf(get_stderr(), "error: running valgrind failed: %s\n", strerror(ret))
                exit(1)
        else:
            exe_command = [exe, NULL]
            ret = posix_spawn(&child_pid, exe, NULL, NULL, exe_command, environ)
            if ret != 0:
                fprintf(get_stderr(), "error: running %s failed: %s\n", exe, strerror(ret))
                exit(1)

    # Now that the program has started running, we no longer need to hold the
    # lock directory that prevents other Jou compilers from writing to the same
    # executable. They will notice that the executable is running.
    #
    # We can't do this with valgrind, because valgrind doesn't lock the
    # executable like the OS does when running directly. And even if it did,
    # there would be a race condition when valgrind hasn't yet locked the file.
    if not global_compiler_state.args.valgrind:
        unlock_exe_path(exe)

    if WINDOWS:
        if WaitForSingleObject(process_info.hProcess, INFINITE) != 0:
            fprintf(get_stderr(), "error: WaitForSingleObject() failed (Windows error %u)\n", GetLastError())
            exit(1)

        exit_code: uint32 = 0
        if GetExitCodeProcess(process_info.hProcess, &exit_code) == 0:
            fprintf(get_stderr(), "error: GetExitCodeProcess() failed (Windows error %u)\n", GetLastError())
            exit(1)

        CloseHandle(process_info.hThread)
        CloseHandle(process_info.hProcess)
        return exit_code as int
    else:
        status: int
        if waitpid(child_pid, &status, 0) == -1:
            fprintf(get_stderr(), "error: waitpid() failed: %s\n", strerror(get_errno()))
            return 1

        # Do not exit immediately, so that the compiler can clean up the memory it
        # uses. This makes error messages much shorter when running tests with
        # valgrind fails.
        if not WIFEXITED(status):
            if WIFSIGNALED(status):
                fprintf(get_stderr(), "%s\n", strsignal(WTERMSIG(status)))
            # TODO: other return code for killing with signal?
            return 1
        return WEXITSTATUS(status)
