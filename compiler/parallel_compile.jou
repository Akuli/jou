# This file invokes LLVM on many files at once using threads.
#
# There are several reasons to parallelize only LLVM stuff:
#
#   1.  Compilation steps before LLVM often handle multiple different files.
#       For example, during type checking, one file might need to access
#       something defined in another file, or inline a function defined in
#       another file. I don't want to set up mutexes and such to protect all
#       that from race conditions.
#
#   2.  LLVM is by far the slowest part of the Jou compiler.
#
#   3.  It is harder to make LLVM faster than other parts of the compiler,
#       because I did not create LLVM.

import "stdlib/assert.jou"
import "stdlib/errno.jou"
import "stdlib/intnative.jou"
import "stdlib/io.jou"
import "stdlib/list.jou"
import "stdlib/mem.jou"
import "stdlib/process.jou"
import "stdlib/str.jou"
import "stdlib/time.jou"
import "stdlib/fs.jou"

import "./llvm.jou"
import "./pthreads.jou"
import "./state.jou"
import "./paths.jou"

if WINDOWS:
    import "stdlib/windows_api/kernel32.jou"


if not WINDOWS:
    # TODO(Jou): invalid syntax!!! link is a keyword!
    #declare link(source: byte*, dest: byte*) -> int

    # workaround...
    declare linkat(olddirfd: int, oldpath: byte*, newdirfd: int, newpath: byte*, flags: int) -> int
    if LINUX or NETBSD:
        const AT_FDCWD: int = -100
    elif MACOS:
        const AT_FDCWD: int = -2
    else:
        assert False
    def link_(oldpath: byte*, newpath: byte*) -> int:
        return linkat(AT_FDCWD, oldpath, AT_FDCWD, newpath, 0)

    # Number of CPUs determining stuff
    declare sysconf(n: int) -> intnative
    if MACOS:
        const _SC_NPROCESSORS_ONLN: int = 58
    elif NETBSD:
        const _SC_NPROCESSORS_ONLN: int = 1002
    else:
        # linux
        const _SC_NPROCESSORS_ONLN: int = 84


def get_number_of_cpus() -> int:
    if WINDOWS:
        result = GetActiveProcessorCount(ALL_PROCESSOR_GROUPS) as int
    else:
        result = sysconf(_SC_NPROCESSORS_ONLN) as int

    if global_compiler_state.args.verbosity >= 2:
        printf("%d CPU cores\n", result)
    return result


def choose_num_threads(num_files_to_compile: int) -> int:
    if LLVMIsMultithreaded() == 0:
        if global_compiler_state.args.verbosity >= 1:
            printf("LLVMIsMultithreaded() returns 0. Not using threads.\n")
        return 0

    num_threads = global_compiler_state.args.parallelism
    if num_threads == 0:
        # Argument not given on command line
        num_threads = get_number_of_cpus()

    if num_threads > num_files_to_compile:
        num_threads = num_files_to_compile

    if num_threads < 2:
        return 0

    return num_threads


def print_llvm_ir(module: LLVMModule*, is_optimized: bool) -> None:
    if is_optimized:
        opt_or_unopt = "Optimized"
    else:
        opt_or_unopt = "Unoptimized"

    llvm_ir_string = LLVMPrintModuleToString(module)

    len = 0 as int64
    filename = LLVMGetSourceFileName(module, &len)  # returns a reference, not copy

    printf("===== %s LLVM IR for file \"%.*s\" =====\n%s\n", opt_or_unopt, len as int, filename, llvm_ir_string)
    LLVMDisposeMessage(llvm_ir_string)


def optimize(state: ThreadLocalCompilerState*, module: LLVMModule*, level: int) -> None:
    if global_compiler_state.args.verbosity >= 2:
        len = 0 as int64
        filename = LLVMGetSourceFileName(module, &len)
        printf("[thread %zx] Optimizing %s (level %d)\n", pthread_self(), filename, level)

    assert 1 <= level and level <= 3
    passes: byte[100]
    sprintf(passes, "default<O%d>", level)

    options = LLVMCreatePassBuilderOptions()
    error = LLVMRunPasses(module, passes, state.target.machine, options)
    LLVMDisposePassBuilderOptions(options)
    assert error == NULL  # I've never seen this fail

    if global_compiler_state.args.verbosity >= 2:
        print_llvm_ir(module, True)


def write_llvm_ir_to_file(state: ThreadLocalCompilerState*, mod: LLVMModule*, o_path: byte*) -> None:
    if global_compiler_state.args.verbosity >= 1:
        printf("[thread %zx] Writing LLVM IR to %s\n", pthread_self(), o_path)

    # If we want to create foo.o, first write to foo_temp_12345.o, where 12345
    # is the PID. This way:
    #   - We don't end up with a corrupted foo.o if the compiler is interrupted
    #     or the compiler crashes.
    #   - If two compiler processes create the same .o file, the first attempt
    #     to create it will succeed, and other compiler processes will use the
    #     same file.
    #
    # See also https://github.com/Akuli/jou/issues/873
    assert ends_with(o_path, ".o")
    o_path_2: byte*
    asprintf(&o_path_2, "%.*s_temp_%d.o", (strlen(o_path) - 2) as int, o_path, getpid())

    error: byte* = NULL
    if LLVMTargetMachineEmitToFile(
        state.target.machine,
        mod,
        o_path_2,
        LLVMCodeGenFileType.ObjectFile,
        &error,
    ) != 0:
        assert error != NULL
        fprintf(get_stderr(), "failed to emit object file \"%s\": %s\n", o_path, error)
        exit(1)

    # If this fails, it means another Jou compiler process already created the
    # file. That's fine.
    if WINDOWS:
        move_error: uint32 = 0
        if MoveFileExA(o_path_2, o_path, 0) == 0:
            move_error = GetLastError()
    else:
        move_error: int = 0
        if link_(o_path_2, o_path) == -1:
            move_error = get_errno()

    unlink(o_path_2)

    if move_error != 0 and not file_exists(o_path):
        if WINDOWS:
            # Hopefully nobody ever sees this error message... at least it's
            # somewhat debuggable because it mentions the error number.
            #
            # TODO: call FormatMessage()? it is messy though.
            fprintf(get_stderr(), "renaming object file \"%s\" --> \"%s\" failed (Windows error %u)\n", o_path_2, o_path, move_error)
        else:
            fprintf(get_stderr(), "renaming object file \"%s\" --> \"%s\" failed: %s\n", o_path_2, o_path, strerror(move_error))
        exit(1)

    free(o_path_2)


def compile_to_object_file(state: ThreadLocalCompilerState*, jou_file: JouFile*) -> None:
    if jou_file.llvm_ir == NULL:
        # This file was found from cache, it does not need compiling to file.
        return

    if global_compiler_state.args.verbosity >= 1:
        printf("[thread %zx] Compiling %s\n", pthread_self(), jou_file.path)

    start = monotonic_ns()
    mod: LLVMModule* = NULL
    LLVMParseBitcodeInContext2(state.llvm_context, jou_file.llvm_ir, &mod)
    assert mod != NULL
    end = monotonic_ns()
    if global_compiler_state.args.verbosity >= 1:
        printf("Deserialize: %.3fms for %s\n", (end-start) * 1e-6, jou_file.path)

    if global_compiler_state.args.verbosity >= 2:
        print_llvm_ir(mod, False)

    # If this fails, it is not just users writing dumb code, it is a bug in this compiler.
    # This compiler should always fail with an error elsewhere, or generate valid LLVM IR.
    start = monotonic_ns()
    LLVMVerifyModule(mod, LLVMVerifierFailureAction.AbortProcess, NULL)
    end = monotonic_ns()
    if global_compiler_state.args.verbosity >= 1:
        printf("Verify: %.3fms for %s\n", (end-start) * 1e-6, jou_file.path)

    if global_compiler_state.args.optlevel != 0:
        start = monotonic_ns()
        optimize(state, mod, global_compiler_state.args.optlevel)
        end = monotonic_ns()
        if global_compiler_state.args.verbosity >= 1:
            printf("Optimize: %.3fms for %s\n", (end-start) * 1e-6, jou_file.path)

    start = monotonic_ns()
    write_llvm_ir_to_file(state, mod, jou_file.object_file_path)
    end = monotonic_ns()
    if global_compiler_state.args.verbosity >= 1:
        printf("Write: %.3fms for %s\n", (end-start) * 1e-6, jou_file.path)

    start = monotonic_ns()
    LLVMDisposeModule(mod)
    end = monotonic_ns()
    if global_compiler_state.args.verbosity >= 1:
        printf("Dispose Module: %.3fms for %s\n", (end-start) * 1e-6, jou_file.path)


class FileQueue:
    jou_files_ptr: JouFile*
    jou_files_end: JouFile*
    mutex: pthread_mutex_t

    # If multiple threads call this, each will get a different file.
    def get_next_file(self) -> JouFile*:
        ret = pthread_mutex_lock(&self.mutex)
        if ret != 0:
            fprintf(get_stderr(), "[thread %zx] pthread_mutex_lock failed: %d\n", pthread_self(), ret)
            exit(1)

        if self.jou_files_ptr < self.jou_files_end:
            jou_file = self.jou_files_ptr++
        else:
            jou_file = NULL

        ret = pthread_mutex_unlock(&self.mutex)
        if ret != 0:
            fprintf(get_stderr(), "[thread %zx] pthread_mutex_unlock failed: %d\n", pthread_self(), ret)
            exit(1)

        return jou_file


class ThreadInputs:
    queue: FileQueue*
    state: ThreadLocalCompilerState


# This is the function that runs in another thread
def pthreads_callback(inputs_ptr: void*) -> void*:
    inputs: ThreadInputs* = inputs_ptr

    if global_compiler_state.args.verbosity >= 2:
        printf("[thread %zx] Started...\n", pthread_self())

    while True:
        jou_file = inputs.queue.get_next_file()
        if jou_file == NULL:
            break
        compile_to_object_file(&inputs.state, jou_file)

    if global_compiler_state.args.verbosity >= 2:
        printf("[thread %zx] Done\n", pthread_self())

    return NULL


@public
def optimize_llvm_ir_and_write_object_files_in_parallel() -> None:
    n = 0
    for jou_file = global_compiler_state.jou_files.ptr; jou_file < global_compiler_state.jou_files.end(); jou_file++:
        if jou_file.llvm_ir != NULL:
            n++

    num_threads = choose_num_threads(n)
    assert num_threads != 1  # making just one thread would be pointless

    if global_compiler_state.args.verbosity >= 1:
        printf("Making %d object files using LLVM and %d threads...\n", n, num_threads)

    if num_threads == 0:
        state = create_thread_local_compiler_state()
        for jou_file = global_compiler_state.jou_files.ptr; jou_file < global_compiler_state.jou_files.end(); jou_file++:
            compile_to_object_file(&state, jou_file)
        state.free()
        return

    queue = FileQueue{jou_files_ptr = global_compiler_state.jou_files.ptr, jou_files_end = global_compiler_state.jou_files.end()}
    ret = pthread_mutex_init(&queue.mutex, NULL)
    if ret != 0:
        fprintf(get_stderr(), "pthread_mutex_init failed: %s\n", strerror(ret))
        exit(1)

    threads: intnative* = malloc(sizeof(threads[0]) * num_threads)
    assert threads != NULL
    inputs: ThreadInputs* = malloc(sizeof(inputs[0]) * num_threads)
    assert inputs != NULL

    for i = 0; i < num_threads; i++:
        inputs[i] = ThreadInputs{queue = &queue, state = create_thread_local_compiler_state()}
        ret = pthread_create(&threads[i], NULL, pthreads_callback, &inputs[i])
        if ret != 0:
            fprintf(get_stderr(), "pthread_create failed: %s\n", strerror(ret))
            exit(1)

    for i = 0; i < num_threads; i++:
        ret = pthread_join(threads[i], NULL)
        if ret != 0:
            fprintf(get_stderr(), "pthread_join failed: %d\n", ret)
            exit(1)
        inputs[i].state.free()

    pthread_mutex_destroy(&queue.mutex)
    free(threads)
    free(inputs)
